<!DOCTYPE html>
<html lang="az">
<head>
    <meta charset="UTF-8">
    <title>Giriş - Müştəri axtarış sistemi</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <style>
        :root {
            --blue-main: #2563eb;
            --blue-dark: #1d4ed8;
            --blue-soft: #3b82f6;
            --card-bg: rgba(255,255,255,0.92);
            --input-border: #dbe3ee;
            --text: #0f172a;
            --muted: #64748b;
        }

        *{
            box-sizing:border-box;
        }

        body {
            font-family: 'Segoe UI', sans-serif;
            margin: 0;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            position: relative;
            overflow: hidden;
            padding: 20px;
        }

        /* Arxa fon şəkli + blur */
        body::before{
            content:"";
            position: fixed;
            inset: 0;
            background-image: url("https://raw.githubusercontent.com/AsadAsadov/Selnet/main/home.jpg");
            background-size: cover;
            background-position: center;
            background-repeat: no-repeat;
            filter: blur(4px);
            transform: scale(1.06);
            z-index: -2;
        }

        /* Tünd overlay */
        body::after{
            content:"";
            position: fixed;
            inset: 0;
            background: rgba(15,23,42,0.45);
            z-index: -1;
        }

        .page-wrapper{
            width: 100%;
            display: flex;
            flex-direction: column;
            align-items: center;
        }

        .login-card {
            width: 100%;
            max-width: 390px;
            border-radius: 26px;
            overflow: hidden;
            background: var(--card-bg);
            backdrop-filter: blur(14px);
            -webkit-backdrop-filter: blur(14px);
            box-shadow:
                0 20px 60px rgba(0,0,0,0.35),
                0 0 0 1px rgba(255,255,255,0.08);
            animation: fadeIn 0.45s ease;
        }

        @keyframes fadeIn{
            from{
                opacity:0;
                transform:translateY(20px);
            }
            to{
                opacity:1;
                transform:translateY(0);
            }
        }

        /* Yuxarı mavi hissə */
        .card-header {
            background: linear-gradient(135deg, #2563eb 0%, #3b82f6 100%);
            padding: 42px 20px 36px;
            text-align: center;
            position: relative;
        }

        .logo-container{
            display:flex;
            align-items:center;
            justify-content:center;
        }

        .logo-container img {
            width: 190px;
            max-width: 100%;
            height: auto;
            filter: brightness(0) invert(1);
        }

        .card-body {
            padding: 32px;
        }

        .form-group {
            margin-bottom: 18px;
            position: relative;
        }

        .input-icon {
            position: absolute;
            left: 15px;
            top: 50%;
            transform: translateY(-50%);
            color: #94a3b8;
            width: 18px;
            pointer-events: none;
        }

        .form-control {
            width: 100%;
            padding: 14px 15px 14px 48px;
            border: 1px solid var(--input-border);
            border-radius: 14px;
            font-size: 15px;
            background: rgba(241,245,249,0.92);
            color: var(--text);
            transition: 0.25s ease;
        }

        .form-control::placeholder{
            color:#94a3b8;
        }

        .form-control:focus {
            outline: none;
            border-color: var(--blue-soft);
            background: #fff;
            box-shadow: 0 0 0 4px rgba(59,130,246,0.14);
        }

        /* Mavi button */
        .btn-login {
            width: 100%;
            padding: 15px;
            background: linear-gradient(135deg, #2563eb 0%, #3b82f6 100%);
            border: none;
            border-radius: 14px;
            color: white;
            font-size: 16px;
            font-weight: 700;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            margin-top: 8px;
            transition: 0.25s ease;
            box-shadow: 0 12px 24px rgba(37,99,235,0.28);
        }

        .btn-login:hover {
            transform: translateY(-1px);
            background: linear-gradient(135deg, #1d4ed8 0%, #2563eb 100%);
            box-shadow: 0 16px 30px rgba(37,99,235,0.35);
        }

        .btn-login:active{
            transform: scale(0.99);
        }

        .error-msg {
            background: rgba(254,242,242,0.95);
            color: #dc2626;
            padding: 12px;
            border-radius: 12px;
            font-size: 13px;
            text-align: center;
            margin-bottom: 16px;
            border: 1px solid rgba(248,113,113,0.35);
            font-weight: 600;
        }

        .footer-text {
            text-align: center;
            padding: 20px;
            font-size: 12px;
            color: var(--muted);
            background: rgba(248,250,252,0.7);
            border-top: 1px solid rgba(226,232,240,0.7);
            font-weight: 600;
            letter-spacing: 0.5px;
        }

        .copyright {
            margin-top: 18px;
            text-align: center;
            font-size: 12px;
            color: rgba(255,255,255,0.82);
            text-shadow: 0 2px 10px rgba(0,0,0,0.4);
        }

        .copyright a {
            color: #93c5fd;
            text-decoration: none;
            font-weight: 600;
        }

        @media (max-width: 480px){

            body{
                padding:16px;
            }

            .login-card{
                border-radius:22px;
            }

            .card-header{
                padding:34px 18px 30px;
            }

            .logo-container img{
                width:160px;
            }

            .card-body{
                padding:24px 20px;
            }

            .form-control{
                font-size:14px;
                padding:13px 14px 13px 46px;
            }

            .btn-login{
                padding:14px;
                font-size:15px;
            }
        }
    </style>
</head>

<body>

<div class="page-wrapper">

    <div class="login-card">

        <div class="card-header">
            <div class="logo-container">
                <img
                    src="https://raw.githubusercontent.com/AsadAsadov/Selnet/main/selnet.png"
                    alt="Selnet Logo"
                >
            </div>
        </div>

        <div class="card-body">

            <% if (typeof error !== 'undefined' && error) { %>
                <div class="error-msg">
                    <%= error %>
                </div>
            <% } %>

            <form method="POST">

                <div class="form-group">
                    <svg class="input-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z">
                        </path>
                    </svg>

                    <input
                        class="form-control"
                        placeholder="İstifadəçi adı"
                        type="text"
                        name="username"
                        required
                    >
                </div>

                <div class="form-group">
                    <svg class="input-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 00-2 2zm10-10V7a4 4 0 00-8 0v4h8z">
                        </path>
                    </svg>

                    <input
                        class="form-control"
                        placeholder="Şifrə"
                        type="password"
                        name="password"
                        required
                    >
                </div>

                <button class="btn-login" type="submit">

                    <svg style="width:18px" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1">
                        </path>
                    </svg>

                    Sign In
                </button>

            </form>

        </div>

        <div class="footer-text">
            SELNET MMC
        </div>

    </div>

    <div class="copyright">
        © 2026
        <a href="#">Müştəri axtarış sistemi</a>.
        Bütün hüquqlar qorunur.
    </div>

</div>

</body>
</html>
