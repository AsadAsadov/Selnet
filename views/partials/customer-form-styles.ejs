<style>
    :root{--bg:#0f172a;--card:#1e293b;--card-soft:#263449;--border:#334155;--border-strong:#475569;--green:#10b981;--blue:#3b82f6;--text:#e2e8f0;--muted:#94a3b8;--red:#ef4444;--ring:rgba(16,185,129,.22)}
    *{box-sizing:border-box}
    body{font-family:system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;margin:0;background:radial-gradient(circle at top,#172554 0,#0f172a 42%,#0b1120 100%);color:var(--text);min-height:100vh}
    .header{background:linear-gradient(90deg,#059669,#10b981);padding:14px 30px;display:flex;justify-content:space-between;align-items:center;box-shadow:0 12px 30px rgba(2,6,23,.22)}
    .header h1{margin:0;font-size:20px;letter-spacing:-.01em}.header a{color:#fff;text-decoration:none;font-weight:650;font-size:14px}
    .container{padding:22px;max-width:860px;margin:auto}
    .btn-back{display:inline-flex;align-items:center;gap:8px;padding:10px 18px;background:rgba(51,65,85,.78);border:1px solid rgba(148,163,184,.16);border-radius:12px;color:var(--text);text-decoration:none;margin-bottom:16px;font-weight:650}
    .form-card{background:linear-gradient(180deg,rgba(30,41,59,.98),rgba(15,23,42,.98));border:1px solid rgba(148,163,184,.20);border-radius:20px;padding:26px;box-shadow:0 24px 70px rgba(2,6,23,.34)}
    .form-card h2{margin:0 0 20px 0;font-size:24px;letter-spacing:-.02em}
    .customer-form{display:block}
    .form-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px 16px;align-items:start}
    .form-group{min-width:0}.form-group.full-width{grid-column:1/-1}
    .form-group label{display:flex;align-items:center;gap:4px;margin-bottom:6px;font-size:12px;line-height:1.2;color:var(--muted);font-weight:750;letter-spacing:.02em;text-transform:uppercase}
    .form-group input,.form-group textarea{width:100%;min-height:46px;padding:11px 13px;background:rgba(15,23,42,.86);border:1px solid var(--border);border-radius:12px;color:var(--text);font-size:16px;line-height:1.35;outline:none;transition:border-color .16s ease,box-shadow .16s ease,background .16s ease,transform .16s ease}
    .form-group textarea{min-height:76px;resize:vertical}.form-group textarea.drive-links{min-height:88px}
    .form-group input::placeholder,.form-group textarea::placeholder{color:#64748b}
    .form-group input:focus,.form-group textarea:focus{border-color:var(--green);background:#101b2f;box-shadow:0 0 0 4px var(--ring),0 12px 30px rgba(16,185,129,.10)}
    .form-group input[readonly]{opacity:.72;background:rgba(15,23,42,.55);cursor:not-allowed}
    .field-hint{display:block;margin-top:6px;color:#7c8da5;font-size:12px;line-height:1.35}
    .btn-submit{width:100%;min-height:48px;padding:13px 16px;background:linear-gradient(135deg,var(--submit-color,var(--green)),var(--submit-color-dark,#059669));border:none;border-radius:13px;color:#fff;font-weight:800;font-size:16px;cursor:pointer;margin-top:16px;box-shadow:0 14px 32px rgba(16,185,129,.22)}
    .btn-submit:hover{filter:brightness(1.04);transform:translateY(-1px)}
    .alert{padding:13px 14px;border-radius:12px;margin-bottom:16px;font-weight:650}.alert.success{background:rgba(16,185,129,.16);border:1px solid rgba(16,185,129,.7);color:#6ee7b7}.alert.error{background:rgba(239,68,68,.14);border:1px solid rgba(239,68,68,.72);color:#fca5a5}.required{color:#f87171}
    .current-links{margin-top:8px;display:grid;gap:7px}.current-links a{color:#93c5fd;text-decoration:none;font-size:13px;word-break:break-all}.current-links a:hover{text-decoration:underline}
    @media (max-width:768px){
        .header{padding:12px 16px}.header h1{font-size:17px}.header a{font-size:13px}.container{padding:14px;max-width:100%}.form-card{border-radius:18px;padding:16px}.form-card h2{font-size:20px;margin-bottom:14px}.btn-back{padding:9px 14px;margin-bottom:12px}.form-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}.form-group label{font-size:11px;margin-bottom:5px}.form-group input,.form-group textarea{min-height:42px;padding:9px 10px;border-radius:11px;font-size:16px}.form-group textarea{min-height:66px}.form-group textarea.drive-links{min-height:76px}.field-hint{font-size:11px;margin-top:5px}.btn-submit{min-height:46px;margin-top:12px}
    }
    @media (max-width:380px){.form-grid{grid-template-columns:1fr}.form-card{padding:14px}.container{padding:10px}.header{align-items:flex-start;gap:8px;flex-direction:column}.form-group.full-width{grid-column:auto}}
</style>
