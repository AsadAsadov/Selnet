<!DOCTYPE html>
<html>
<head>
    <title>Müştəri Redaktə</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
    <%- include('partials/customer-form-styles') %>
    <style>.btn-submit{--submit-color:var(--blue);--submit-color-dark:#2563eb;box-shadow:0 14px 32px rgba(59,130,246,.22)}</style>
</head>
<body>
<div class="header">
    <div class="logo"><h1><i class="fa-solid fa-pen-to-square"></i> Müştəri Redaktə</h1></div>
    <a href="/"><i class="fa-solid fa-home"></i> Ana Səhifə</a>
</div>
<div class="container">
    <a href="/" class="btn-back"><i class="fa-solid fa-arrow-left"></i> Geri</a>

    <div class="form-card">
        <h2><i class="fa-solid fa-pen"></i> <%= customer['Ad, Soyad, Ata adı'] %></h2>

        <% if (success) { %>
            <div class="alert success"><i class="fa-solid fa-check-circle"></i> <%= success %></div>
        <% } %>
        <% if (error) { %>
            <div class="alert error"><i class="fa-solid fa-exclamation-circle"></i> <%= error %></div>
        <% } %>

        <form method="POST" class="customer-form">
            <input type="hidden" name="rowIndex" value="<%= customer.rowIndex %>">

            <div class="form-grid">
                <div class="form-group">
                    <label>Ödəniş kodu <span class="required">*</span></label>
                    <input type="text" name="odemeKodu" value="<%= customer['Ödəniş kodu'] %>" required readonly>
                </div>
                <div class="form-group">
                    <label>Aylıq ödəniş <span class="required">*</span></label>
                    <input type="number" name="ayliqOdenis" step="0.01" inputmode="decimal" value="<%= customer['Aylıq ödəniş'] || customer.ayliqOdenis || '' %>" required>
                </div>

                <div class="form-group">
                    <label>Ad Soyad Ata adı <span class="required">*</span></label>
                    <input type="text" name="adSoyad" value="<%= customer['Ad, Soyad, Ata adı'] %>" autocomplete="name" required>
                </div>
                <div class="form-group">
                    <label>Telefon nömrəsi <span class="required">*</span></label>
                    <input type="tel" name="telefon" value="<%= customer['Telefon nömrəsi'] %>" autocomplete="tel" inputmode="tel" required>
                </div>

                <div class="form-group">
                    <label>Ş/V FİN</label>
                    <input type="text" name="fin" value="<%= customer['Ş/V FİN'] %>" autocomplete="off">
                </div>
                <div class="form-group">
                    <label>Ş/V Seriya</label>
                    <input type="text" name="seriya" value="<%= customer['Ş/V Seriya'] %>" autocomplete="off">
                </div>

                <div class="form-group">
                    <label>Modem S/N</label>
                    <input type="text" name="modem" value="<%= customer['Modem S/N'] %>" autocomplete="off">
                </div>
                <div class="form-group">
                    <label>TV Box</label>
                    <input type="text" name="tvbox" value="<%= customer['Tv Box'] %>" autocomplete="off">
                </div>

                <div class="form-group">
                    <label>Ünvan <span class="required">*</span></label>
                    <input type="text" name="unvan" value="<%= customer['Ünvan'] %>" autocomplete="street-address" required>
                </div>
                <div class="form-group">
                    <label>Komendant</label>
                    <input type="text" name="komendant" value="<%= customer['Komendant'] %>" autocomplete="off">
                </div>

                <div class="form-group full-width">
                    <label>Qeyd</label>
                    <textarea name="qeyd"><%= customer['Qeyd'] %></textarea>
                </div>

                <div class="form-group full-width">
                    <label>Müqavilə və Modemin şəkli (Drive linkləri)</label>
                    <textarea class="drive-links" name="driveLinks" placeholder="https://drive.google.com/..."><%= (customer['Müqavilə və Modemin şəkli'] || '').split(',').map(link => link.trim()).filter(Boolean).join('\n') %></textarea>
                    <span class="field-hint">Birdən çox link üçün vergül istifadə et və ya hər sətirdə 1 link yaz.</span>
                    <% const existingLinks = (customer['Müqavilə və Modemin şəkli'] || '').split(',').map(link => link.trim()).filter(Boolean); %>
                    <% if (existingLinks.length) { %>
                        <div class="current-links">
                            <% existingLinks.forEach((link, i) => { %>
                                <a href="<%= link %>" target="_blank" rel="noopener"><i class="fa-solid fa-link"></i> Drive link <%= i + 1 %></a>
                            <% }) %>
                        </div>
                    <% } %>
                </div>
            </div>

            <button type="submit" class="btn-submit">
                <i class="fa-solid fa-floppy-disk"></i> Yenilə
            </button>
        </form>
    </div>
</div>
</body>
</html>
