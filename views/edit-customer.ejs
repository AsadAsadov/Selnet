<!DOCTYPE html>
<html>
<head>
    <title>Müştəri Redaktə</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
    <%- include('partials/customer-form-styles') %>
    <style>
        .form-card {
            background: rgba(15, 23, 42, 0.68);
            border: 1px solid rgba(255, 255, 255, 0.12);
            backdrop-filter: blur(6px);
            -webkit-backdrop-filter: blur(6px);
            box-shadow: 0 24px 60px rgba(0, 0, 0, 0.18);
            border-radius: 24px;
            overflow: hidden;
        }
        .form-card h2 {
            color: #f8fafc;
        }
        .btn-submit {
            --submit-color: var(--blue);
            --submit-color-dark: #2563eb;
            box-shadow: 0 14px 32px rgba(59, 130, 246, .22);
        }
    </style>
</head>
<body>
<div class="header">
    <div class="logo"><h1><i class="fa-solid fa-pen-to-square"></i> Müştəri Redaktə</h1></div>
    <a href="/"><i class="fa-solid fa-home"></i> Ana Səhifə</a>
</div>
<div class="container">
    <a href="/" class="btn-back"><i class="fa-solid fa-arrow-left"></i> Geri</a>

    <div class="form-card">
        <h2><i class="fa-solid fa-pen"></i> <%= customer.ad_soyad %></h2>

        <% if (success) { %>
            <div class="alert success"><i class="fa-solid fa-check-circle"></i> <%= success %></div>
        <% } %>
        <% if (error) { %>
            <div class="alert error"><i class="fa-solid fa-exclamation-circle"></i> <%= error %></div>
        <% } %>

        <form method="POST" class="customer-form">
            <input type="hidden" name="customerId" value="<%= customer.id %>">

            <div class="form-grid">
                <div class="form-group">
                    <label>Ödəniş kodu <span class="required">*</span></label>
                    <input type="text" name="odemeKodu" value="<%= customer.odeme_kodu %>" required readonly>
                </div>
                <div class="form-group">
                    <label>Aylıq ödəniş <span class="required">*</span></label>
                    <input type="number" name="ayliqOdenis" step="0.01" inputmode="decimal" value="<%= customer.ayliq_odenis || '' %>" required>
                </div>

                <div class="form-group">
                    <label>Ad Soyad Ata adı <span class="required">*</span></label>
                    <input type="text" name="adSoyad" value="<%= customer.ad_soyad %>" autocomplete="name" required>
                </div>
                <div class="form-group">
                    <label>Telefon nömrəsi <span class="required">*</span></label>
                    <input type="tel" name="telefon" value="<%= customer.telefon %>" autocomplete="tel" inputmode="tel" required>
                </div>

                <div class="form-group">
                    <label>Ş/V FİN</label>
                    <input type="text" name="fin" value="<%= customer.fin %>" autocomplete="off">
                </div>
                <div class="form-group">
                    <label>Ş/V Seriya</label>
                    <input type="text" name="seriya" value="<%= customer.seriya %>" autocomplete="off">
                </div>

                <div class="form-group">
                    <label>Modem S/N</label>
                    <input type="text" name="modem" value="<%= customer.modem %>" autocomplete="off">
                </div>
                <div class="form-group">
                    <label>TV Box</label>
                    <input type="text" name="tvbox" value="<%= customer.tvbox %>" autocomplete="off">
                </div>

                <div class="form-group">
                    <label>Ünvan <span class="required">*</span></label>
                    <input type="text" name="unvan" value="<%= customer.unvan %>" autocomplete="street-address" required>
                </div>
                <div class="form-group">
                    <label>Komendant</label>
                    <input type="text" name="komendant" value="<%= customer.komendant %>" autocomplete="off">
                </div>

                <div class="form-group full-width">
                    <label>Qeyd</label>
                    <textarea name="qeyd"><%= customer.qeyd %></textarea>
                </div>

                <div class="form-group full-width">
                    <label>Admin Qeydi Əlavə Et</label>
                    <textarea name="adminHistoryNote" rows="3" placeholder="Bu mətn yalnız fəaliyyət tarixçəsinə əlavə olunacaq; qeyd sahəsinə yazılmır."></textarea>
                    <span class="field-hint">Yadda saxlayanda tarixçəyə vaxt damğası ilə əlavə olunur.</span>
                </div>

                <div class="form-group full-width">
                    <label>Müqavilə və Modemin şəkli (Drive linkləri)</label>
                    <textarea class="drive-links" name="driveLinks" placeholder="https://drive.google.com/..."><%= (customer.drive_links || '').split(',').map(link => link.trim()).filter(Boolean).join('\n') %></textarea>
                    <span class="field-hint">Birdən çox link üçün vergül istifadə et və ya hər sətirdə 1 link yaz.</span>
                    <% const existingLinks = (customer.drive_links || '').split(',').map(link => link.trim()).filter(Boolean); %>
                    <% if (existingLinks.length) { %>
                        <div class="current-links">
                            <% existingLinks.forEach((link, i) => { %>
                                <a href="<%= link %>" target="_blank" rel="noopener"><i class="fa-solid fa-link"></i> Drive link <%= i + 1 %></a>
                            <% }) %>
                        </div>
                    <% } %>
                </div>

                <div class="form-group full-width">
                    <label>Problemin Səbəbi</label>
                    <textarea name="problemSebebi" placeholder="Problemin ətraflı səbəbini qeyd edin"><%= customer.problem_sebebi || '' %></textarea>
                </div>

                <div class="form-group full-width">
                    <label>Nəticə</label>
                    <% const neticeValue = customer.netice || '' ; %>
                    <select name="netice">
                        <option value="" <%= neticeValue === '' ? 'selected' : '' %>>-- Seçin --</option>
                        <option value="Həll olundu" <%= neticeValue === 'Həll olundu' ? 'selected' : '' %>>Həll olundu</option>
                        <option value="Həll olunmadı" <%= neticeValue === 'Həll olunmadı' ? 'selected' : '' %>>Həll olunmadı</option>
                    </select>
                </div>
            </div>

            <button type="submit" class="btn-submit">
                <i class="fa-solid fa-floppy-disk"></i> Yenilə
            </button>
        </form>
    </div>
</div>
</body>
</html>
