<!DOCTYPE html>
<html lang="az">
<head>
    <title>Müştəri Panel</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    <style>
        :root {
            --bg: #0f172a;
            --card-glass: rgba(30, 41, 59, 0.75);
            --card-soft: rgba(34, 48, 71, 0.85);
            --border-soft: rgba(255, 255, 255, 0.12);
            --green: #10b981;
            --green-dark: #059669;
            --text: #f1f5f9;
            --muted: #94a3b8;
            --muted-2: #cbd5e1;
            --blue: #3b82f6;
            --purple: #8b5cf6;
            --orange: #f59e0b;
            --red: #ef4444;
            --gray: #6b7280;
            --header-blur: blur(15px);
        }

        * { box-sizing: border-box; }

        body {
            font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
            margin: 0;
            color: var(--text);
            min-height: 100vh;
            /* ARXA FON ŞƏKLİ */
            background: linear-gradient(rgba(15, 23, 42, 0.8), rgba(15, 23, 42, 0.8)), 
                        url('https://raw.githubusercontent.com/AsadAsadov/Selnet/main/home.jpg');
            background-size: cover;
            background-position: center;
            background-attachment: fixed;
        }

        /* MODERN HEADER (GLASSMORPHISM) */
        .header {
            background: rgba(15, 23, 42, 0.6);
            backdrop-filter: var(--header-blur);
            -webkit-backdrop-filter: var(--header-blur);
            padding: 14px 24px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 1px solid var(--border-soft);
            position: sticky;
            top: 0;
            z-index: 1000;
            box-shadow: 0 10px 30px rgba(0,0,0,0.3);
        }

        .header .logo {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .header h1 {
            margin: 0;
            font-size: 18px;
            font-weight: 800;
            letter-spacing: 0.5px;
            background: linear-gradient(to right, #fff, var(--green));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .header .actions {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .header .actions a {
            text-decoration: none;
            font-weight: 700;
            font-size: 13px;
            padding: 10px 16px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            gap: 8px;
            color: #fff;
            transition: all 0.3s ease;
            background: rgba(255, 255, 255, 0.08);
            border: 1px solid var(--border-soft);
        }

        .header .actions a:hover {
            background: var(--green);
            transform: translateY(-2px);
            border-color: var(--green);
        }

        .header .actions a.btn-logout {
            background: rgba(239, 68, 68, 0.15);
            border: 1px solid rgba(239, 68, 68, 0.3);
        }

        .header .actions a.btn-logout:hover {
            background: var(--red);
            border-color: var(--red);
            box-shadow: 0 0 20px rgba(239, 68, 68, 0.3);
        }

        .container {
            padding: 25px 15px;
            max-width: 1100px;
            margin: auto;
        }

        /* ŞÜŞƏ EFFEKTLİ KARTLAR */
        .search-section, .card, .stat-card, .chart-container, .list-item {
            background: var(--card-glass);
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
            border: 1px solid var(--border-soft);
            box-shadow: 0 8px 32px rgba(0,0,0,0.2);
            border-radius: 20px;
        }

        .search-section { padding: 20px; margin-bottom: 25px; }

        .search-box { display: flex; gap: 12px; margin-bottom: 15px; }

        .search-box input {
            flex: 1;
            padding: 14px;
            background: rgba(15, 23, 42, 0.6);
            border: 1px solid var(--border-soft);
            border-radius: 12px;
            color: var(--text);
            font-size: 15px;
            transition: 0.3s;
        }

        .search-box input:focus {
            outline: none;
            border-color: var(--green);
            background: rgba(15, 23, 42, 0.8);
        }

        .search-box button {
            padding: 0 25px;
            background: var(--green);
            border: none;
            border-radius: 12px;
            color: #fff;
            font-weight: 800;
            cursor: pointer;
            transition: 0.3s;
        }

        .search-box button:hover { background: var(--green-dark); }

        .stats {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
            gap: 20px;
            margin-bottom: 25px;
        }

        .stat-card {
            padding: 25px;
            cursor: pointer;
            transition: all 0.3s ease;
            position: relative;
            overflow: hidden;
        }

        .stat-card:hover {
            transform: translateY(-5px);
            border-color: var(--green);
            background: rgba(30, 41, 59, 0.9);
        }

        .stat-card h3 { margin: 0 0 8px; color: var(--muted-2); font-size: 14px; }
        .stat-card p { margin: 0; font-size: 32px; font-weight: 900; color: #fff; }

        .list-item {
            padding: 16px 20px;
            margin-bottom: 12px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            transition: 0.3s;
        }

        .list-item:hover {
            background: rgba(16, 185, 129, 0.1);
            border-color: var(--green);
            transform: translateX(8px);
        }

        .badge {
            padding: 5px 12px;
            border-radius: 999px;
            font-size: 11px;
            font-weight: 800;
            text-transform: uppercase;
        }

        /* MOBİL UYĞUNLUQ */
        @media (max-width: 600px) {
            .header { padding: 12px 15px; }
            .header h1 span { display: none; }
            .header .actions a span { display: none; }
            .search-box { flex-direction: column; }
            .stat-card { padding: 20px; }
        }
    </style>
</head>
<body>

<div class="header">
    <div class="logo">
        <h1><i class="fa-solid fa-shield-halved"></i> <span>Müştəri Axtarış Sistemi</span></h1>
    </div>
    <div class="actions">
        <a href="/add"><i class="fa-solid fa-plus"></i><span>Əlavə Et</span></a>
        <a href="/logout" class="btn-logout"><i class="fa-solid fa-power-off"></i><span>Çıxış</span></a>
    </div>
</div>

<div class="container">
    <div class="search-section">
        <form class="search-box" method="GET">
            <input type="text" name="q" value="<%= q || '' %>" placeholder="Ödəniş kodu, Telefon, Ad...">
            <button type="submit"><i class="fa-solid fa-magnifying-glass"></i> Axtar</button>
        </form>
    </div>

    <% if (!q && !startDate && !endDate) { %>
    <div class="stats">
        <div class="stat-card" onclick="openCustomerListModal('all')">
            <h3>Ümumi Müştəri</h3>
            <p><%= totalCount %></p>
        </div>
        <div class="stat-card" style="border-left: 4px solid var(--green)" onclick="openCustomerListModal('today')">
            <h3>Bu Gün</h3>
            <p><%= todayCustomers.length %></p>
        </div>
        <div class="stat-card" style="border-left: 4px solid var(--gray)" onclick="openCustomerListModal('archive')">
            <h3>Arxiv</h3>
            <p><%= archivedCustomers.length %></p>
        </div>
    </div>
    <% } %>

    <div class="result-list">
        <% if (results && results.length > 0) { %>
            <% results.forEach(item => { %>
                <div class="list-item">
                    <div class="list-main">
                        <div style="font-weight: 800; font-size: 16px;"><%= item['Ad, Soyad, Ata adı'] %></div>
                        <div style="color: var(--muted); font-size: 13px; margin-top: 4px;">
                            Kod: <%= item['Ödəniş kodu'] %> | Tel: <%= item['Telefon nömrəsi'] %>
                        </div>
                    </div>
                    <i class="fa-solid fa-chevron-right" style="color: var(--muted)"></i>
                </div>
            <% }) %>
        <% } else if (q) { %>
            <div style="text-align:center; padding: 50px;">
                <i class="fa-solid fa-face-frown" style="font-size: 40px; color: var(--muted)"></i>
                <p>Nəticə tapılmadı.</p>
            </div>
        <% } %>
    </div>
</div>

</body>
</html>
