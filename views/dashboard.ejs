<!DOCTYPE html>
<html>
<head>
<title>Müştəri Panel</title>
<meta name="viewport" content="width=device-width, initial-scale=1">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<style>
:root {
  --bg: #0f172a;
  --card: rgba(30, 41, 59, 0.7);
  --card-glass: rgba(30, 41, 59, 0.85);
  --border-soft: rgba(255, 255, 255, 0.1);
  --green: #10b981;
  --green-glow: rgba(16, 185, 129, 0.3);
  --text: #f8fafc;
  --muted: #94a3b8;
  --blue: #3b82f6;
  --orange: #f59e0b;
  --red: #ef4444;
  --gray: #64748b;
}

* { box-sizing: border-box; margin: 0; padding: 0; }

body {
  font-family: 'Inter', system-ui, -apple-system, sans-serif;
  color: var(--text);
  min-height: 100vh;
  /* Sənin istədiyin arxa fon şəkli */
  background: linear-gradient(rgba(15, 23, 42, 0.8), rgba(15, 23, 42, 0.8)), 
              url('https://raw.githubusercontent.com/AsadAsadov/Selnet/main/home.jpg');
  background-size: cover;
  background-position: center;
  background-attachment: fixed;
}

/* YENİ MÜASİR HEADER (MODERN DESIGN) */
.header {
  background: rgba(15, 23, 42, 0.6);
  backdrop-filter: blur(15px);
  -webkit-backdrop-filter: blur(15px);
  padding: 15px 25px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  position: sticky;
  top: 0;
  z-index: 1000;
  border-bottom: 1px solid var(--border-soft);
  box-shadow: 0 4px 30px rgba(0, 0, 0, 0.3);
}

.header .logo {
  display: flex;
  align-items: center;
  gap: 12px;
}

.header .logo i {
  background: linear-gradient(135deg, var(--green), #34d399);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  font-size: 24px;
  filter: drop-shadow(0 0 8px var(--green-glow));
}

.header h1 {
  font-size: 18px;
  font-weight: 800;
  letter-spacing: -0.5px;
  background: linear-gradient(to right, #fff, #cbd5e1);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}

.header .actions {
  display: flex;
  gap: 10px;
}

.header .actions a {
  text-decoration: none;
  font-weight: 700;
  font-size: 13px;
  padding: 10px 18px;
  border-radius: 12px;
  display: flex;
  align-items: center;
  gap: 8px;
  color: #fff;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  position: relative;
  overflow: hidden;
}

.header .actions a:first-child {
  background: rgba(16, 185, 129, 0.15);
  border: 1px solid rgba(16, 185, 129, 0.3);
  color: #34d399;
}

.header .actions a:first-child:hover {
  background: var(--green);
  color: #fff;
  box-shadow: 0 0 20px var(--green-glow);
  transform: translateY(-2px);
}

.header .actions a.btn-logout {
  background: rgba(239, 68, 68, 0.1);
  border: 1px solid rgba(239, 68, 68, 0.2);
  color: #f87171;
}

.header .actions a.btn-logout:hover {
  background: var(--red);
  color: #fff;
  box-shadow: 0 0 20px rgba(239, 68, 68, 0.3);
  transform: translateY(-2px);
}

/* KONTEYNER VƏ DİGƏR ELEMENTLƏRİN ŞÜŞƏ EFFEKTİ */
.container {
  padding: 20px;
  max-width: 1100px;
  margin: auto;
}

.search-section {
  background: var(--card-glass);
  backdrop-filter: blur(10px);
  border: 1px solid var(--border-soft);
  border-radius: 20px;
  padding: 20px;
  margin-bottom: 25px;
  box-shadow: 0 10px 40px rgba(0,0,0,0.2);
}

.search-box input {
  background: rgba(15, 23, 42, 0.6) !important;
  border: 1px solid var(--border-soft) !important;
  transition: 0.3s;
}

.search-box input:focus {
  border-color: var(--green) !important;
  background: rgba(15, 23, 42, 0.8) !important;
}

.stat-card {
  background: var(--card-glass);
  backdrop-filter: blur(10px);
  border: 1px solid var(--border-soft);
  border-radius: 20px;
  transition: 0.3s ease;
}

.stat-card:hover {
  transform: translateY(-5px);
  border-color: var(--green);
  box-shadow: 0 15px 45px rgba(0,0,0,0.3);
}

/* Qalan bütün mövcud CSS-lərin (Modal, List, Pagination) saxlanılır... */
/* ... (Burada sənin orijinal CSS-lərin davam edir) ... */

</style>
</head>
<body>

<div class="header">
  <div class="logo">
    <i class="fa-solid fa-shield-halved"></i>
    <h1>Müştəri Axtarış Sistemi</h1>
  </div>
  <div class="actions">
    <a href="/add"><i class="fa-solid fa-user-plus"></i><span>Əlavə Et</span></a>
    <a href="/logout" class="btn-logout"><i class="fa-solid fa-power-off"></i><span>Çıxış</span></a>
  </div>
</div>

    <div class="chart-container" id="monthlyStatsCard">
      <button class="chart-toggle" type="button" id="chartToggle" aria-expanded="false" aria-controls="chartPanel">
        <span class="chart-toggle-title"><i class="fa-solid fa-chart-line"></i> Aylıq Qoşulma Statistikası</span>
        <span class="chart-toggle-icon"><i class="fa-solid fa-chevron-down"></i></span>
      </button>
      <div class="chart-panel" id="chartPanel">
        <div class="chart-inner">
          <% if (monthlyStats.labels.length > 0) { %>
            <div class="chart-actions"><button class="btn-expand" onclick="openChartModal()"><i class="fa-solid fa-expand"></i> Böyüt</button></div>
            <div class="chart-scroll"><div class="chart-wrapper" style="min-width:<%= Math.max(560, monthlyStats.labels.length * 92) %>px"><canvas id="monthlyChart"></canvas></div></div>
            <div class="chart-buttons" data-chart-scope="main">
              <button class="chart-btn active" data-type="total" onclick="updateChart('total','main')">Ümumi</button>
              <button class="chart-btn green" data-type="qosulma" onclick="updateChart('qosulma','main')">Qoşulma</button>
              <button class="chart-btn orange" data-type="kocurme" onclick="updateChart('kocurme','main')">Köçürmə</button>
            </div>
          <% } else { %>
            <div class="chart-empty"><i class="fa-regular fa-chart-bar"></i><strong>Statistika tapılmadı</strong><span>Chart üçün aylıq məlumat yoxdur.</span></div>
          <% } %>
        </div>
      </div>
    </div>

  <% } %>
</div>

<div id="customerModal" class="modal" aria-hidden="true">
  <div class="modal-content customer-detail-modal-content">
    <div class="modal-header">
      <h2 id="modalTitle"></h2>
      <div class="modal-controls">
        <button onclick="navigateModal(-1)" id="prevBtn"><i class="fa-solid fa-chevron-left"></i></button>
        <span id="modalCounter" style="color:var(--muted);font-size:14px"></span>
        <button onclick="navigateModal(1)" id="nextBtn"><i class="fa-solid fa-chevron-right"></i></button>
        <span class="close-btn" onclick="closeModal('customerModal')">&times;</span>
      </div>
    </div>
    <div class="modal-body grid" id="modalBody"></div>
  </div>
</div>

<div id="chartModal" class="modal" aria-hidden="true">
  <div class="modal-content large">
    <div class="modal-header"><h2>Aylıq Qoşulma Statistikası</h2><span class="close-btn" onclick="closeModal('chartModal')">&times;</span></div>
    <div class="modal-body">
      <% if (monthlyStats.labels.length > 0) { %>
        <div class="chart-scroll"><div class="modal-chart-frame" style="min-width:<%= Math.max(620, monthlyStats.labels.length * 96) %>px"><canvas id="modalChart"></canvas></div></div>
        <div class="chart-buttons" data-chart-scope="modal">
          <button class="chart-btn active" data-type="total" onclick="updateChart('total','modal')">Ümumi</button>
          <button class="chart-btn green" data-type="qosulma" onclick="updateChart('qosulma','modal')">Qoşulma</button>
          <button class="chart-btn orange" data-type="kocurme" onclick="updateChart('kocurme','modal')">Köçürmə</button>
        </div>
      <% } else { %><div class="chart-empty"><i class="fa-regular fa-chart-bar"></i><strong>Statistika tapılmadı</strong></div><% } %>
    </div>
  </div>
</div>

<div id="customerListModal" class="modal" aria-hidden="true">
  <div class="modal-content customer-list-modal-content">
    <div class="modal-header customer-list-header">
      <div>
        <h2 id="customerListTitle"><i class="fa-solid fa-users"></i> Bütün Müştərilər <span class="modal-count-badge" id="customerListCount">0</span></h2>
        <p id="customerListSubtitle">Siyahı yüklənir...</p>
      </div>
      <span class="close-btn" onclick="closeModal('customerListModal')">&times;</span>
    </div>
    <div class="customer-modal-search">
      <i class="fa-solid fa-magnifying-glass"></i>
      <input id="customerListSearch" type="search" autocomplete="off" placeholder="Ad, telefon və ya ödəniş kodu üzrə axtar...">
    </div>
    <div class="modal-body customer-list-body" id="customerListBody"><div class="loading-block"><div class="skeleton-list"><div class="skeleton-card"></div><div class="skeleton-card"></div><div class="skeleton-card"></div></div></div></div>
  </div>
</div>

<script>
let currentModalIndex = 0;
let currentModalList = [];
let currentModalType = '';
let mainChart = null;
let modalChartInstance = null;
let customerListAbortController = null;
let modalAbortController = null;
let modalRequestSeq = 0;
let mainChartInitialized = false;
let activeChartType = 'total';
let customerListState = { type: 'all', page: 1, limit: 10, totalPages: 1, totalCustomers: 0, customers: [], filteredCustomers: [], search: '' };
const chartData = <%- JSON.stringify(monthlyStats) %>;
const chartHasData = Array.isArray(chartData.labels) && chartData.labels.length > 0;
const modalLists = {
  search: <%- JSON.stringify(results.map(r => r['Ödəniş kodu']).filter(Boolean)) %>,
  today: <%- JSON.stringify(todayCustomers.map(r => r['Ödəniş kodu']).filter(Boolean)) %>,
  archive: <%- JSON.stringify(archivedCustomers.map(r => r['Ödəniş kodu']).filter(Boolean)) %>,
  all: []
};
const embeddedSearchCustomers = <%- JSON.stringify(results || []) %>;
const customerListConfig = {
  all: { title: 'Bütün Müştərilər', icon: 'fa-users', endpoint: '/api/all-customers', subtitle: 'Bütün müştəri bazası' },
  today: { title: 'Bu gün əlavə olunanlar', icon: 'fa-calendar-day', endpoint: '/api/today-customers', subtitle: 'Bugünkü aktiv qeydiyyatlar' },
  archive: { title: 'Arxivdə olanlar', icon: 'fa-box-archive', endpoint: '/api/archive-customers', subtitle: 'Arxiv statuslu müştərilər' },
  search: { title: 'Axtarış nəticələri', icon: 'fa-magnifying-glass', endpoint: null, subtitle: 'Cari axtarış nəticələri' }
};

function escapeHtml(value){return String(value ?? '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#039;');}
function formatDate(timestamp){
  if(timestamp === undefined || timestamp === null || String(timestamp).trim() === '') return 'Tarix yoxdur';
  const raw = String(timestamp).trim();
  let match = raw.match(/^(\d{1,2})\/(\d{1,2})\/(\d{4})/);
  if(match){const m=Number(match[1]),d=Number(match[2]),y=Number(match[3]);if(m>=1&&m<=12&&d>=1&&d<=31)return `${String(d).padStart(2,'0')}.${String(m).padStart(2,'0')}.${y}`;}
  match = raw.match(/^(\d{4})-(\d{1,2})-(\d{1,2})/);
  if(match){const y=Number(match[1]),m=Number(match[2]),d=Number(match[3]);if(m>=1&&m<=12&&d>=1&&d<=31)return `${String(d).padStart(2,'0')}.${String(m).padStart(2,'0')}.${y}`;}
  const parsed = new Date(raw);
  if(!Number.isNaN(parsed.getTime())) return `${String(parsed.getDate()).padStart(2,'0')}.${String(parsed.getMonth()+1).padStart(2,'0')}.${parsed.getFullYear()}`;
  return 'Tarix yoxdur';
}
function getCustomerType(item){const qeydText=String(item?.['Qeyd']||'').toLowerCase();const isArchived=String(item?.['Arxiv']||'').toLowerCase()==='hə';const typeClass=isArchived?'archived-item':(qeydText.includes('köç')?'kocurme':'qosulma');const badgeClass=isArchived?'archived':typeClass;const typeLabel=isArchived?'Arxivdə':(qeydText.includes('köç')?'Köçürmə':'Qoşulma');const iconClass=isArchived?'fa-box-archive':(typeClass==='kocurme'?'fa-truck-moving':'fa-plug');return{typeClass,badgeClass,typeLabel,iconClass};}
function createBadge(type){return `<span class="badge ${type.badgeClass}"><i class="fa-solid ${type.iconClass}"></i> ${escapeHtml(type.typeLabel)}</span>`;}
function createLoadingSkeleton(count=3){return `<div class="loading-block"><div class="skeleton-list">${Array.from({length:count},()=>'<div class="skeleton-card"></div>').join('')}</div></div>`;}
function createSpinner(text='Yüklənir...'){return `<div class="loader-inline"><span class="spinner"></span><span>${escapeHtml(text)}</span></div>`;}
function debounce(fn, wait=180){let timeout;return (...args)=>{clearTimeout(timeout);timeout=setTimeout(()=>fn(...args),wait);};}
function normalizeSearch(value){return String(value ?? '').toLowerCase().replace(/\s+/g,'').trim();}
function customerMatchesSearch(item, query){if(!query)return true;const haystack=[item?.['Ad, Soyad, Ata adı'],item?.['Telefon nömrəsi'],item?.['Ödəniş kodu']].map(normalizeSearch).join('|');return haystack.includes(query);}
function createCustomerListItem(item,index,listType='all'){
  const type=getCustomerType(item);const odemeKodu=String(item?.['Ödəniş kodu']??'');const adSoyad=item?.['Ad, Soyad, Ata adı']||'Adsız müştəri';const telefon=item?.['Telefon nömrəsi']||'-';const unvan=item?.['Ünvan']||'';
  return `<div class="list-item ${type.typeClass}" data-code="${escapeHtml(odemeKodu)}" data-index="${Number(index)||0}" data-list="${escapeHtml(listType)}" role="button" tabindex="0"><div class="list-main"><div class="list-top"><div class="name list-item-name">${escapeHtml(adSoyad)}${createBadge(type)}</div><span class="list-date"><i class="fa-regular fa-calendar"></i> ${escapeHtml(formatDate(item?.['Timestamp']))}</span></div><div class="meta"><strong>Kod:</strong> ${escapeHtml(odemeKodu||'-')} · <strong>Tel:</strong> ${escapeHtml(telefon)}${unvan?` · ${escapeHtml(unvan)}`:''}</div></div><i class="fa-solid fa-chevron-right chevron"></i></div>`;
}

function syncModalLock(){const hasOpenModal=Boolean(document.querySelector('.modal.is-open'));document.body.classList.toggle('modal-open',hasOpenModal);}
function setModalOpen(id,isOpen){const el=document.getElementById(id);if(!el)return;el.classList.toggle('is-open',isOpen);el.setAttribute('aria-hidden',String(!isOpen));syncModalLock();if(!isOpen&&id==='customerListModal'&&customerListAbortController){customerListAbortController.abort();customerListAbortController=null;}}
function closeModal(id){setModalOpen(id,false);if(id==='customerModal'&&modalAbortController){modalAbortController.abort();modalAbortController=null;}}

function setupChartToggle(){const card=document.getElementById('monthlyStatsCard');const toggle=document.getElementById('chartToggle');if(!card||!toggle)return;const saved=localStorage.getItem('monthlyStatsChartOpen')==='true';setChartOpen(saved,false);toggle.addEventListener('click',()=>setChartOpen(!card.classList.contains('is-open'),true));}
function setChartOpen(open,persist){const card=document.getElementById('monthlyStatsCard');const toggle=document.getElementById('chartToggle');if(!card||!toggle)return;card.classList.toggle('is-open',open);toggle.setAttribute('aria-expanded',String(open));if(persist)localStorage.setItem('monthlyStatsChartOpen',String(open));if(open&&chartHasData&&!mainChartInitialized){requestAnimationFrame(()=>initChart());}else if(open&&mainChart){setTimeout(()=>mainChart.resize(),260);}}
function chartConfig(type='total'){const colors={total:{bg:'rgba(59,130,246,.46)',border:'#3b82f6'},qosulma:{bg:'rgba(16,185,129,.52)',border:'#10b981'},kocurme:{bg:'rgba(245,158,11,.55)',border:'#f59e0b'}};const labels={total:'Ümumi',qosulma:'Qoşulma',kocurme:'Köçürmə'};return{label:labels[type]||labels.total,color:colors[type]||colors.total};}
function syncChartButtons(scope,type=activeChartType){document.querySelectorAll(`.chart-buttons[data-chart-scope="${scope}"] .chart-btn`).forEach(b=>b.classList.toggle('active',b.dataset.type===type));}
function buildChart(ctx,type=activeChartType){const cfg=chartConfig(type);return new Chart(ctx,{type:'bar',data:{labels:chartData.labels,datasets:[{label:cfg.label,data:chartData[type]||[],backgroundColor:cfg.color.bg,borderColor:cfg.color.border,borderWidth:2,borderRadius:8,barPercentage:.72,categoryPercentage:.68}]},options:{responsive:true,maintainAspectRatio:false,animation:{duration:450,easing:'easeOutQuart'},plugins:{legend:{labels:{color:'#e2e8f0'}}},scales:{y:{beginAtZero:true,ticks:{color:'#94a3b8',stepSize:1,precision:0},grid:{color:'rgba(51,65,85,.8)'}},x:{ticks:{color:'#cbd5e1',autoSkip:false,maxRotation:0,minRotation:0},grid:{color:'rgba(51,65,85,.45)'}}}}});}
function initChart(){if(!chartHasData||mainChartInitialized)return;const ctx=document.getElementById('monthlyChart');if(!ctx)return;mainChart=buildChart(ctx,activeChartType);syncChartButtons('main');mainChartInitialized=true;}
function openChartModal(){setModalOpen('chartModal',true);syncChartButtons('modal');if(chartHasData&&!modalChartInstance){requestAnimationFrame(()=>{const ctx=document.getElementById('modalChart');if(ctx)modalChartInstance=buildChart(ctx,activeChartType);});}else if(modalChartInstance){setTimeout(()=>modalChartInstance.resize(),120);}}
function updateChart(type,scope='main'){if(!chartData[type])return;activeChartType=type;const cfg=chartConfig(type);['main','modal'].forEach(syncScope=>syncChartButtons(syncScope,type));[mainChart,modalChartInstance].filter(Boolean).forEach(chart=>{chart.data.datasets[0].label=cfg.label;chart.data.datasets[0].data=chartData[type]||[];chart.data.datasets[0].backgroundColor=cfg.color.bg;chart.data.datasets[0].borderColor=cfg.color.border;chart.update('active');});}

function updateCustomerListHeader(){const cfg=customerListConfig[customerListState.type]||customerListConfig.all;const title=document.getElementById('customerListTitle');const count=document.getElementById('customerListCount');const subtitle=document.getElementById('customerListSubtitle');if(title)title.innerHTML=`<i class="fa-solid ${cfg.icon}"></i> ${escapeHtml(cfg.title)} <span class="modal-count-badge" id="customerListCount">${Number(customerListState.totalCustomers)||0}</span>`;if(count)count.textContent=Number(customerListState.totalCustomers)||0;if(subtitle)subtitle.textContent=`${cfg.subtitle} · Səhifə ${customerListState.page} / ${customerListState.totalPages}`;}
function setCustomerListSearchValue(value=''){const input=document.getElementById('customerListSearch');if(input)input.value=value;customerListState.search=normalizeSearch(value);}
async function openCustomerListModal(type='all'){customerListState={...customerListState,type:customerListConfig[type]?type:'all',page:1,totalPages:1,totalCustomers:0,customers:[],filteredCustomers:[],search:''};setCustomerListSearchValue('');updateCustomerListHeader();setModalOpen('customerListModal',true);await loadCustomerListPage(1);setTimeout(()=>document.getElementById('customerListSearch')?.focus(),80);}
function showCustomerListError(message){const body=document.getElementById('customerListBody');if(!body)return;body.innerHTML=`<div class="not-found" style="margin:0"><p><i class="fa-solid fa-triangle-exclamation"></i> ${escapeHtml(message||'Müştərilər yüklənmədi.')}</p><button class="btn-edit" type="button" onclick="loadCustomerListPage(${Number(customerListState.page)||1})"><i class="fa-solid fa-rotate-right"></i> Yenidən cəhd et</button></div>`;}
async function loadCustomerListPage(page=1){const cfg=customerListConfig[customerListState.type]||customerListConfig.all;const requestedPage=Number.parseInt(page,10)||1;const body=document.getElementById('customerListBody');if(!body)return;customerListState.page=requestedPage;updateCustomerListHeader();body.innerHTML=createLoadingSkeleton(5);if(customerListAbortController)customerListAbortController.abort();customerListAbortController=new AbortController();try{let payload;if(customerListState.type==='search'){const customers=Array.isArray(embeddedSearchCustomers)?embeddedSearchCustomers:[];payload={customers,currentPage:1,totalPages:1,totalCustomers:customers.length};}else{const res=await fetch(`${cfg.endpoint}?page=${encodeURIComponent(requestedPage)}&limit=${encodeURIComponent(customerListState.limit)}`,{headers:{Accept:'application/json'},credentials:'same-origin',signal:customerListAbortController.signal});const contentType=res.headers.get('content-type')||'';if(!contentType.includes('application/json'))throw new Error(res.status===401?'Sessiya bitib. Zəhmət olmasa yenidən daxil olun.':'Server JSON formatında cavab qaytarmadı.');payload=await res.json();if(!res.ok||payload.success!==true)throw new Error(payload.error||`Server xətası (${res.status})`);}customerListState.customers=Array.isArray(payload.customers)?payload.customers:(Array.isArray(payload.data)?payload.data:[]);customerListState.page=Math.max(1,Number.parseInt(payload.currentPage,10)||1);customerListState.totalPages=Math.max(1,Number.parseInt(payload.totalPages,10)||1);customerListState.totalCustomers=Number.parseInt(payload.totalCustomers,10)||customerListState.customers.length;applyCustomerListFilter();}catch(error){if(error.name==='AbortError')return;console.error('[customer-list-modal] Müştərilər yüklənmədi:',error);showCustomerListError(error.message);}}
function applyCustomerListFilter(){const query=customerListState.search;customerListState.filteredCustomers=customerListState.customers.filter(item=>customerMatchesSearch(item,query));modalLists[customerListState.type]=customerListState.filteredCustomers.map(c=>c&&c['Ödəniş kodu']).filter(code=>code!==undefined&&code!==null&&String(code).trim()!=='').map(String);renderCustomerListModal();}
function renderCustomerListModal(){const body=document.getElementById('customerListBody');if(!body)return;updateCustomerListHeader();const customers=customerListState.filteredCustomers;const totalLabel=customerListState.search?`${customers.length} uyğun nəticə`:`${customerListState.totalCustomers} müştəri`;if(customers.length===0){body.innerHTML=`<div class="customer-list-empty"><i class="fa-regular fa-folder-open"></i><p>${customerListState.search?'Axtarışa uyğun müştəri tapılmadı.':'Siyahıda müştəri yoxdur.'}</p></div>`;return;}const listHtml=`<div class="all-customers-toolbar"><span><i class="fa-solid fa-layer-group"></i> Səhifə ${customerListState.page} / ${customerListState.totalPages}</span><strong>${escapeHtml(totalLabel)}</strong></div><div class="compact-list">${customers.map((item,index)=>createCustomerListItem(item,index,customerListState.type)).join('')}</div>`;const paginationHtml=customerListState.type==='search'?'':`<div class="pagination"><button type="button" ${customerListState.page<=1?'disabled':''} onclick="loadCustomerListPage(${customerListState.page-1})">Əvvəlki</button><span style="padding:8px 15px">Səhifə ${customerListState.page} / ${customerListState.totalPages}</span><button type="button" ${customerListState.page>=customerListState.totalPages?'disabled':''} onclick="loadCustomerListPage(${customerListState.page+1})">Növbəti</button></div>`;body.innerHTML=listHtml+paginationHtml;}
const handleCustomerListSearch=debounce((event)=>{customerListState.search=normalizeSearch(event.target.value);applyCustomerListFilter();},180);

function openModal(odemeKodu,index,type='search'){currentModalType=type;currentModalList=Array.isArray(modalLists[type])?[...modalLists[type]]:[];if(!currentModalList.length&&odemeKodu)currentModalList=[String(odemeKodu)];currentModalIndex=currentModalList.map(String).indexOf(String(odemeKodu));if(currentModalIndex<0)currentModalIndex=Number.isInteger(index)?index:0;loadModalCustomer(odemeKodu);}
async function loadModalCustomer(odemeKodu){const modalBody=document.getElementById('modalBody');const modalTitle=document.getElementById('modalTitle');const counter=document.getElementById('modalCounter');const prevBtn=document.getElementById('prevBtn');const nextBtn=document.getElementById('nextBtn');if(!modalBody||!modalTitle)return;if(modalAbortController)modalAbortController.abort();modalAbortController=new AbortController();const requestId=++modalRequestSeq;modalTitle.textContent='Müştəri məlumatı';modalBody.innerHTML=createSpinner('Məlumat yüklənir...');setModalOpen('customerModal',true);counter.textContent=currentModalList.length?`${currentModalIndex+1} / ${currentModalList.length}`:'';prevBtn.disabled=currentModalIndex<=0;nextBtn.disabled=currentModalIndex>=currentModalList.length-1;try{const res=await fetch(`/customer/${encodeURIComponent(odemeKodu)}`,{headers:{Accept:'application/json'},credentials:'same-origin',signal:modalAbortController.signal});const contentType=res.headers.get('content-type')||'';if(!contentType.includes('application/json'))throw new Error(res.status===401?'Sessiya bitib. Zəhmət olmasa yenidən daxil olun.':'Server JSON formatında cavab qaytarmadı.');const json=await res.json();if(requestId!==modalRequestSeq)return;if(!res.ok||json.success!==true||!json.data)throw new Error(json.error||'Məlumat tapılmadı.');const r=json.data;const isArchived=String(r['Arxiv']||'').toLowerCase()==='hə';modalTitle.innerHTML=`${escapeHtml(r['Ad, Soyad, Ata adı']||'Adsız')} ${isArchived?'<span class="badge archived" style="font-size:14px;vertical-align:middle"><i class="fa-solid fa-box-archive"></i> Arxivdə</span>':''}`;const fields=[{key:'Ödəniş kodu',label:'Ödəniş Kodu'},{key:'Telefon nömrəsi',label:'Telefon',type:'tel'},{key:'Aylıq ödəniş',label:'Aylıq Ödəniş',suffix:' AZN'},{key:'Ş/V FİN',label:'Ş/V FİN'},{key:'Ş/V Seriya',label:'Ş/V Seriya'},{key:'Modem S/N',label:'Modem S/N'},{key:'Tv Box',label:'TV Box'},{key:'Komendant',label:'Komendant'},{key:'Timestamp',label:'Qeydiyyat tarixi',type:'date'},{key:'Ünvan',label:'Ünvan',full:true},{key:'Qeyd',label:'Qeyd',full:true},{key:'Müqavilə və Modemin şəkli',label:'Müqavilə Şəkli',type:'image',full:true}];let html='';fields.forEach(f=>{let val=r[f.key];if(f.type==='date')val=formatDate(val);if(val&&String(val).trim()!==''&&String(val).toLowerCase()!=='yox'){const valueClass=f.type==='tel'?'info-value info-value--contact':(f.type==='image'?'info-value info-value--links':'info-value');html+=`<div class="info-item ${f.full?'full-width':''}"><label>${escapeHtml(f.label)}</label><p class="${valueClass}">`;if(f.type==='tel'){const cleanTel=String(val).replace(/\s/g,'');const waTel='994'+cleanTel.replace(/^0/,'');html+=`<a href="tel:${encodeURIComponent(cleanTel)}" class="info-link">${escapeHtml(val)}</a><a href="https://wa.me/${encodeURIComponent(waTel)}" target="_blank" rel="noopener" class="btn-wa"><i class="fa-brands fa-whatsapp"></i> WhatsApp</a>`;}else if(f.type==='image'){const links=String(val).split(',').map(l=>l.trim()).filter(Boolean);html+=links.map((l,i)=>`<a class="btn-image drive-link" href="${escapeHtml(l)}" target="_blank" rel="noopener" title="${escapeHtml(l)}"><i class="fa-solid fa-image"></i> Şəkil ${i+1}</a>`).join('');}else{html+=`<span class="info-text">${escapeHtml(val)}${f.suffix||''}</span>`;}html+='</p></div>';}});const codeArg=JSON.stringify(String(r['Ödəniş kodu']||'')).replace(/'/g,'\u0027');html+=`<div class="info-item full-width modal-actions"><a href="/edit/${encodeURIComponent(r['Ödəniş kodu'])}" class="btn-edit"><i class="fa-solid fa-pen"></i> Redaktə</a><button class="btn-delete" onclick='deleteCustomer(${codeArg}, ${Number(r.rowIndex)||0})'><i class="fa-solid fa-trash"></i> Sil</button>${isArchived?`<button class="btn-unarchive" onclick='toggleArchive(${codeArg}, ${Number(r.rowIndex)||0}, false)'><i class="fa-solid fa-box-open"></i> Arxivdən Çıxart</button>`:`<button class="btn-archive" onclick='toggleArchive(${codeArg}, ${Number(r.rowIndex)||0}, true)'><i class="fa-solid fa-box-archive"></i> Arxivə Göndər</button>`}</div>`;modalBody.innerHTML=html;}catch(error){if(error.name==='AbortError')return;console.error('[customer-modal] Müştəri yüklənmədi:',error);modalTitle.textContent='Xəta';modalBody.innerHTML=`<div class="not-found" style="margin:0"><p><i class="fa-solid fa-triangle-exclamation"></i> ${escapeHtml(error.message||'Məlumat yüklənmədi.')}</p></div>`;}}
function navigateModal(direction){const newIndex=currentModalIndex+direction;if(newIndex>=0&&newIndex<currentModalList.length){currentModalIndex=newIndex;loadModalCustomer(currentModalList[currentModalIndex]);}}

async function postJson(url,body){const res=await fetch(url,{method:'POST',headers:{'Content-Type':'application/json',Accept:'application/json'},credentials:'same-origin',body:JSON.stringify(body)});const contentType=res.headers.get('content-type')||'';if(!contentType.includes('application/json'))throw new Error('Server JSON formatında cavab qaytarmadı.');const json=await res.json();if(!res.ok||json.success!==true)throw new Error(json.error||`Server xətası (${res.status})`);return json;}
async function deleteCustomer(odemeKodu,rowIndex){if(!confirm(`"${odemeKodu}" ödəniş kodlu müştərini silmək istəyirsiniz?`))return;try{await postJson(`/delete/${encodeURIComponent(odemeKodu)}`,{rowIndex});alert('Müştəri silindi');location.reload();}catch(error){alert('Xəta: '+error.message);}}
async function toggleArchive(odemeKodu,rowIndex,archive){const action=archive?'arxivə göndərmək':'arxivdən çıxartmaq';if(!confirm(`"${odemeKodu}" ödəniş kodlu müştərini ${action} istəyirsiniz?`))return;try{await postJson(`/archive/${encodeURIComponent(odemeKodu)}`,{rowIndex,archive});alert(archive?'Müştəri arxivə göndərildi':'Müştəri arxivdən çıxarıldı');location.reload();}catch(error){alert('Xəta: '+error.message);}}

document.addEventListener('click',(e)=>{const item=e.target.closest('.list-item[data-code]');if(item){openModal(item.dataset.code,Number.parseInt(item.dataset.index,10)||0,item.dataset.list||'search');return;}if(e.target.classList.contains('modal'))closeModal(e.target.id);});
document.addEventListener('keydown',(e)=>{if(e.key==='Enter'||e.key===' '){const item=e.target.closest?.('.list-item[data-code]');if(item){e.preventDefault();openModal(item.dataset.code,Number.parseInt(item.dataset.index,10)||0,item.dataset.list||'search');return;}}const customerOpen=document.getElementById('customerModal')?.classList.contains('is-open');if(customerOpen){if(e.key==='Escape'){closeModal('customerModal');return;}if(e.key==='ArrowLeft')navigateModal(-1);if(e.key==='ArrowRight')navigateModal(1);}if(e.key==='Escape'){if(document.getElementById('chartModal')?.classList.contains('is-open')){closeModal('chartModal');return;}if(document.getElementById('customerListModal')?.classList.contains('is-open'))closeModal('customerListModal');}});
document.addEventListener('DOMContentLoaded',()=>{setupChartToggle();document.getElementById('customerListSearch')?.addEventListener('input',handleCustomerListSearch);});
</script>

</body></html>
