<!DOCTYPE html><html><head>
<title>Müştəri Panel</title><meta name="viewport" content="width=device-width, initial-scale=1">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<style>
:root{--bg:#0f172a;--card:#1e293b;--border:#334155;--green:#10b981;--text:#e2e8f0;--muted:#94a3b8;--blue:#3b82f6;--purple:#8b5cf6;--orange:#f59e0b;--red:#ef4444}
body{font-family:system-ui;margin:0;background:var(--bg);color:var(--text)}

/* DÜZƏLİŞ 1: HEADER - font kiçildi, çıxış qırmızı oldu */
.header{background:linear-gradient(90deg, #059669, #10b981);padding:10px 12px;display:flex;justify-content:space-between;align-items:center;gap:8px}
.header.logo{display:flex;align-items:center;gap:6px;flex:1;min-width:0}
.header h1{margin:0;font-size:15px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;font-weight:600}
.header.actions{display:flex;align-items:center;gap:6px;flex-shrink:0}
.header.actions a{color:#fff;text-decoration:none;font-weight:500;font-size:12px;padding:6px 10px;background:rgba(255,255,255,0.15);border-radius:6px;white-space:nowrap;display:flex;align-items:center;gap:4px}
.header.actions a:hover{background:rgba(255,255,255,0.25)}
.header.actions a.btn-logout{background:rgba(239,68,68,0.9)}
.header.actions a.btn-logout:hover{background:var(--red)}
@media (max-width:380px){
.header{padding:8px 10px}
.header h1{font-size:13px}
.header.actions a{font-size:11px;padding:5px 8px}
.header.actions a span{display:none}
}
@media (max-width:340px){
.header h1{font-size:12px}
}

.container{padding:15px;max-width:1000px;margin:auto}
.search-section{background:var(--card);border:1px solid var(--border);border-radius:12px;padding:15px;margin-bottom:20px}

/* DÜZƏLİŞ 2: SEARCH BOX - box-sizing əlavə olundu */
.search-box{display:flex;gap:10px;margin-bottom:12px}
.search-box input{flex:1;padding:12px;background:var(--bg);border:1px solid var(--border);border-radius:8px;color:var(--text);font-size:15px;min-width:0;box-sizing:border-box}
.search-box button{padding:12px 20px;background:var(--green);border:none;border-radius:8px;color:#fff;font-weight:bold;cursor:pointer;white-space:nowrap;box-sizing:border-box}
.search-box button:hover{background:#059669}

/* DÜZƏLİŞ 3: DATE FILTER - Tam mərkəzləşdirilmiş və sığdırılmış versiya */
.date-filter{display:grid;grid-template-columns:repeat(2, minmax(0, 1fr));gap:10px;align-items:center;width:100%;box-sizing:border-box}
.date-filter label{font-size:13px;color:var(--muted);grid-column:1 / -1;margin-bottom:2px;display:flex;align-items:center;gap:6px}
.date-filter input[type="date"]{padding:10px 5px;background:var(--bg);border:1px solid var(--border);border-radius:8px;color:var(--text);font-size:13px;width:100%;box-sizing:border-box;text-align:center;min-width:0}
.filter-actions{display:flex;flex-direction:column;gap:10px;grid-column:1/-1;margin-top:4px;width:100%}
.btn-filter,.btn-clear{width:100%;box-sizing:border-box;justify-content:center}
.btn-filter{padding:10px 15px;background:var(--green);border:none;border-radius:8px;color:#fff;cursor:pointer;font-weight:500;white-space:nowrap}
.btn-filter:hover{background:#059669}
.btn-clear{display:inline-flex;align-items:center;gap:6px;padding:10px 15px;background:var(--border);border-radius:8px;color:var(--text);text-decoration:none;font-size:14px;white-space:nowrap}

.search-info{color:var(--muted);font-size:14px;margin-bottom:20px}
.stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:15px;margin-bottom:25px}
.stat-card{background:var(--card);border:1px solid var(--border);padding:20px;border-radius:12px;cursor:pointer;transition:0.2s}
.stat-card:hover{border-color:var(--green);transform:translateY(-2px)}
.stat-card h3{margin:0 0 5px 0;color:var(--muted);font-size:14px;font-weight:500}
.stat-card p{margin:0;font-size:28px;font-weight:bold}
.stat-card.blue{border-left:4px solid var(--blue)}.stat-card.green{border-left:4px solid var(--green)}.stat-card.purple{border-left:4px solid var(--purple)}
.chart-container{background:var(--card);border:1px solid var(--border);border-radius:12px;padding:20px;margin-bottom:25px;position:relative}
.chart-wrapper{height:300px;position:relative}
.btn-expand{position:absolute;top:15px;right:15px;background:var(--border);border:none;color:var(--text);padding:8px 12px;border-radius:6px;cursor:pointer;font-size:13px}
.btn-expand:hover{background:var(--green)}
.chart-buttons{display:flex;gap:8px;margin-top:15px;flex-wrap:wrap}
.chart-btn{padding:8px 16px;background:var(--border);border:none;border-radius:6px;color:var(--text);cursor:pointer;font-size:14px;font-weight:500}
.chart-btn.active{background:var(--green)}
.chart-btn.orange.active{background:var(--orange)}
.chart-btn.blue.active{background:var(--blue)}
.card{background:var(--card);border:1px solid var(--border);border-radius:12px;overflow:hidden;margin-bottom:20px}
.card-header{padding:20px;border-bottom:1px solid var(--border)}
.card-header h2{margin:0 0 5px 0;font-size:22px}.card-header span{color:var(--muted);font-size:14px}
.card-body{padding:20px;display:grid;grid-template-columns:1fr 1fr;gap:20px}
.info-item label{font-size:12px;color:var(--muted);display:block;margin-bottom:5px;text-transform:uppercase}
.info-item p{margin:0;font-size:16px;font-weight:500;word-break:break-word;display:flex;align-items:center;gap:10px;flex-wrap:wrap}
.info-item a{color:var(--green);text-decoration:none;font-weight:bold;cursor:pointer}
.full-width{grid-column:1 / -1}
.section-title{font-size:18px;margin:25px 0 15px 0;color:var(--text);display:flex;align-items:center;gap:10px}
.list-item{background:var(--card);border:1px solid var(--border);padding:15px;border-radius:8px;margin-bottom:10px;display:flex;justify-content:space-between;align-items:center;cursor:pointer;transition:0.2s}
.list-item:hover{border-color:var(--green);background:#273549;transform:translateX(3px)}
.list-item.name{font-weight:600}.list-item.meta{font-size:13px;color:var(--muted);margin-top:4px}
.pagination{display:flex;gap:10px;justify-content:center;margin-top:20px;flex-wrap:wrap}
.pagination a{padding:8px 15px;background:var(--card);border:1px solid var(--border);border-radius:6px;color:var(--text);text-decoration:none;cursor:pointer}
.pagination a.active{background:var(--green);border-color:var(--green)}
.not-found,.error{text-align:center;padding:40px;color:var(--muted);background:var(--card);border-radius:12px}
.error{color:#f87171}
.modal{display:none;position:fixed;z-index:1000;left:0;top:0;width:100%;height:100%;background:rgba(0,0,0,0.8);align-items:center;justify-content:center;backdrop-filter:blur(4px)}
#customerModal{z-index:1001}
.modal-content{background:var(--card);border:1px solid var(--border);border-radius:12px;width:90%;max-width:700px;max-height:90vh;overflow-y:auto;animation:slideUp 0.3s}
.modal-content.large{max-width:1000px}
@keyframes slideUp{from{transform:translateY(30px);opacity:0}to{transform:translateY(0);opacity:1}}
.modal-header{padding:20px;border-bottom:1px solid var(--border);display:flex;justify-content:space-between;align-items:center;position:sticky;top:0;background:var(--card);z-index:10;gap:15px}
.modal-header h2{margin:0;font-size:20px;flex:1}
.modal-controls{display:flex;gap:10px;align-items:center;white-space:nowrap}
.modal-controls button{background:var(--border);border:none;color:var(--text);padding:8px 12px;border-radius:6px;cursor:pointer;font-size:16px}
.modal-controls button:hover{background:var(--green)}
.modal-controls button:disabled{opacity:0.3;cursor:not-allowed}
.close-btn{font-size:28px;cursor:pointer;color:var(--muted);line-height:1}
.modal-body{padding:20px}
.modal-body.grid{display:grid;grid-template-columns:1fr 1fr;gap:20px}
.btn-wa{display:inline-flex;align-items:center;gap:6px;padding:6px 12px;background:#25D366;color:#fff;border-radius:6px;text-decoration:none;font-weight:600;font-size:14px}
.btn-wa:hover{background:#1da851}
.btn-edit,.btn-delete{padding:8px 14px;border:none;border-radius:6px;color:#fff;cursor:pointer;font-weight:500;font-size:14px}
.btn-edit{background:var(--blue)}.btn-edit:hover{background:#2563eb}
.btn-delete{background:var(--red)}.btn-delete:hover{background:#dc2626}
.hidden{display:none}
@media (max-width:600px){
.card-body,.modal-body.grid,.stats{grid-template-columns:1fr}
.search-box{flex-direction:column}
.chart-wrapper{height:250px}
.modal-controls{font-size:14px}
}

/* YENİ: LIGHTBOX SLIDER CSS */
#lightboxModal{z-index:2000}
.lightbox-content{position:relative;width:95%;height:95%;max-width:1200px;display:flex;align-items:center;justify-content:center}
.lightbox-image{max-width:100%;max-height:100%;object-fit:contain;border-radius:8px;user-select:none}
.lightbox-close{position:absolute;top:15px;right:15px;font-size:35px;color:#fff;background:rgba(0,0,0,0.5);border:none;border-radius:50%;width:45px;height:45px;cursor:pointer;display:flex;align-items:center;justify-content:center;z-index:2001}
.lightbox-close:hover{background:rgba(239,68,68,0.8)}
.lightbox-nav{position:absolute;top:50%;transform:translateY(-50%);font-size:30px;color:#fff;background:rgba(0,0,0,0.5);border:none;border-radius:50%;width:50px;height:50px;cursor:pointer;display:flex;align-items:center;justify-content:center;z-index:2001}
.lightbox-nav:hover{background:rgba(16,185,129,0.8)}
.lightbox-prev{left:15px}
.lightbox-next{right:15px}
.lightbox-counter{position:absolute;bottom:15px;left:50%;transform:translateX(-50%);color:#fff;background:rgba(0,0,0,0.6);padding:6px 14px;border-radius:20px;font-size:14px}
.lightbox-download{position:absolute;top:15px;left:15px;color:#fff;background:rgba(0,0,0,0.5);border:none;border-radius:6px;padding:10px 15px;cursor:pointer;font-size:14px;text-decoration:none;display:flex;align-items:center;gap:6px}
.lightbox-download:hover{background:rgba(16,185,129,0.8)}
.btn-image{display:inline-flex;align-items:center;gap:6px;padding:6px 12px;background:var(--blue);color:#fff;border-radius:6px;text-decoration:none;font-weight:600;font-size:14px;cursor:pointer;border:none}
.btn-image:hover{background:#2563eb}
</style></head><body>

<div class="header">
  <div class="logo">
    <h1><i class="fa-solid fa-database"></i> Müştəri Axtarış Sistemi</h1>
  </div>
  <div class="actions">
    <a href="/add"><i class="fa-solid fa-plus"></i><span>Əlavə Et</span></a>
    <a href="/logout" class="btn-logout"><i class="fa-solid fa-right-from-bracket"></i><span>Çıxış</span></a>
  </div>
</div>

<div class="container">
  <div class="search-section">
    <form class="search-box" method="GET">
      <input type="text" name="q" value="<%= q || '' %>" placeholder="Ödəniş kodu, Telefon, Ad və ya Ünvan...">
      <button type="submit"><i class="fa-solid fa-magnifying-glass"></i> Axtar</button>
    </form>

    <form class="date-filter" method="GET">
      <input type="hidden" name="q" value="<%= q || '' %>">
      <label><i class="fa-solid fa-calendar"></i> Tarix:</label>
      <input type="date" name="startDate" value="<%= startDate || '' %>">
      <input type="date" name="endDate" value="<%= endDate || '' %>">
      <div class="filter-actions">
        <button type="submit" class="btn-filter"><i class="fa-solid fa-filter"></i> Filter</button>
        <% if (q || startDate || endDate) { %>
          <a href="/" class="btn-clear"><i class="fa-solid fa-xmark"></i> Təmizlə</a>
        <% } %>
      </div>
    </form>
  </div>

  <% if (errorMsg) { %>
    <div class="error"><p><i class="fa-solid fa-triangle-exclamation"></i> <%= errorMsg %></p></div>

  <% } else if (q || startDate || endDate) { %>
    <% if (results.length > 0) { %>
      <div class="search-info">
        <% if (q) { %>Axtarış: "<%= q %>" - <% } %>
        <% if (startDate || endDate) { %>Tarix: <%= startDate || '...' %> - <%= endDate || '...' %> - <% } %>
        <%= totalResults %> nəticə tapıldı
      </div>

      <% if (results.length === 1) { %>
        <% const result = results[0]; %>
        <div class="card">
          <div class="card-header">
            <h2><%= result['Ad, Soyad, Ata adı'] || 'Adsız müştəri' %></h2>
            <span>Ödəniş kodu: <%= result['Ödəniş kodu'] %> | Qeydiyyat: <%= result['Timestamp'] %></span>
            <div style="margin-top:15px;display:flex;gap:10px">
              <a href="/edit/<%= result['Ödəniş kodu'] %>" class="btn-edit"><i class="fa-solid fa-pen"></i> Redaktə</a>
              <button class="btn-delete" onclick="deleteCustomer('<%= result['Ödəniş kodu'] %>', <%= result.rowIndex %>)"><i class="fa-solid fa-trash"></i> Sil</button>
            </div>
          </div>
          <div class="card-body">
            <%- include('card-content', {result: result}) %>
          </div>
        </div>
      <% } else { %>
        <div class="result-list" id="searchResults">
          <% results.forEach((item, index) => { %>
            <div class="list-item" onclick="openModal('<%= item['Ödəniş kodu'] %>', <%= index %>, 'search')">
              <div>
                <div class="name"><%= item['Ad, Soyad, Ata adı'] %></div>
                <div class="meta">Kod: <%= item['Ödəniş kodu'] %> | Tel: <%= item['Telefon nömrəsi'] %> | <%= item['Ünvan'] %></div>
              </div>
              <i class="fa-solid fa-chevron-right" style="color:var(--muted)"></i>
            </div>
          <% }) %>
        </div>
        <% if (totalPages > 1) { %>
          <div class="pagination">
            <% if (currentPage > 1) { %><a href="/?q=<%= q %>&startDate=<%= startDate %>&endDate=<%= endDate %>&page=<%= currentPage - 1 %>">Əvvəlki</a><% } %>
            <span style="padding:8px 15px">Səhifə <%= currentPage %> / <%= totalPages %></span>
            <% if (currentPage < totalPages) { %><a href="/?q=<%= q %>&startDate=<%= startDate %>&endDate=<%= endDate %>&page=<%= currentPage + 1 %>">Növbəti</a><% } %>
          </div>
        <% } %>
      <% } %>
    <% } else { %>
      <div class="not-found"><p><i class="fa-solid fa-circle-xmark"></i> Nəticə tapılmadı</p></div>
    <% } %>

  <% } else { %>
    <div class="stats">
      <div class="stat-card purple" onclick="openAllCustomersModal()">
        <h3>Ümumi Müştəri Sayı</h3>
        <p><%= totalCount %></p>
        <span style="font-size:12px;color:var(--muted)">Kliklə hamısına bax</span>
      </div>
      <div class="stat-card green" onclick="showTodayList()">
        <h3>Bu gün əlavə olunanlar</h3>
        <p><%= todayCustomers.length %></p>
        <span style="font-size:12px;color:var(--muted)">Kliklə siyahıya bax</span>
      </div>
    </div>

    <div class="chart-container">
      <button class="btn-expand" onclick="openChartModal()"><i class="fa-solid fa-expand"></i> Böyüt</button>
      <h3 class="section-title" style="margin-top:0"><i class="fa-solid fa-chart-line"></i> Aylıq Qoşulma Statistikası</h3>
      <div class="chart-wrapper">
        <canvas id="monthlyChart"></canvas>
      </div>
      <div class="chart-buttons">
        <button class="chart-btn active" data-type="total" onclick="updateChart('total')">Ümumi</button>
        <button class="chart-btn green" data-type="qosulma" onclick="updateChart('qosulma')">Qoşulma</button>
        <button class="chart-btn orange" data-type="kocurme" onclick="updateChart('kocurme')">Köçürmə</button>
      </div>
    </div>

    <div id="todayList" class="hidden">
      <h3 class="section-title"><i class="fa-solid fa-calendar-day"></i> Bu gün əlavə olunanlar - <%= todayCustomers.length %> nəfər</h3>
      <% todayCustomers.forEach((item, index) => { %>
        <div class="list-item" onclick="openModal('<%= item['Ödəniş kodu'] %>', <%= index %>, 'today')">
          <div>
            <div class="name"><%= item['Ad, Soyad, Ata adı'] %></div>
            <div class="meta">Kod: <%= item['Ödəniş kodu'] %> | Tel: <%= item['Telefon nömrəsi'] %></div>
          </div>
          <i class="fa-solid fa-chevron-right" style="color:var(--muted)"></i>
        </div>
      <% }) %>
    </div>
  <% } %>
</div>

<div id="customerModal" class="modal">
  <div class="modal-content">
    <div class="modal-header">
      <h2 id="modalTitle"></h2>
      <div class="modal-controls">
        <button onclick="navigateModal(-1)" id="prevBtn"><i class="fa-solid fa-chevron-left"></i></button>
        <span id="modalCounter" style="color:var(--muted);font-size:14px"></span>
        <button onclick="navigateModal(1)" id="nextBtn"><i class="fa-solid fa-chevron-right"></i></button>
        <span class="close-btn" onclick="closeModal('customerModal')">&times;</span>
      </div>
    </div>
    <div class="modal-body grid" id="modalBody"></div>
  </div>
</div>

<div id="chartModal" class="modal">
  <div class="modal-content large">
    <div class="modal-header">
      <h2>Aylıq Qoşulma Statistikası</h2>
      <span class="close-btn" onclick="closeModal('chartModal')">&times;</span>
    </div>
    <div class="modal-body">
      <div style="height:500px">
        <canvas id="modalChart"></canvas>
      </div>
      <div class="chart-buttons">
        <button class="chart-btn active" data-type="total" onclick="updateModalChart('total')">Ümumi</button>
        <button class="chart-btn green" data-type="qosulma" onclick="updateModalChart('qosulma')">Qoşulma</button>
        <button class="chart-btn orange" data-type="kocurme" onclick="updateModalChart('kocurme')">Köçürmə</button>
      </div>
    </div>
  </div>
</div>

<div id="allCustomersModal" class="modal">
  <div class="modal-content">
    <div class="modal-header">
      <h2>Bütün Müştərilər</h2>
      <span class="close-btn" onclick="closeModal('allCustomersModal')">&times;</span>
    </div>
    <div class="modal-body" id="allCustomersBody">
      <p style="text-align:center;padding:40px"><i class="fa-solid fa-spinner fa-spin"></i> Yüklənir...</p>
    </div>
  </div>
</div>

<!-- YENİ: LIGHTBOX MODAL -->
<div id="lightboxModal" class="modal">
  <div class="lightbox-content">
    <button class="lightbox-close" onclick="closeLightbox()">&times;</button>
    <a class="lightbox-download" id="lightboxDownload" href="" download target="_blank"><i class="fa-solid fa-download"></i> Yüklə</a>
    <button class="lightbox-nav lightbox-prev" onclick="navigateLightbox(-1)"><i class="fa-solid fa-chevron-left"></i></button>
    <img class="lightbox-image" id="lightboxImage" src="">
    <button class="lightbox-nav lightbox-next" onclick="navigateLightbox(1)"><i class="fa-solid fa-chevron-right"></i></button>
    <span class="lightbox-counter" id="lightboxCounter"></span>
  </div>
</div>

<script>
let currentModalIndex = 0;
let currentModalList = [];
let currentModalType = '';
let mainChart, modalChartInstance;
let allCustomersPage = 1;

// YENİ: LIGHTBOX DƏYİŞƏNLƏRİ
let lightboxImages = [];
let currentLightboxIndex = 0;

const chartData = <%- JSON.stringify(monthlyStats) %>;

function showTodayList() {
  document.getElementById('todayList').classList.toggle('hidden');
}

async function openAllCustomersModal() {
  document.getElementById('allCustomersModal').style.display = 'flex';
  await loadAllCustomers(1);
}

async function loadAllCustomers(page) {
  allCustomersPage = page;
  const body = document.getElementById('allCustomersBody');
  body.innerHTML = '<p style="text-align:center;padding:40px"><i class="fa-solid fa-spinner fa-spin"></i> Yüklənir...</p>';
  const res = await fetch(`/api/all-customers?page=${page}`);
  const json = await res.json();
  if (json.success) {
    currentModalList = json.customers.map(c => c['Ödəniş kodu']);
    let html = '';
    json.customers.forEach((item, index) => {
      html += `<div class="list-item" onclick="openModal('${item['Ödəniş kodu']}', ${index}, 'all')">
        <div>
          <div class="name">${item['Ad, Soyad, Ata adı']}</div>
          <div class="meta">Kod: ${item['Ödəniş kodu']} | Tel: ${item['Telefon nömrəsi']}</div>
        </div>
        <i class="fa-solid fa-chevron-right" style="color:var(--muted)"></i>
      </div>`;
    });
    html += '<div class="pagination">';
    if (page > 1) html += `<a onclick="loadAllCustomers(${page - 1})">Əvvəlki</a>`;
    html += `<span style="padding:8px 15px">Səhifə ${page} / ${json.totalPages}</span>`;
    if (page < json.totalPages) html += `<a onclick="loadAllCustomers(${page + 1})">Növbəti</a>`;
    html += '</div>';
    body.innerHTML = html;
  }
}

function openModal(odemeKodu, index, type = 'search') {
  currentModalType = type;
  if (type === 'search') {
    currentModalList = <%- JSON.stringify(results.map(r => r['Ödəniş kodu'])) %>;
  } else if (type === 'today') {
    currentModalList = <%- JSON.stringify(todayCustomers.map(r => r['Ödəniş kodu'])) %>;
  }
  currentModalIndex = currentModalList.indexOf(odemeKodu);
  loadModalCustomer(odemeKodu);
}

async function loadModalCustomer(odemeKodu) {
  const modal = document.getElementById('customerModal');
  const modalBody = document.getElementById('modalBody');
  const modalTitle = document.getElementById('modalTitle');
  const counter = document.getElementById('modalCounter');
  const prevBtn = document.getElementById('prevBtn');
  const nextBtn = document.getElementById('nextBtn');

  modalBody.innerHTML = '<p style="text-align:center;padding:40px"><i class="fa-solid fa-spinner fa-spin"></i> Yüklənir...</p>';
  modal.style.display = 'flex';

  counter.textContent = `${currentModalIndex + 1} / ${currentModalList.length}`;
  prevBtn.disabled = currentModalIndex === 0;
  nextBtn.disabled = currentModalIndex === currentModalList.length - 1;

  const res = await fetch(`/customer/${odemeKodu}`);
  const json = await res.json();

  if (json.success) {
    const r = json.data;
    modalTitle.innerHTML = `${r['Ad, Soyad, Ata adı'] || 'Adsız'}`;
    const fields = [
      { key: 'Ödəniş kodu', label: 'Ödəniş Kodu' },
      { key: 'Telefon nömrəsi', label: 'Telefon', type: 'tel' },
      { key: 'Aylıq ödəniş', label: 'Aylıq Ödəniş', suffix: ' AZN' },
      { key: 'Ş/V FİN', label: 'Ş/V FİN' },
      { key: 'Ş/V Seriya', label: 'Ş/V Seriya' },
      { key: 'Modem S/N', label: 'Modem S/N' },
      { key: 'Tv Box', label: 'TV Box' },
      { key: 'Komendant', label: 'Komendant' },
      { key: 'Şifrə:', label: 'Şifrə' },
      { key: 'Timestamp', label: 'Qeydiyyat tarixi' },
      { key: 'Ünvan', label: 'Ünvan', full: true },
      { key: 'Qeyd', label: 'Qeyd', full: true },
      { key: 'Müqavilə və Modemin şəkli', label: 'Müqavilə Şəkli', type: 'image', full: true }
    ];
    let html = '';
    fields.forEach(f => {
      const val = r[f.key];
      if (val && val.toString().trim()!== '' && val.toString().toLowerCase()!== 'yox') {
        html += `<div class="info-item ${f.full? 'full-width' : ''}">
          <label>${f.label}</label><p>`;
        if (f.type === 'tel') {
          const cleanTel = val.toString().replace(/\s/g, '');
          const waTel = '994' + cleanTel.replace(/^0/, '');
          html += `<a href="tel:${cleanTel}">${val}</a>
                   <a href="https://wa.me/${waTel}" target="_blank" class="btn-wa">
                     <i class="fa-brands fa-whatsapp"></i> WhatsApp
                   </a>`;
        } else if (f.type === 'image') {
          const links = val.split(',').map(l => l.trim()).filter(l => l);
          html += links.map((l,i) => `<button class="btn-image" onclick='openLightbox(${JSON.stringify(links)}, ${i})'><i class="fa-solid fa-image"></i> Şəkil ${i+1}</button>`).join(' ');
        } else html += `${val}${f.suffix || ''}`;
        html += `</p></div>`;
      }
    });
    html += `<div class="info-item full-width" style="display:flex;gap:10px;margin-top:10px">
      <a href="/edit/${r['Ödəniş kodu']}" class="btn-edit"><i class="fa-solid fa-pen"></i> Redaktə</a>
      <button class="btn-delete" onclick="deleteCustomer('${r['Ödəniş kodu']}', ${r.rowIndex})"><i class="fa-solid fa-trash"></i> Sil</button>
    </div>`;
    modalBody.innerHTML = html;
  } else {
    modalBody.innerHTML = '<p>Məlumat tapılmadı.</p>';
  }
}

function navigateModal(direction) {
  const newIndex = currentModalIndex + direction;
  if (newIndex >= 0 && newIndex < currentModalList.length) {
    currentModalIndex = newIndex;
    loadModalCustomer(currentModalList[currentModalIndex]);
  }
}

function closeModal(id) {
  document.getElementById(id).style.display = 'none';
}

function openChartModal() {
  document.getElementById('chartModal').style.display = 'flex';
  if (!modalChartInstance) initModalChart();
}

async function deleteCustomer(odemeKodu, rowIndex) {
  if (!confirm(`"${odemeKodu}" ödəniş kodlu müştərini silmək istəyirsiniz?`)) return;
  const res = await fetch(`/delete/${odemeKodu}`, {
    method: 'POST',
    headers: {'Content-Type': 'application/json'},
    body: JSON.stringify({rowIndex})
  });
  const json = await res.json();
  if (json.success) {
    alert('Müştəri silindi');
    location.reload();
  } else {
    alert('Xəta: ' + json.error);
  }
}

// YENİ: LIGHTBOX FUNKSİYALARI
function openLightbox(images, startIndex = 0) {
  lightboxImages = images;
  currentLightboxIndex = startIndex;
  updateLightboxImage();
  document.getElementById('lightboxModal').style.display = 'flex';
  document.body.style.overflow = 'hidden';
}

function closeLightbox() {
  document.getElementById('lightboxModal').style.display = 'none';
  document.body.style.overflow = 'auto';
}

function navigateLightbox(direction) {
  currentLightboxIndex += direction;
  if (currentLightboxIndex < 0) currentLightboxIndex = lightboxImages.length - 1;
  if (currentLightboxIndex >= lightboxImages.length) currentLightboxIndex = 0;
  updateLightboxImage();
}

function updateLightboxImage() {
  const img = document.getElementById('lightboxImage');
  const counter = document.getElementById('lightboxCounter');
  const download = document.getElementById('lightboxDownload');
  const url = lightboxImages[currentLightboxIndex];
  img.src = url;
  download.href = url;
  counter.textContent = `${currentLightboxIndex + 1} / ${lightboxImages.length}`;
  
  const prevBtn = document.querySelector('.lightbox-prev');
  const nextBtn = document.querySelector('.lightbox-next');
  if (lightboxImages.length <= 1) {
    prevBtn.style.display = 'none';
    nextBtn.style.display = 'none';
  } else {
    prevBtn.style.display = 'flex';
    nextBtn.style.display = 'flex';
  }
}

document.addEventListener('keydown', (e) => {
  if (document.getElementById('customerModal').style.display === 'flex') {
    if (e.key === 'Escape') closeModal('customerModal');
    if (e.key === 'ArrowLeft') navigateModal(-1);
    if (e.key === 'ArrowRight') navigateModal(1);
  }
  if (document.getElementById('lightboxModal').style.display === 'flex') {
    if (e.key === 'Escape') closeLightbox();
    if (e.key === 'ArrowLeft') navigateLightbox(-1);
    if (e.key === 'ArrowRight') navigateLightbox(1);
  }
  if (e.key === 'Escape') {
    closeModal('chartModal');
    closeModal('allCustomersModal');
  }
});

window.onclick = function(e) {
  if (e.target.classList.contains('modal')) {
    if (e.target.id === 'lightboxModal') closeLightbox();
    else e.target.style.display = 'none';
  }
}

// Touch swipe for lightbox
let touchStartX = 0;
document.getElementById('lightboxModal').addEventListener('touchstart', (e) => {
  touchStartX = e.touches[0].clientX;
});
document.getElementById('lightboxModal').addEventListener('touchend', (e) => {
  const touchEndX = e.changedTouches[0].clientX;
  const diff = touchStartX - touchEndX;
  if (Math.abs(diff) > 50) {
    if (diff > 0) navigateLightbox(1);
    else navigateLightbox(-1);
  }
});

