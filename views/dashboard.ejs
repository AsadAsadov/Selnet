<!DOCTYPE html>
<html lang="az">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
  <meta name="theme-color" content="#061126">
  <title>İdarə paneli — Selnet</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
  <link rel="stylesheet" href="/css/dashboard-v1.css">
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
</head>
<body>
<%
  const archiveValue = (value) => {
    if (typeof value === 'boolean') return value;
    return ['hə','he','true','1','bəli','yes'].includes(String(value || '').trim().toLowerCase());
  };
  const rowType = (item) => {
    if (archiveValue(item && item.arxiv)) return { label: 'Arxivdə', css: 'archive', icon: 'fa-box-archive' };
    const note = String((item && item.qeyd) || '').toLowerCase();
    if (note.includes('problem')) return { label: 'Problem', css: 'problem', icon: 'fa-triangle-exclamation' };
    if (note.includes('köç') || note.includes('koc')) return { label: 'Köçürmə', css: 'move', icon: 'fa-truck-moving' };
    return { label: 'Qoşulma', css: 'join', icon: 'fa-plug' };
  };
  const hasFilters = Boolean(q || startDate || endDate || status);
%>

<div class="app-shell">
  <aside class="sidebar" id="sidebar" aria-label="Əsas menyu">
    <a class="sidebar-brand" href="/" aria-label="Selnet ana səhifə">
      <img src="https://raw.githubusercontent.com/AsadAsadov/Selnet/main/selnet.png" alt="Selnet">
    </a>

    <span class="sidebar-section-label">İdarəetmə</span>
    <nav class="sidebar-nav">
      <a class="nav-item active" href="/"><i class="fa-solid fa-table-columns"></i><span>İdarə paneli</span></a>
      <button class="nav-item" type="button" data-list-type="all"><i class="fa-solid fa-users"></i><span>Müştərilər</span><span class="nav-badge"><%= totalCount %></span></button>
      <a class="nav-item" href="/add"><i class="fa-solid fa-user-plus"></i><span>Yeni əməliyyat</span></a>
      <button class="nav-item" type="button" data-list-type="problem"><i class="fa-solid fa-triangle-exclamation"></i><span>Problemlər</span><span class="nav-badge"><%= problemCount %></span></button>
      <button class="nav-item" type="button" data-list-type="archive"><i class="fa-solid fa-box-archive"></i><span>Arxiv</span><span class="nav-badge"><%= archivedCustomers.length %></span></button>
    </nav>

    <span class="sidebar-section-label">Alətlər</span>
    <nav class="sidebar-nav">
      <button class="nav-item" id="modemNavOpen" type="button"><i class="fa-solid fa-router"></i><span>Modem S/N axtarışı</span></button>
      <button class="nav-item" type="button" data-list-type="today"><i class="fa-solid fa-calendar-day"></i><span>Bugünkü qeydlər</span></button>
    </nav>

    <div class="sidebar-footer">
      <div class="admin-mini">
        <span class="admin-avatar">AD</span>
        <span><strong>Administrator</strong><span>Selnet daxili sistem</span></span>
      </div>
      <a class="nav-item danger" href="/logout"><i class="fa-solid fa-right-from-bracket"></i><span>Çıxış et</span></a>
    </div>
  </aside>

  <div class="sidebar-backdrop" id="sidebarBackdrop"></div>

  <section class="app-main">
    <header class="topbar">
      <button class="mobile-menu" id="mobileMenu" type="button" aria-label="Menyunu aç"><i class="fa-solid fa-bars"></i></button>
      <div class="topbar-title">
        <h1>Müştəri idarəetməsi</h1>
        <p>Selnet əməliyyat və məlumat paneli</p>
      </div>

      <form class="topbar-search" method="GET" action="/">
        <i class="fa-solid fa-magnifying-glass"></i>
        <input name="q" value="<%= q %>" type="search" autocomplete="off" placeholder="Ad, telefon və ya ödəniş kodu ilə axtar..." aria-label="Müştəri axtarışı">
      </form>

      <div class="topbar-actions">
        <button class="icon-btn" id="modemSearchOpen" type="button" title="Modem S/N axtarışı" aria-label="Modem S/N axtarışı"><i class="fa-solid fa-router"></i></button>
        <a class="primary-btn" href="/add"><i class="fa-solid fa-plus"></i><span>Yeni əməliyyat</span></a>
      </div>
    </header>

    <main class="content">
      <section class="page-head">
        <div>
          <h2>İdarə paneli</h2>
          <p>Müştəri bazası, problemlər və aylıq əməliyyatlar üzrə ümumi vəziyyət.</p>
        </div>
        <div class="page-head-actions">
          <button class="secondary-btn" type="button" data-list-type="today"><i class="fa-regular fa-calendar"></i> Bu gün</button>
          <button class="secondary-btn" type="button" data-list-type="problem"><i class="fa-solid fa-triangle-exclamation"></i> Problemlər</button>
        </div>
      </section>

      <% if (errorMsg) { %>
        <div class="alert" role="alert"><i class="fa-solid fa-circle-exclamation"></i> <%= errorMsg %></div>
      <% } %>

      <section class="stats-grid" aria-label="Statistika">
        <button class="stat-card blue" type="button" data-list-type="all">
          <span class="stat-top"><span class="stat-icon"><i class="fa-solid fa-users"></i></span><i class="fa-solid fa-arrow-up-right-from-square stat-arrow"></i></span>
          <span class="stat-label">Ümumi aktiv müştəri</span>
          <strong class="stat-value"><%= totalCount %></strong>
        </button>
        <button class="stat-card green" type="button" data-list-type="today">
          <span class="stat-top"><span class="stat-icon"><i class="fa-solid fa-calendar-day"></i></span><i class="fa-solid fa-arrow-up-right-from-square stat-arrow"></i></span>
          <span class="stat-label">Bu gün əlavə edilən</span>
          <strong class="stat-value"><%= todayCustomers.length %></strong>
        </button>
        <button class="stat-card gray" type="button" data-list-type="archive">
          <span class="stat-top"><span class="stat-icon"><i class="fa-solid fa-box-archive"></i></span><i class="fa-solid fa-arrow-up-right-from-square stat-arrow"></i></span>
          <span class="stat-label">Arxivdə olan</span>
          <strong class="stat-value"><%= archivedCustomers.length %></strong>
        </button>
        <button class="stat-card red" type="button" data-list-type="problem">
          <span class="stat-top"><span class="stat-icon"><i class="fa-solid fa-triangle-exclamation"></i></span><i class="fa-solid fa-arrow-up-right-from-square stat-arrow"></i></span>
          <span class="stat-label">Problem qeydli</span>
          <strong class="stat-value"><%= problemCount %></strong>
        </button>
      </section>

      <section class="panel filter-panel">
        <div class="panel-body">
          <form class="filter-form" method="GET" action="/">
            <div class="field-wrap">
              <i class="fa-solid fa-magnifying-glass"></i>
              <input name="q" value="<%= q %>" type="search" autocomplete="off" placeholder="Ad, telefon və ya ödəniş kodu">
            </div>
            <input name="startDate" value="<%= startDate %>" type="date" aria-label="Başlanğıc tarixi">
            <input name="endDate" value="<%= endDate %>" type="date" aria-label="Son tarix">
            <div class="filter-actions">
              <button class="primary-btn" type="submit"><i class="fa-solid fa-filter"></i> Tətbiq et</button>
              <% if (hasFilters) { %><a class="secondary-btn" href="/"><i class="fa-solid fa-xmark"></i> Təmizlə</a><% } %>
            </div>
          </form>
        </div>
      </section>

      <section class="dashboard-grid">
        <article class="panel">
          <header class="panel-head">
            <div class="panel-title">
              <span class="panel-title-icon"><i class="fa-solid <%= hasFilters ? 'fa-magnifying-glass' : 'fa-clock-rotate-left' %>"></i></span>
              <span>
                <h3><%= hasFilters ? 'Axtarış nəticələri' : 'Son müştəri əməliyyatları' %></h3>
                <p><%= totalResults %> nəticə · səhifə <%= currentPage %> / <%= Math.max(totalPages, 1) %></p>
              </span>
            </div>
            <button class="secondary-btn" type="button" data-list-type="all"><i class="fa-solid fa-list"></i> Hamısı</button>
          </header>

          <% if (results && results.length) { %>
            <div class="customer-list">
              <% results.forEach((item) => { const kind = rowType(item); %>
                <article class="customer-row <%= kind.css %>" data-customer-code="<%= item.odeme_kodu %>" tabindex="0" role="button" aria-label="<%= item.ad_soyad || 'Müştəri' %> məlumatını aç">
                  <div class="customer-main">
                    <div class="customer-name"><span class="status-dot"></span><strong><%= item.ad_soyad || 'Adsız müştəri' %></strong></div>
                    <div class="customer-sub">
                      <span><i class="fa-regular fa-calendar"></i><%= formatDate(item.timestamp) %></span>
                      <span><i class="fa-solid fa-phone"></i><%= item.telefon || '-' %></span>
                    </div>
                  </div>
                  <span class="customer-code"><i class="fa-solid fa-key"></i> <%= item.odeme_kodu || '-' %></span>
                  <span class="customer-address"><i class="fa-solid fa-location-dot"></i> <%= item.unvan || '-' %></span>
                  <span class="type-badge <%= kind.css %>"><i class="fa-solid <%= kind.icon %>"></i> <%= kind.label %></span>
                </article>
              <% }) %>
            </div>
          <% } else { %>
            <div class="empty-state"><i class="fa-solid fa-users-slash"></i><strong>Nəticə tapılmadı</strong><span>Axtarış şərtlərini dəyişib yenidən yoxlayın.</span></div>
          <% } %>

          <% if (totalPages > 1) { %>
            <nav class="pagination" aria-label="Səhifələmə">
              <% if (currentPage > 1) { %><a href="/?q=<%= encodeURIComponent(q) %>&startDate=<%= startDate %>&endDate=<%= endDate %><%= status ? '&status=' + encodeURIComponent(status) : '' %>&page=<%= currentPage - 1 %>"><i class="fa-solid fa-chevron-left"></i> Əvvəlki</a><% } %>
              <span><%= currentPage %> / <%= totalPages %></span>
              <% if (currentPage < totalPages) { %><a href="/?q=<%= encodeURIComponent(q) %>&startDate=<%= startDate %>&endDate=<%= endDate %><%= status ? '&status=' + encodeURIComponent(status) : '' %>&page=<%= currentPage + 1 %>">Növbəti <i class="fa-solid fa-chevron-right"></i></a><% } %>
            </nav>
          <% } %>
        </article>

        <aside class="side-column">
          <article class="panel">
            <header class="panel-head">
              <div class="panel-title"><span class="panel-title-icon"><i class="fa-solid fa-chart-line"></i></span><span><h3>Aylıq dinamika</h3><p>Əməliyyatların aylıq bölgüsü</p></span></div>
            </header>
            <div class="panel-body">
              <% if (monthlyStats && monthlyStats.labels && monthlyStats.labels.length) { %>
                <div class="chart-wrap"><canvas id="monthlyChart"></canvas></div>
                <div class="chart-switch">
                  <button class="active" type="button" data-chart-type="total">Ümumi</button>
                  <button type="button" data-chart-type="qosulma">Qoşulma</button>
                  <button type="button" data-chart-type="kocurme">Köçürmə</button>
                  <button type="button" data-chart-type="problem">Problem</button>
                </div>
              <% } else { %>
                <div class="empty-state"><i class="fa-regular fa-chart-bar"></i><strong>Statistika yoxdur</strong><span>Qrafik üçün aylıq məlumat tapılmadı.</span></div>
              <% } %>
            </div>
          </article>

          <article class="panel" style="margin-top:18px">
            <header class="panel-head">
              <div class="panel-title"><span class="panel-title-icon"><i class="fa-solid fa-bolt"></i></span><span><h3>Sürətli keçidlər</h3><p>Ən çox istifadə olunan bölmələr</p></span></div>
            </header>
            <div class="panel-body quick-list">
              <button class="quick-item" type="button" data-list-type="problem"><strong><i class="fa-solid fa-triangle-exclamation"></i> Problemli müştərilər</strong><span><%= problemCount %> problem qeydi mövcuddur</span></button>
              <button class="quick-item" type="button" id="modemSearchQuick"><strong><i class="fa-solid fa-router"></i> Modem S/N ilə tap</strong><span>Modem seriya nömrəsi üzrə canlı axtarış</span></button>
              <a class="quick-item" href="/add"><strong><i class="fa-solid fa-user-plus"></i> Yeni əməliyyat yarat</strong><span>Qoşulma, köçürmə və ya problem əlavə et</span></a>
            </div>
          </article>
        </aside>
      </section>
    </main>
  </section>
</div>

<div class="overlay" id="customerDrawerOverlay" aria-hidden="true">
  <aside class="drawer" role="dialog" aria-modal="true" aria-labelledby="customerDrawerTitle">
    <header class="drawer-head">
      <div class="drawer-title"><h2 id="customerDrawerTitle">Müştəri məlumatı</h2><p id="customerDrawerSubtitle">Məlumat yüklənir...</p></div>
      <button class="close-btn" id="customerDrawerClose" type="button" aria-label="Bağla"><i class="fa-solid fa-xmark"></i></button>
    </header>
    <div class="drawer-body" id="customerDrawerBody"></div>
    <footer class="drawer-actions" id="customerDrawerActions"></footer>
  </aside>
</div>

<div class="modal-wrap" id="customerListModal" aria-hidden="true">
  <section class="modal" role="dialog" aria-modal="true" aria-labelledby="customerListTitle">
    <header class="modal-head">
      <div><h2 id="customerListTitle">Bütün müştərilər</h2><p id="customerListSubtitle">Müştəri bazası</p></div>
      <button class="close-btn" type="button" data-close-modal="customerListModal" aria-label="Bağla"><i class="fa-solid fa-xmark"></i></button>
    </header>
    <div class="modal-body">
      <div class="modal-search"><i class="fa-solid fa-magnifying-glass"></i><input id="customerListSearch" type="search" autocomplete="off" placeholder="Açılmış siyahıda axtar..."></div>
      <div class="modal-list" id="customerList"></div>
    </div>
    <footer class="modal-foot"><button id="listPrev" type="button"><i class="fa-solid fa-chevron-left"></i> Əvvəlki</button><span id="customerListCounter"></span><button id="listNext" type="button">Növbəti <i class="fa-solid fa-chevron-right"></i></button></footer>
  </section>
</div>

<div class="modal-wrap" id="historyModal" aria-hidden="true">
  <section class="modal small" role="dialog" aria-modal="true" aria-labelledby="historyTitle">
    <header class="modal-head"><div><h2 id="historyTitle">Fəaliyyət tarixçəsi</h2><p>Müştəri üzrə saxlanılmış dəyişikliklər</p></div><button class="close-btn" type="button" data-close-modal="historyModal" aria-label="Bağla"><i class="fa-solid fa-xmark"></i></button></header>
    <div class="modal-body"><div class="history-list" id="historyList"></div></div>
  </section>
</div>

<div class="modal-wrap" id="modemSearchModal" aria-hidden="true">
  <section class="modal small" role="dialog" aria-modal="true" aria-labelledby="modemSearchTitle">
    <header class="modal-head"><div><h2 id="modemSearchTitle">Modem S/N axtarışı</h2><p>Seriya nömrəsinin ən azı 2 simvolunu yazın</p></div><button class="close-btn" type="button" data-close-modal="modemSearchModal" aria-label="Bağla"><i class="fa-solid fa-xmark"></i></button></header>
    <div class="modal-body">
      <div class="modal-search"><i class="fa-solid fa-router"></i><input id="modemSearchInput" type="search" autocomplete="off" placeholder="Modem seriya nömrəsi..."></div>
      <div class="modal-list" id="modemSearchResults"><div class="empty-state"><i class="fa-solid fa-router"></i><strong>Modem S/N yazın</strong><span>Axtarış üçün ən azı 2 simvol daxil edin.</span></div></div>
    </div>
  </section>
</div>

<div class="toast" id="toast" role="status" aria-live="polite"></div>

<script>
  window.SELNET_DASHBOARD = { chartData: <%- JSON.stringify(monthlyStats || {}) %> };
</script>
<script src="/js/dashboard-v1.js"></script>
<script>
  document.getElementById('modemSearchQuick')?.addEventListener('click', function(){ document.getElementById('modemSearchOpen')?.click(); });
  document.querySelectorAll('.customer-row[tabindex]').forEach(function(row){ row.addEventListener('keydown', function(event){ if(event.key === 'Enter' || event.key === ' '){ event.preventDefault(); row.click(); } }); });
</script>
</body>
</html>
