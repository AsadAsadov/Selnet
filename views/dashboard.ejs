									function showCustomerListError(message) {
										const body = document.getElementById('customerListBody');
										if (!body) return;
										body.innerHTML = `<div class="not-found" style="margin:0"><p><i class="fa-solid fa-triangle-exclamation"></i> ${escapeHtml(message||'Müştərilər yüklənmədi.')}</p><button class="btn-edit" type="button" onclick="loadCustomerListPage(${Number(customerListState.page)||1})"><i class="fa-solid fa-rotate-right"></i> Yenidən cəhd et</button></div>`;
									}
									async function loadCustomerListPage(page = 1) {
										const cfg = customerListConfig[customerListState.type] || customerListConfig.all;
										const requestedPage = Number.parseInt(page, 10) || 1;
										const body = document.getElementById('customerListBody');
										if (!body) return;
										customerListState.page = requestedPage;
										updateCustomerListHeader();
										body.innerHTML = createLoadingSkeleton(5);
										if (customerListAbortController) customerListAbortController.abort();
										customerListAbortController = new AbortController();
										try {
											let payload;
											if (customerListState.type === 'search') {
												const customers = Array.isArray(embeddedSearchCustomers) ? embeddedSearchCustomers : [];
												payload = {
													customers,
													currentPage: 1,
													totalPages: 1,
													totalCustomers: customers.length
												};
											} else {
												const res = await fetch(`${cfg.endpoint}?page=${encodeURIComponent(requestedPage)}&limit=${encodeURIComponent(customerListState.limit)}`, {
													headers: {
														Accept: 'application/json'
													},
													credentials: 'same-origin',
													signal: customerListAbortController.signal
												});
												const contentType = res.headers.get('content-type') || '';
												if (!contentType.includes('application/json')) throw new Error(res.status === 401 ? 'Sessiya bitib. Zəhmət olmasa yenidən daxil olun.' : 'Server JSON formatında cavab qaytarmadı.');
												payload = await res.json();
												if (!res.ok || payload.success !== true) throw new Error(payload.error || `Server xətası (${res.status})`);
											}
											customerListState.customers = Array.isArray(payload.customers) ? payload.customers : (Array.isArray(payload.data) ? payload.data : []);
											customerListState.page = Math.max(1, Number.parseInt(payload.currentPage, 10) || 1);
											customerListState.totalPages = Math.max(1, Number.parseInt(payload.totalPages, 10) || 1);
											customerListState.totalCustomers = Number.parseInt(payload.totalCustomers, 10) || customerListState.customers.length;
											applyCustomerListFilter();
										} catch (error) {
											if (error.name === 'AbortError') return;
											console.error('[customer-list-modal] Müştərilər yüklənmədi:', error);
											showCustomerListError(error.message);
										}
									}

									function applyCustomerListFilter() {
										const query = customerListState.search;
										customerListState.filteredCustomers = customerListState.customers.filter(item => customerMatchesSearch(item, query));
										modalLists[customerListState.type] = customerListState.filteredCustomers.map(c => c && c['Ödəniş kodu']).filter(code => code !== undefined && code !== null && String(code).trim() !== '').map(String);
										renderCustomerListModal();
									}

									function renderCustomerListModal() {
										const body = document.getElementById('customerListBody');
										if (!body) return;
										updateCustomerListHeader();
										const customers = customerListState.filteredCustomers;
										const totalLabel = customerListState.search ? `${customers.length} uyğun nəticə` : `${customerListState.totalCustomers} müştəri`;
										if (customers.length === 0) {
											body.innerHTML = `<div class="customer-list-empty"><i class="fa-regular fa-folder-open"></i><p>${customerListState.search?'Axtarışa uyğun müştəri tapılmadı.':'Siyahıda müştəri yoxdur.'}</p></div>`;
											return;
										}
										const listHtml = `<div class="all-customers-toolbar"><span><i class="fa-solid fa-layer-group"></i> Səhifə ${customerListState.page} / ${customerListState.totalPages}</span><strong>${escapeHtml(totalLabel)}</strong></div><div class="compact-list">${customers.map((item,index)=>createCustomerListItem(item,index,customerListState.type)).join('')}</div>`;
										const paginationHtml = customerListState.type === 'search' ? '' : `<div class="pagination"><button type="button" ${customerListState.page<=1?'disabled':''} onclick="loadCustomerListPage(${customerListState.page-1})">Əvvəlki</button><span style="padding:8px 15px">Səhifə ${customerListState.page} / ${customerListState.totalPages}</span><button type="button" ${customerListState.page>=customerListState.totalPages?'disabled':''} onclick="loadCustomerListPage(${customerListState.page+1})">Növbəti</button></div>`;
										body.innerHTML = listHtml + paginationHtml;
									}
									const handleCustomerListSearch = debounce((event) => {
										customerListState.search = normalizeSearch(event.target.value);
										applyCustomerListFilter();
									}, 180);

									function openModal(odemeKodu, index, type = 'search') {
										currentModalType = type;
										currentModalList = Array.isArray(modalLists[type]) ? [...modalLists[type]] : [];
										if (!currentModalList.length && odemeKodu) currentModalList = [String(odemeKodu)];
										currentModalIndex = currentModalList.map(String).indexOf(String(odemeKodu));
										if (currentModalIndex < 0) currentModalIndex = Number.isInteger(index) ? index : 0;
										loadModalCustomer(odemeKodu);
									}
									async function loadModalCustomer(odemeKodu) {
										const modalBody = document.getElementById('modalBody');
										const modalTitle = document.getElementById('modalTitle');
										const counter = document.getElementById('modalCounter');
										const prevBtn = document.getElementById('prevBtn');
										const nextBtn = document.getElementById('nextBtn');
										if (!modalBody || !modalTitle) return;
										if (modalAbortController) modalAbortController.abort();
										modalAbortController = new AbortController();
										const requestId = ++modalRequestSeq;
										modalTitle.textContent = 'Müştəri məlumatı';
										modalBody.innerHTML = createSpinner('Məlumat yüklənir...');
										setModalOpen('customerModal', true);
										counter.textContent = currentModalList.length ? `${currentModalIndex+1} / ${currentModalList.length}` : '';
										prevBtn.disabled = currentModalIndex <= 0;
										nextBtn.disabled = currentModalIndex >= currentModalList.length - 1;
										try {
											const res = await fetch(`/customer/${encodeURIComponent(odemeKodu)}`, {
												headers: {
													Accept: 'application/json'
												},
												credentials: 'same-origin',
												signal: modalAbortController.signal
											});
											const contentType = res.headers.get('content-type') || '';
											if (!contentType.includes('application/json')) throw new Error(res.status === 401 ? 'Sessiya bitib. Zəhmət olmasa yenidən daxil olun.' : 'Server JSON formatında cavab qaytarmadı.');
											const json = await res.json();
											if (requestId !== modalRequestSeq) return;
											if (!res.ok || json.success !== true || !json.data) throw new Error(json.error || 'Məlumat tapılmadı.');
											const r = json.data;
											const isArchived = String(r['Arxiv'] || '').toLowerCase() === 'hə';
											modalTitle.innerHTML = `${escapeHtml(r['Ad, Soyad, Ata adı']||'Adsız')} ${isArchived?'<span class="badge archived" style="font-size:14px;vertical-align:middle"><i class="fa-solid fa-box-archive"></i> Arxivdə</span>':''}`;
											const fields = [{
												key: 'Ödəniş kodu',
												label: 'Ödəniş Kodu'
											}, {
												key: 'Telefon nömrəsi',
												label: 'Telefon',
												type: 'tel'
											}, {
												key: 'Aylıq ödəniş',
												label: 'Aylıq Ödəniş',
												suffix: ' AZN'
											}, {
												key: 'Ş/V FİN',
												label: 'Ş/V FİN'
											}, {
												key: 'Ş/V Seriya',
												label: 'Ş/V Seriya'
											}, {
												key: 'Modem S/N',
												label: 'Modem S/N'
											}, {
												key: 'Tv Box',
												label: 'TV Box'
											}, {
												key: 'Komendant',
												label: 'Komendant'
											}, {
												key: 'Timestamp',
												label: 'Qeydiyyat tarixi',
												type: 'date'
											}, {
												key: 'Ünvan',
												label: 'Ünvan',
												full: true
											}, {
												key: 'Qeyd',
												label: 'Qeyd',
												full: true
											}, {
												key: 'Müqavilə və Modemin şəkli',
												label: 'Müqavilə Şəkli',
												type: 'image',
												full: true
											}];
											let html = '';
											fields.forEach(f => {
												let val = r[f.key];
												if (f.type === 'date') val = formatDate(val);
												if (val && String(val).trim() !== '' && String(val).toLowerCase() !== 'yox') {
													const valueClass = f.type === 'tel' ? 'info-value info-value--contact' : (f.type === 'image' ? 'info-value info-value--links' : 'info-value');
													html += `<div class="info-item ${f.full?'full-width':''}"><label>${escapeHtml(f.label)}</label><p class="${valueClass}">`;
													if (f.type === 'tel') {
														const cleanTel = String(val).replace(/\s/g, '');
														const waTel = '994' + cleanTel.replace(/^0/, '');
														html += `<a href="tel:${encodeURIComponent(cleanTel)}" class="info-link">${escapeHtml(val)}</a><a href="https://wa.me/${encodeURIComponent(waTel)}" target="_blank" rel="noopener" class="btn-wa"><i class="fa-brands fa-whatsapp"></i> WhatsApp</a>`;
													} else if (f.type === 'image') {
														const links = String(val).split(',').map(l => l.trim()).filter(Boolean);
														html += links.map((l, i) => `<a class="btn-image drive-link" href="${escapeHtml(l)}" target="_blank" rel="noopener" title="${escapeHtml(l)}"><i class="fa-solid fa-image"></i> Şəkil ${i+1}</a>`).join('');
													} else {
														html += `<span class="info-text">${escapeHtml(val)}${f.suffix||''}</span>`;
													}
													html += '</p></div>';
												}
											});
											const codeArg = JSON.stringify(String(r['Ödəniş kodu'] || '')).replace(/'/g, '\u0027');
											html += `<div class="info-item full-width modal-actions"><a href="/edit/${encodeURIComponent(r['Ödəniş kodu'])}" class="btn-edit"><i class="fa-solid fa-pen"></i> Redaktə</a><button class="btn-delete" onclick='deleteCustomer(${codeArg}, ${Number(r.rowIndex)||0})'><i class="fa-solid fa-trash"></i> Sil</button>${isArchived?`<button class="btn-unarchive" onclick='toggleArchive(${codeArg}, ${Number(r.rowIndex)||0}, false)'><i class="fa-solid fa-box-open"></i> Arxivdən Çıxart</button>`:`<button class="btn-archive" onclick='toggleArchive(${codeArg}, ${Number(r.rowIndex)||0}, true)'><i class="fa-solid fa-box-archive"></i> Arxivə Göndər</button>`}</div>`;
											modalBody.innerHTML = html;
										} catch (error) {
											if (error.name === 'AbortError') return;
											console.error('[customer-modal] Müştəri yüklənmədi:', error);
											modalTitle.textContent = 'Xəta';
											modalBody.innerHTML = `<div class="not-found" style="margin:0"><p><i class="fa-solid fa-triangle-exclamation"></i> ${escapeHtml(error.message||'Məlumat yüklənmədi.')}</p></div>`;
										}
									}

									function navigateModal(direction) {
										const newIndex = currentModalIndex + direction;
										if (newIndex >= 0 && newIndex < currentModalList.length) {
											currentModalIndex = newIndex;
											loadModalCustomer(currentModalList[currentModalIndex]);
										}
									}

									async function postJson(url, body) {
										const res = await fetch(url, {
											method: 'POST',
											headers: {
												'Content-Type': 'application/json',
												Accept: 'application/json'
											},
											credentials: 'same-origin',
											body: JSON.stringify(body)
										});
										const contentType = res.headers.get('content-type') || '';
										if (!contentType.includes('application/json')) throw new Error('Server JSON formatında cavab qaytarmadı.');
										const json = await res.json();
										if (!res.ok || json.success !== true) throw new Error(json.error || `Server xətası (${res.status})`);
										return json;
									}
									async function deleteCustomer(odemeKodu, rowIndex) {
										if (!confirm(`"${odemeKodu}" ödəniş kodlu müştərini silmək istəyirsiniz?`)) return;
										try {
											await postJson(`/delete/${encodeURIComponent(odemeKodu)}`, {
												rowIndex
											});
											alert('Müştəri silindi');
											location.reload();
										} catch (error) {
											alert('Xəta: ' + error.message);
										}
									}
									async function toggleArchive(odemeKodu, rowIndex, archive) {
										const action = archive ? 'arxivə göndərmək' : 'arxivdən çıxartmaq';
										if (!confirm(`"${odemeKodu}" ödəniş kodlu müştərini ${action} istəyirsiniz?`)) return;
										try {
											await postJson(`/archive/${encodeURIComponent(odemeKodu)}`, {
												rowIndex,
												archive
											});
											alert(archive ? 'Müştəri arxivə göndərildi' : 'Müştəri arxivdən çıxarıldı');
											location.reload();
										} catch (error) {
											alert('Xəta: ' + error.message);
										}
									}

									document.addEventListener('click', (e) => {
										const item = e.target.closest('.list-item[data-code]');
										if (item) {
											openModal(item.dataset.code, Number.parseInt(item.dataset.index, 10) || 0, item.dataset.list || 'search');
											return;
										}
										if (e.target.classList.contains('modal')) closeModal(e.target.id);
									});
									document.addEventListener('keydown', (e) => {
										if (e.key === 'Enter' || e.key === ' ') {
											const item = e.target.closest?.('.list-item[data-code]');
											if (item) {
												e.preventDefault();
												openModal(item.dataset.code, Number.parseInt(item.dataset.index, 10) || 0, item.dataset.list || 'search');
												return;
											}
										}
										const customerOpen = document.getElementById('customerModal')?.classList.contains('is-open');
										if (customerOpen) {
											if (e.key === 'Escape') {
												closeModal('customerModal');
												return;
											}
											if (e.key === 'ArrowLeft') navigateModal(-1);
											if (e.key === 'ArrowRight') navigateModal(1);
										}
										if (e.key === 'Escape') {
											if (document.getElementById('chartModal')?.classList.contains('is-open')) {
												closeModal('chartModal');
												return;
											}
											if (document.getElementById('customerListModal')?.classList.contains('is-open')) closeModal('customerListModal');
										}
									});
									document.addEventListener('DOMContentLoaded', () => {
										setupChartToggle();
										document.getElementById('customerListSearch')?.addEventListener('input', handleCustomerListSearch);
									}); <
									/script>

									<
									/body></html >
