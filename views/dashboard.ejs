            /* Axtar düyməsini inputun yanına gətirmək */
            .search-button {
               padding: 0 15px !important;
               height: 42px !important;
               border-radius: 12px !important;
               width: auto !important;
               flex-shrink: 0;
            }

            /* Tarix bloklarını yan-yana və balaca etmək */
            .date-filters {
               display: flex !important;
               flex-direction: row !important;
               gap: 8px !important;
               width: 100%;
            }

            .date-filters input[type="date"] {
               flex: 1;
               font-size: 12px !important;
               padding: 8px !important;
               max-width: 49%;
            }

            /* Kartın içini 2 sütuna bölürük */
            .modal-body.grid {
               display: grid !important;
               grid-template-columns: repeat(2, 1fr) !important;
               gap: 12px !important;
               overflow-x: hidden !important;
               padding: 15px !important;
            }

            /* Ad, Soyad bölməsi yuxarıda tam en tutsun */
            .info-item.full-width,
            .name-section {
               grid-column: span 2 !important;
            }

            /* Yazıların qutudan çıxmaması üçün */
            .info-item {
               min-width: 0;
               word-break: break-word;
            }

            .info-item label {
               font-size: 11px !important;
               display: block;
            }

            .info-text {
               font-size: 13px !important;
            }
         }

         @media (max-width: 600px) {
            .modal {
               align-items: center;
               padding: 12px 10px;
               padding-top: max(12px, env(safe-area-inset-top));
               padding-bottom: max(12px, env(safe-area-inset-bottom));
            }
            .modal-content,
            .customer-detail-modal-content,
            .customer-list-modal-content {
               width: 95vw;
               max-height: calc(
                  100dvh -
                     max(
                        24px,
                        calc(
                           env(safe-area-inset-top) +
                              env(safe-area-inset-bottom) + 24px
                        )
                     )
               );
               border-radius: 18px;
            }
            .modal-header {
               padding: 13px 14px;
               align-items: flex-start;
            }
            .modal-header h2,
            .modal-customer-title {
               font-size: 17px;
            }
            .modal-controls {
               gap: 6px;
               flex-wrap: wrap;
               justify-content: flex-end;
            }
            .modal-controls button {
               min-width: 36px;
               min-height: 36px;
               padding: 7px 9px;
            }
            .close-btn {
               width: 38px;
               height: 38px;
               border-radius: 11px;
            }
            .modal-body {
               padding: 14px;
            }
            .customer-modal-search {
               margin: 12px 14px 0;
            }
            .customer-modal-search input {
               font-size: 16px;
            }
            .btn-wa,
            .btn-image,
            .btn-edit,
            .btn-delete,
            .btn-archive,
            .btn-unarchive {
               min-height: 38px;
            }
            .list-item {
               align-items: flex-start;
            }
            .list-top {
               align-items: flex-start;
               flex-direction: column;
            }
            .list-date {
               align-self: flex-start;
            }
            .chevron {
               margin-top: 4px;
            }
            .all-customers-toolbar {
               flex-direction: column;
               align-items: flex-start;
            }
            .chart-toggle-title {
               font-size: 16px;
            }
            .header h1 {
               font-size: 14px;
            }
            .header .actions a {
               padding: 7px 10px;
               font-size: 12px;
            }
            .header .actions a span {
               display: none;
            }
         }

         @media (max-width: 400px) {
            .date-filter {
               grid-template-columns: 1fr;
            }
            .chart-container.is-open .chart-panel {
               max-height: 620px;
            }
            .modal-content,
            .customer-detail-modal-content,
            .customer-list-modal-content {
               width: 96vw;
            }
            .modal-body {
               padding: 12px;
            }
            .modal-actions > *,
            .customer-card-actions > * {
               width: 100%;
               justify-content: center;
            }
            .modal-controls {
               width: 100%;
            }
         }

         @media (prefers-reduced-motion: reduce) {
            .modal-content {
               animation: none;
            }
            .modal-controls button,
            .modal-customer-nav-pill button,
            .close-btn {
               transition: none;
            }
         }

         /* Customer detail modal text must wrap only at normal word boundaries. */
         .modal-body,
         .modal-body *,
         .info-item,
         .info-value {
            min-width: 0;
         }

         .info-item:not(.customer-card-actions) {
            display: flex;
            flex-wrap: wrap;
         }
         .customer-details .info-grid > .info-item:not(.info-item--span-2) {
            display: flex !important;
            flex-direction: column !important;
            flex-wrap: nowrap !important;
            min-width: 0;
         }

         .info-item label,
         .info-value {
            max-width: 100%;
         }

         .info-value,
         .info-text,
         .modal-body.grid .info-item .info-value,
         .modal-body.grid .info-item .info-text {
            white-space: normal;
            word-break: normal;
            overflow-wrap: normal;
         }
      </style>
   </head>
   <body>
      <div class="header">
         <div class="logo">
            <h1>
               <i class="fa-solid fa-database"></i> Müştəri Axtarış Sistemi
            </h1>
         </div>
         <div class="actions">
            <a href="/add"
               ><i class="fa-solid fa-plus"></i><span>Əlavə Et</span></a
            >
            <a href="/logout" class="btn-logout"
               ><i class="fa-solid fa-right-from-bracket"></i
               ><span>Çıxış</span></a
            >
         </div>
      </div>

      <% const dateText = (item) => formatDate(item && item.timestamp); const
      getType = (item) => { const qeydText = (item && item.qeyd ||
      '').toLowerCase(); const isArchived = (item && item.arxiv ||
      '').toLowerCase() === 'hə'; const isProblem = !isArchived && qeydText.includes('problem'); const typeClass = isArchived ? 'archived-item'
      : (isProblem ? 'problem' : (qeydText.includes('köç') ? 'kocurme' : 'qosulma')); const badgeClass =
      isArchived ? 'archived' : (isProblem ? 'problem' : typeClass); const typeLabel = isArchived ?
      'Arxivdə' : (isProblem ? 'Problem' : (qeydText.includes('köç') ? 'Köçürmə' : 'Qoşulma')); const
      iconClass = isArchived ? 'fa-box-archive' : (isProblem ? 'fa-triangle-exclamation' : (typeClass === 'kocurme' ?
      'fa-truck-moving' : 'fa-plug')); return { typeClass, badgeClass, typeLabel,
      iconClass }; }; %>

      <div class="container">
         <div class="search-section">
            <button
               type="button"
               id="toggleSearchBtn"
               class="btn btn-secondary w-100 mb-3"
               aria-expanded="false"
               aria-controls="searchFormContainer"
            >
               🔍 Axtarış Panelini Aç/Bağla
            </button>
            <div id="searchFormContainer">
               <div class="search-filter-section">
                  <form class="search-box" method="GET">
                     <div class="brand-logo-container">
                        <img
                           src="https://raw.githubusercontent.com/AsadAsadov/Selnet/main/selnet.png"
                           alt="Selnet"
                           class="brand-logo"
                        />
                     </div>
                     <input type="hidden" name="status" value="<%= status || '' %>" />
                     <div class="search-wrapper">
                        <i class="fa-solid fa-magnifying-glass search-icon"></i>
                        <input
                           type="text"
                           name="q"
                           value="<%= q || '' %>"
                           placeholder="Ödəniş kodunu daxil edin"
                        />
                     </div>
                     <button type="submit">
                        <i class="fa-solid fa-magnifying-glass"></i> Axtar
                     </button>
                  </form>
                  <div class="modem-sn-live-wrap" id="modemSnLiveWrap">
                     <div class="modem-sn-inner">
                        <i class="fa-solid fa-barcode modem-sn-icon" aria-hidden="true"></i>
                        <input
                           type="search"
                           id="modemSnLiveSearch"
                           autocomplete="off"
                           enterkeyhint="search"
                           inputmode="search"
                           placeholder="S/N axtar"
                           aria-label="Modem seriya nömrəsi üzrə axtar"
                        />
                     </div>
                     <div id="modemSnLiveResults" class="modem-sn-dropdown" hidden></div>
                  </div>
                  <form class="date-filter" method="GET">
                     <input type="hidden" name="q" value="<%= q || '' %>" />
                     <input type="hidden" name="status" value="<%= status || '' %>" />
                     <input
                        type="date"
                        name="startDate"
                        value="<%= startDate || '' %>"
                     />
                     <input type="date" name="endDate" value="<%= endDate || '' %>" />
                     <div class="filter-actions">
                        <button type="submit" class="btn-filter">
                           <i class="fa-solid fa-filter"></i> Filter
                        </button>
                        <% if (q || startDate || endDate) { %><a
                           href="/"
                           class="btn-clear"
                           ><i class="fa-solid fa-xmark"></i> Təmizlə</a
                        ><% } %>
                     </div>
                  </form>
               </div>
            </div>
         </div>
         <% if (errorMsg) { %>
         <div class="error">
            <p>
               <i class="fa-solid fa-triangle-exclamation"></i> <%= errorMsg %>
            </p>
         </div>
         <% } else if (q || startDate || endDate) { %> <% if (results.length >
         0) { %>
         <div class="search-info">
            <% if (q) { %>Axtarış: "<%= q %>" - <% } %> <% if (startDate ||
            endDate) { %>Tarix: <%= startDate || '...' %> - <%= endDate || '...'
            %> - <% } %> <%= totalResults %> nəticə tapıldı
         </div>

         <% if (results.length === 1) { %> <% const result = results[0]; const
         isArchived = result.arxiv === true || ['hə', 'he', 'true', '1'].includes(String(result.arxiv ?? '').trim().toLowerCase()); %> <% if
         (isArchived) { %>
         <div class="archive-notice">
            <i class="fa-solid fa-box-archive"></i
            ><span>Bu müştəri arxivdədir</span>
         </div>
         <% } %>
         <div class="card single-search-card">
            <div class="card-header card-header--stacked">
               <h2 class="card-header-customer-name"><%= result.ad_soyad %></h2>
               <span class="card-header-meta"
                  >Ödəniş kodu: <%= result.odeme_kodu %> | Qeydiyyat: <%=
                  dateText(result) %></span
               >
            </div>
            <div class="card-body">
               <%- include('card-content', { result: result, omitCustomerName: true }) %>
            </div>
         </div>
         <% } else { %>
         <div class="result-list" id="searchResults">
            <% results.forEach((item, index) => { const t = getType(item); %>
            <div
               class="list-item <%= t.typeClass %>"
               data-code="<%= item.odeme_kodu %>"
               data-index="<%= index %>"
               data-list="search"
               role="button"
               tabindex="0"
            >
               <div class="list-main">
                  <div class="list-top">
                     <div class="name list-item-name">
                        <span class="list-customer-name"><%= item.ad_soyad || '' %></span
                        ><span class="badge <%= t.badgeClass %>"
                           ><i class="fa-solid <%= t.iconClass %>"></i> <%=
                           t.typeLabel %></span
                        >
                     </div>
                     <span class="list-date"
                        ><i class="fa-regular fa-calendar"></i> <%=
                        dateText(item) %></span
                     >
                  </div>
                  <div class="meta">
                     <div class="list-data">
                        <div class="list-data-row">
                           <i class="fa-solid fa-key"></i>
                           <span><%= item.odeme_kodu || '-' %></span>
                        </div>
                        <div class="list-data-row">
                           <i class="fa-solid fa-phone"></i>
                           <span>
                              <% if (item.telefon) { %>
                              <a class="list-phone-link" href="tel:<%= item.telefon %>"
                                 ><%= item.telefon %></a
                              >
                              <% } else { %>-<% } %>
                           </span>
                        </div>
                        <div class="list-data-row">
                           <i class="fa-solid fa-location-dot"></i>
                           <span><%= item.unvan || '-' %></span>
                        </div>
                     </div>
                  </div>
               </div>
               <i class="fa-solid fa-chevron-right chevron"></i>
            </div>
            <% }) %>
         </div>
         <% if (totalPages > 1) { %>
         <div class="pagination">
            <% if (currentPage > 1) { %><a
               href="/?q=<%= q %>&startDate=<%= startDate %>&endDate=<%= endDate %><%= status ? '&status=' + encodeURIComponent(status) : '' %>&page=<%= currentPage - 1 %>"
               >Əvvəlki</a
            ><% } %>
            <span style="padding: 8px 15px"
               >Səhifə <%= currentPage %> / <%= totalPages %></span
            >
            <% if (currentPage < totalPages) { %><a
               href="/?q=<%= q %>&startDate=<%= startDate %>&endDate=<%= endDate %><%= status ? '&status=' + encodeURIComponent(status) : '' %>&page=<%= currentPage + 1 %>"
               >Növbəti</a
            ><% } %>
         </div>
         <% } %> <% } %> <% } else { %>
         <div class="not-found">
            <p><i class="fa-solid fa-circle-xmark"></i> Nəticə tapılmadı</p>
         </div>
         <% } %> <% } else { %>
         <div class="stats">
            <div
               class="stat-card purple"
               onclick="openCustomerListModal('all')"
            >
               <h3>Ümumi Müştəri Sayı</h3>
               <p><%= totalCount %></p>
            </div>
            <div
               class="stat-card green"
               onclick="openCustomerListModal('today')"
            >
               <h3>Bu gün</h3>
               <p><%= todayCustomers.length %></p>
            </div>
            <div
               class="stat-card gray"
               onclick="openCustomerListModal('archive')"
            >
               <h3>Arxivdə olanlar</h3>
               <p><%= archivedCustomers.length %></p>
            </div>
            <div
               class="stat-card red"
               onclick="openCustomerListModal('problem')"
            >
               <h3>Problemlər</h3>
               <p><%= problemCount %></p>
            </div>
         </div>

         <div class="chart-container" id="monthlyStatsCard">
            <button
               class="chart-toggle"
               type="button"
               id="chartToggle"
               aria-expanded="false"
               aria-controls="chartPanel"
            >
               <span class="chart-toggle-title"
                  ><i class="fa-solid fa-chart-line"></i> Aylıq Qoşulma
                  Statistikası</span
               >
               <span class="chart-toggle-icon"
                  ><i class="fa-solid fa-chevron-down"></i
               ></span>
            </button>
            <div class="chart-panel" id="chartPanel">
               <div class="chart-inner">
                  <% if (monthlyStats.labels.length > 0) { %>
                  <div class="chart-actions">
                     <button class="btn-expand" onclick="openChartModal()">
                        <i class="fa-solid fa-expand"></i> Böyüt
                     </button>
                  </div>
                  <div class="chart-scroll">
                     <div
                        class="chart-wrapper"
                        style="
                           min-width: <%=
                              Math.max(560, monthlyStats.labels.length * 92)
                              %>px;
                        "
                     >
                        <canvas id="monthlyChart"></canvas>
                     </div>
                  </div>
                  <div class="chart-buttons" data-chart-scope="main">
                     <button
                        class="chart-btn active"
                        data-type="total"
                        onclick="updateChart('total','main')"
                     >
                        Ümumi
                     </button>
                     <button
                        class="chart-btn green"
                        data-type="qosulma"
                        onclick="updateChart('qosulma','main')"
                     >
                        Qoşulma
                     </button>
                     <button
                        class="chart-btn orange"
                        data-type="kocurme"
                        onclick="updateChart('kocurme','main')"
                     >
                        Köçürmə
                     </button>
                     <button
                        class="chart-btn red"
                        data-type="problem"
                        onclick="updateChart('problem','main')"
                     >
                        Problemlər
                     </button>
                  </div>
                  <% } else { %>
                  <div class="chart-empty">
                     <i class="fa-regular fa-chart-bar"></i
                     ><strong>Statistika tapılmadı</strong
                     ><span>Chart üçün aylıq məlumat yoxdur.</span>
                  </div>
                  <% } %>
               </div>
            </div>
         </div>

         <% } %>
      </div>

      <div id="customerModal" class="modal" aria-hidden="true">
         <div class="modal-content customer-detail-modal-content">
            <div class="modal-header customer-modal-header">
               <h2 id="modalTitle" class="modal-customer-title"></h2>
               <span class="close-btn" onclick="closeModal('customerModal')"
                  >&times;</span
               >
            </div>
            <div class="modal-body grid customer-card-global" id="modalBody"></div>
            <div id="modalCustomerFooterNav" class="modal-customer-footer-nav">
               <div class="modal-customer-nav-pill">
                  <button
                     type="button"
                     onclick="navigateModal(-1)"
                     id="prevBtn"
                     aria-label="Əvvəlki müştəri"
                  >
                     <i class="fa-solid fa-chevron-left"></i>
                  </button>
                  <span id="modalCounter" class="modal-customer-nav-counter"
                  ></span>
                  <button
                     type="button"
                     onclick="navigateModal(1)"
                     id="nextBtn"
                     aria-label="Növbəti müştəri"
                  >
                     <i class="fa-solid fa-chevron-right"></i>
                  </button>
               </div>
            </div>
         </div>
      </div>

      <div id="historyModal" class="modal" aria-hidden="true">
         <div class="modal-content history-modal-content">
            <div class="modal-header">
               <h2>📜 Fəaliyyət Tarixçəsi</h2>
               <span class="close-btn" onclick="closeModal('historyModal')"
                  >&times;</span
               >
            </div>
            <div class="history-modal-body" id="historyModalBody"></div>
         </div>
      </div>

      <div id="chartModal" class="modal" aria-hidden="true">
         <div class="modal-content large">
            <div class="modal-header">
               <h2>Aylıq Qoşulma Statistikası</h2>
               <span class="close-btn" onclick="closeModal('chartModal')"
                  >&times;</span
               >
            </div>
            <div class="modal-body">
               <% if (monthlyStats.labels.length > 0) { %>
               <div class="chart-scroll">
                  <div
                     class="modal-chart-frame"
                     style="
                        min-width: <%=
                           Math.max(620, monthlyStats.labels.length * 96) %>px;
                     "
                  >
                     <canvas id="modalChart"></canvas>
                  </div>
               </div>
               <div class="chart-buttons" data-chart-scope="modal">
                  <button
                     class="chart-btn active"
                     data-type="total"
                     onclick="updateChart('total','modal')"
                  >
                     Ümumi
                  </button>
                  <button
                     class="chart-btn green"
                     data-type="qosulma"
                     onclick="updateChart('qosulma','modal')"
                  >
                     Qoşulma
                  </button>
                  <button
                     class="chart-btn orange"
                     data-type="kocurme"
                     onclick="updateChart('kocurme','modal')"
                  >
                     Köçürmə
                  </button>
                  <button
                     class="chart-btn red"
                     data-type="problem"
                     onclick="updateChart('problem','modal')"
                  >
                     Problemlər
                  </button>
               </div>
               <% } else { %>
               <div class="chart-empty">
                  <i class="fa-regular fa-chart-bar"></i
                  ><strong>Statistika tapılmadı</strong>
               </div>
               <% } %>
            </div>
         </div>
      </div>

      <div id="customerListModal" class="modal" aria-hidden="true">
         <div class="modal-content customer-list-modal-content">
            <div class="modal-header customer-list-header">
               <div>
                  <h2 id="customerListTitle">
                     <i class="fa-solid fa-users"></i> Bütün Müştərilər
                     <span class="modal-count-badge" id="customerListCount"
                        >0</span
                     >
                  </h2>
                  <p id="customerListSubtitle">Siyahı yüklənir...</p>
               </div>
               <span class="close-btn" onclick="closeModal('customerListModal')"
                  >&times;</span
               >
            </div>
            <div class="customer-modal-search">
               <i class="fa-solid fa-magnifying-glass"></i>
               <input
                  id="customerListSearch"
                  type="search"
                  autocomplete="off"
                  placeholder="Ad, telefon və ya ödəniş kodu üzrə axtar..."
               />
            </div>
            <div class="modal-body customer-list-body" id="customerListBody">
               <div class="loading-block">
                  <div class="skeleton-list">
                     <div class="skeleton-card"></div>
                     <div class="skeleton-card"></div>
                     <div class="skeleton-card"></div>
                  </div>
               </div>
            </div>
         </div>
      </div>

      <script>
         let currentModalIndex = 0;
         let currentModalList = [];
         let currentModalType = '';
         let mainChart = null;
         let modalChartInstance = null;
         let customerListAbortController = null;
         let modalAbortController = null;
         let modemSnAbortController = null;
         let modalRequestSeq = 0;
         let mainChartInitialized = false;
         let activeChartType = 'total';
         let customerListState = { type: 'all', page: 1, limit: 10, totalPages: 1, totalCustomers: 0, customers: [], filteredCustomers: [], search: '' };
         const chartData = <%- JSON.stringify(monthlyStats) %>;
         const chartHasData = Array.isArray(chartData.labels) && chartData.labels.length > 0;
        const modalLists = {
          search: <%- JSON.stringify((results || []).map(r => r?.odeme_kodu).filter(Boolean)) %>,
          today: <%- JSON.stringify((todayCustomers || []).map(r => r?.odeme_kodu).filter(Boolean)) %>,
          archive: <%- JSON.stringify((archivedCustomers || []).map(r => r?.odeme_kodu).filter(Boolean)) %>,
           all: [],
           modem: []
         };
         const embeddedSearchCustomers = <%- JSON.stringify(results || []) %>;
         const customerListConfig = {
           all: { title: 'Bütün Müştərilər', icon: 'fa-users', endpoint: '/api/all-customers', subtitle: 'Bütün müştəri bazası' },
           today: { title: 'Bu gün', icon: 'fa-calendar-day', endpoint: '/api/today-customers', subtitle: 'Bugünkü aktiv qeydiyyatlar' },
           archive: { title: 'Arxivdə olanlar', icon: 'fa-box-archive', endpoint: '/api/archive-customers', subtitle: 'Arxiv statuslu müştərilər' },
           problem: { title: 'Problemlər', icon: 'fa-triangle-exclamation', endpoint: '/api/problem-customers', subtitle: 'Qeydində Problem yazılanlar' },
           search: { title: 'Axtarış nəticələri', icon: 'fa-magnifying-glass', endpoint: null, subtitle: 'Cari axtarış nəticələri' }
         };

         function escapeHtml(value){return String(value ?? '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#039;');}
         function formatDate(timestamp){
           if(timestamp === undefined || timestamp === null || String(timestamp).trim() === '') return 'Tarix yoxdur';
           const raw = String(timestamp).trim();
           let match = raw.match(/^(\d{1,2})\/(\d{1,2})\/(\d{4})/);
           if(match){const m=Number(match[1]),d=Number(match[2]),y=Number(match[3]);if(m>=1&&m<=12&&d>=1&&d<=31)return `${String(d).padStart(2,'0')}.${String(m).padStart(2,'0')}.${y}`;}
           match = raw.match(/^(\d{4})-(\d{1,2})-(\d{1,2})/);
           if(match){const y=Number(match[1]),m=Number(match[2]),d=Number(match[3]);if(m>=1&&m<=12&&d>=1&&d<=31)return `${String(d).padStart(2,'0')}.${String(m).padStart(2,'0')}.${y}`;}
           const parsed = new Date(raw);
           if(!Number.isNaN(parsed.getTime())) return `${String(parsed.getDate()).padStart(2,'0')}.${String(parsed.getMonth()+1).padStart(2,'0')}.${parsed.getFullYear()}`;
           return 'Tarix yoxdur';
         }
         function getCustomerType(item){
           const note = String(item?.qeyd || '').trim();
           const noteText = note.toLowerCase();
           const isArchived = item?.arxiv === true || ['hə', 'he', 'true', '1'].includes(String(item?.arxiv ?? '').trim().toLowerCase());
           const isProblem = !isArchived && noteText.includes('problem');
           const typeClass = isArchived ? 'archived-item' : (isProblem ? 'problem' : (noteText.includes('köç') || noteText.includes('kocurme') ? 'kocurme' : (noteText.includes('qoşulma') ? 'qosulma' : 'qosulma')));
           const badgeClass = isArchived ? 'archived' : (isProblem ? 'problem' : typeClass);
           const typeLabel = isArchived ? 'Arxivdə' : (isProblem ? 'Problem' : (noteText.includes('köç') || noteText.includes('kocurme') ? 'Köçürmə' : (noteText.includes('qoşulma') ? 'Qoşulma' : (note || 'Digər'))));
           const iconClass = isArchived ? 'fa-box-archive' : (isProblem ? 'fa-triangle-exclamation' : (typeClass === 'kocurme' ? 'fa-truck-moving' : 'fa-plug'));
           return { typeClass, badgeClass, typeLabel, iconClass };
         }
         function createBadge(type){return `<span class="badge ${type.badgeClass}"><i class="fa-solid ${type.iconClass}"></i> ${escapeHtml(type.typeLabel)}</span>`;}
         function createLoadingSkeleton(count=3){return `<div class="loading-block"><div class="skeleton-list">${Array.from({length:count},()=>'<div class="skeleton-card"></div>').join('')}</div></div>`;}
         function createSpinner(text='Yüklənir...'){return `<div class="loader-inline"><span class="spinner"></span><span>${escapeHtml(text)}</span></div>`;}
         function debounce(fn, wait=180){let timeout;return (...args)=>{clearTimeout(timeout);timeout=setTimeout(()=>fn(...args),wait);};}
         function normalizeSearch(value){return String(value ?? '').toLowerCase().replace(/\s+/g,'').trim();}
         function customerMatchesSearch(item, query){if(!query)return true;const haystack=[item?.ad_soyad,item?.telefon,item?.odeme_kodu].map(normalizeSearch).join('|');return haystack.includes(query);}
         function createCustomerListItem(item,index,listType='all'){
           const type=getCustomerType(item);
           const odemeKodu=String(item?.odeme_kodu??'');
           const adSoyad=item?.ad_soyad||'';
           const telefon=item?.telefon||'-';
           const unvan=item?.unvan||'';
          const netice=String(item?.netice||'').trim();
          const isProblem=String(item?.qeyd||'').toLowerCase().includes('problem');
          const resultClass=netice.toLowerCase()==='həll olundu' ? 'result-success' : 'result-failed';
          const resultHtml=isProblem&&netice?`<div class="result-label ${resultClass}"><span class="fa-solid fa-circle-check"></span> Nəticə: ${escapeHtml(netice)}</div>`:'';
          const phoneRow = telefon && telefon !== '-' ? `<a class="list-phone-link" href="tel:${encodeURIComponent(telefon)}">${escapeHtml(telefon)}</a>` : '-';
          return `<div class="list-item ${type.typeClass}" data-code="${escapeHtml(odemeKodu)}" data-index="${Number(index)||0}" data-list="${escapeHtml(listType)}" role="button" tabindex="0"><div class="list-main"><div class="list-top"><div class="name list-item-name"><span class="list-customer-name">${escapeHtml(adSoyad)}</span>${createBadge(type)}</div><span class="list-date"><i class="fa-regular fa-calendar"></i> ${escapeHtml(formatDate(item?.timestamp))}</span></div><div class="list-data"><div class="list-data-row"><i class="fa-solid fa-key"></i><span>${escapeHtml(odemeKodu||'-')}</span></div><div class="list-data-row"><i class="fa-solid fa-phone"></i><span>${phoneRow}</span></div><div class="list-data-row"><i class="fa-solid fa-location-dot"></i><span>${escapeHtml(unvan||'-')}</span></div></div>${resultHtml}</div><i class="fa-solid fa-chevron-right chevron"></i></div>`;
         }

         function syncModalLock(){const hasOpenModal=Boolean(document.querySelector('.modal.is-open'));document.body.classList.toggle('modal-open',hasOpenModal);}
         function setModalOpen(id,isOpen){const el=document.getElementById(id);if(!el)return;el.classList.toggle('is-open',isOpen);el.setAttribute('aria-hidden',String(!isOpen));syncModalLock();if(!isOpen&&id==='customerListModal'&&customerListAbortController){customerListAbortController.abort();customerListAbortController=null;}}
         function closeModal(id){setModalOpen(id,false);if(id==='customerModal'){if(modalAbortController){modalAbortController.abort();modalAbortController=null;}setModalOpen('historyModal',false);}}

         function setupChartToggle(){const card=document.getElementById('monthlyStatsCard');const toggle=document.getElementById('chartToggle');if(!card||!toggle)return;const saved=localStorage.getItem('monthlyStatsChartOpen')==='true';setChartOpen(saved,false);toggle.addEventListener('click',()=>setChartOpen(!card.classList.contains('is-open'),true));}
         function setChartOpen(open,persist){const card=document.getElementById('monthlyStatsCard');const toggle=document.getElementById('chartToggle');if(!card||!toggle)return;card.classList.toggle('is-open',open);toggle.setAttribute('aria-expanded',String(open));if(persist)localStorage.setItem('monthlyStatsChartOpen',String(open));if(open&&chartHasData&&!mainChartInitialized){requestAnimationFrame(()=>initChart());}else if(open&&mainChart){setTimeout(()=>mainChart.resize(),260);}}
         function chartConfig(type='total'){const colors={total:{bg:'rgba(59,130,246,.46)',border:'#3b82f6'},qosulma:{bg:'rgba(16,185,129,.52)',border:'#10b981'},kocurme:{bg:'rgba(245,158,11,.55)',border:'#f59e0b'},problem:{bg:'rgba(239,68,68,.52)',border:'#ef4444'}};const labels={total:'Ümumi',qosulma:'Qoşulma',kocurme:'Köçürmə',problem:'Problemlər'};return{label:labels[type]||labels.total,color:colors[type]||colors.total};}
         function syncChartButtons(scope,type=activeChartType){document.querySelectorAll(`.chart-buttons[data-chart-scope="${scope}"] .chart-btn`).forEach(b=>b.classList.toggle('active',b.dataset.type===type));}
         function buildChart(ctx,type=activeChartType){const cfg=chartConfig(type);return new Chart(ctx,{type:'bar',data:{labels:chartData.labels,datasets:[{label:cfg.label,data:chartData[type]||[],backgroundColor:cfg.color.bg,borderColor:cfg.color.border,borderWidth:2,borderRadius:8,barPercentage:.72,categoryPercentage:.68}]},options:{responsive:true,maintainAspectRatio:false,animation:{duration:450,easing:'easeOutQuart'},plugins:{legend:{labels:{color:'#e2e8f0'}}},scales:{y:{beginAtZero:true,ticks:{color:'#94a3b8',stepSize:1,precision:0},grid:{color:'rgba(51,65,85,.8)'}},x:{ticks:{color:'#cbd5e1',autoSkip:false,maxRotation:0,minRotation:0},grid:{color:'rgba(51,65,85,.45)'}}}}});}
         function initChart(){if(!chartHasData||mainChartInitialized)return;const ctx=document.getElementById('monthlyChart');if(!ctx)return;mainChart=buildChart(ctx,activeChartType);syncChartButtons('main');mainChartInitialized=true;}
         function openChartModal(){setModalOpen('chartModal',true);syncChartButtons('modal');if(chartHasData&&!modalChartInstance){requestAnimationFrame(()=>{const ctx=document.getElementById('modalChart');if(ctx)modalChartInstance=buildChart(ctx,activeChartType);});}else if(modalChartInstance){setTimeout(()=>modalChartInstance.resize(),120);}}
         function updateChart(type,scope='main'){if(!chartData[type])return;activeChartType=type;const cfg=chartConfig(type);['main','modal'].forEach(syncScope=>syncChartButtons(syncScope,type));[mainChart,modalChartInstance].filter(Boolean).forEach(chart=>{chart.data.datasets[0].label=cfg.label;chart.data.datasets[0].data=chartData[type]||[];chart.data.datasets[0].backgroundColor=cfg.color.bg;chart.data.datasets[0].borderColor=cfg.color.border;chart.update('active');});}

         function updateCustomerListHeader(){const cfg=customerListConfig[customerListState.type]||customerListConfig.all;const title=document.getElementById('customerListTitle');const count=document.getElementById('customerListCount');const subtitle=document.getElementById('customerListSubtitle');if(title)title.innerHTML=`<i class="fa-solid ${cfg.icon}"></i> ${escapeHtml(cfg.title)} <span class="modal-count-badge" id="customerListCount">${Number(customerListState.totalCustomers)||0}</span>`;if(count)count.textContent=Number(customerListState.totalCustomers)||0;if(subtitle)subtitle.textContent=`${cfg.subtitle} · Səhifə ${customerListState.page} / ${customerListState.totalPages}`;}
         function setCustomerListSearchValue(value=''){const input=document.getElementById('customerListSearch');if(input)input.value=value;customerListState.search=normalizeSearch(value);}
         async function openCustomerListModal(type='all'){customerListState={...customerListState,type:customerListConfig[type]?type:'all',page:1,totalPages:1,totalCustomers:0,customers:[],filteredCustomers:[],search:''};setCustomerListSearchValue('');updateCustomerListHeader();setModalOpen('customerListModal',true);await loadCustomerListPage(1);setTimeout(()=>document.getElementById('customerListSearch')?.focus(),80);}
         function showCustomerListError(message){const body=document.getElementById('customerListBody');if(!body)return;body.innerHTML=`<div class="not-found" style="margin:0"><p><i class="fa-solid fa-triangle-exclamation"></i> ${escapeHtml(message||'Müştərilər yüklənmədi.')}</p><button class="btn-edit" type="button" onclick="loadCustomerListPage(${Number(customerListState.page)||1})"><i class="fa-solid fa-rotate-right"></i> Yenidən cəhd et</button></div>`;}
         async function loadCustomerListPage(page=1){const cfg=customerListConfig[customerListState.type]||customerListConfig.all;const requestedPage=Number.parseInt(page,10)||1;const body=document.getElementById('customerListBody');if(!body)return;customerListState.page=requestedPage;updateCustomerListHeader();body.innerHTML=createLoadingSkeleton(5);if(customerListAbortController)customerListAbortController.abort();customerListAbortController=new AbortController();try{let payload;if(customerListState.type==='search'){const customers=Array.isArray(embeddedSearchCustomers)?embeddedSearchCustomers:[];payload={customers,currentPage:1,totalPages:1,totalCustomers:customers.length};}else{const res=await fetch(`${cfg.endpoint}?page=${encodeURIComponent(requestedPage)}&limit=${encodeURIComponent(customerListState.limit)}`,{headers:{Accept:'application/json'},credentials:'same-origin',signal:customerListAbortController.signal});const contentType=res.headers.get('content-type')||'';if(!contentType.includes('application/json'))throw new Error(res.status===401?'Sessiya bitib. Zəhmət olmasa yenidən daxil olun.':'Server JSON formatında cavab qaytarmadı.');payload=await res.json();if(!res.ok||payload.success!==true)throw new Error(payload.error||`Server xətası (${res.status})`);}customerListState.customers=Array.isArray(payload.customers)?payload.customers:(Array.isArray(payload.data)?payload.data:[]);customerListState.page=Math.max(1,Number.parseInt(payload.currentPage,10)||1);customerListState.totalPages=Math.max(1,Number.parseInt(payload.totalPages,10)||1);customerListState.totalCustomers=Number.parseInt(payload.totalCustomers,10)||customerListState.customers.length;applyCustomerListFilter();}catch(error){if(error.name==='AbortError')return;console.error('[customer-list-modal] Müştərilər yüklənmədi:',error);showCustomerListError(error.message);}}
        function applyCustomerListFilter(){const query=customerListState.search;customerListState.filteredCustomers=customerListState.customers.filter(item=>customerMatchesSearch(item,query));modalLists[customerListState.type]=customerListState.filteredCustomers.map(c=>c?.odeme_kodu).filter(code=>code!==undefined&&code!==null&&String(code).trim()!=='').map(String);renderCustomerListModal();}
        const modalFields = [
          { key:'odeme_kodu', label:'ÖDƏNİŞ KODU' },
          { key:'telefon', label:'TELEFON', type:'tel' },
          { key:'ayliq_odenis', label:'AYLIQ ÖDƏNİŞ', suffix:' AZN' },
          { key:'fin', label:'Ş/V FİN' },
          { key:'seriya', label:'Ş/V SERİYA' },
          { key:'modem', label:'MODEM S/N' },
          { key:'tvbox', label:'TV BOX' },
          { key:'komendant', label:'KOMENDANT' },
          { key:'timestamp', label:'QEYDİYYAT TARİXİ', type:'date' },
          { key:'unvan', label:'ÜNVAN', full:true },
          { key:'qeyd', label:'QEYD', full:true },
          { key:'problem_sebebi', label:'PROBLEMIN SƏBƏBİ', full:true },
          { key:'netice', label:'NƏTİCƏ', type:'status', full:true }
        ];
         function normalizeClientHistory(raw){if(raw==null)return[];if(Array.isArray(raw))return raw;if(typeof raw==='string'){try{const p=JSON.parse(raw);return Array.isArray(p)?p:[]}catch{return[]}}return[];}
         function historyTimelineIcon(ev,note){const t=(String(ev)+' '+String(note)).toLowerCase();if(t.includes('arxiv'))return '📦';if(t.includes('problem'))return '🔴';if(t.includes('admin'))return '📝';return '📋';}
         function formatHistoryDateLabel(iso){if(!iso)return'—';const d=new Date(iso);if(Number.isNaN(d.getTime()))return String(iso);return d.toLocaleString('az-AZ',{dateStyle:'short',timeStyle:'short'});}
         function buildHistoryTimelineRows(historyRaw){return normalizeClientHistory(historyRaw).filter(x=>x&&(x.event||x.note)).map(x=>({date:String(x.date||''),event:String(x.event||'').trim(),note:String(x.note||'').trim()})).sort((a,b)=>(Date.parse(b.date)||0)-(Date.parse(a.date)||0));}
         function renderHistoryModalInnerHtml(rows){if(!rows.length)return'<div class="activity-timeline-wrap"><p class="activity-timeline-empty">Bu müştəri üçün hələ ki tarixçə qeydə alınmayıb.</p></div>';const items=rows.map(row=>`<li class="activity-timeline-item"><span class="activity-timeline-icon" aria-hidden="true">${historyTimelineIcon(row.event,row.note)}</span><div class="activity-timeline-body"><time class="activity-timeline-time" datetime="${escapeHtml(row.date)}">${escapeHtml(formatHistoryDateLabel(row.date))}</time><strong class="activity-timeline-event">${escapeHtml(row.event)}</strong>${row.note?`<p class="activity-timeline-note">${escapeHtml(row.note)}</p>`:''}</div></li>`).join('');return`<div class="activity-timeline-wrap"><ul class="activity-timeline">${items}</ul></div>`;}
         function encodeHistoryDataAttribute(historyRaw){try{return encodeURIComponent(JSON.stringify(normalizeClientHistory(historyRaw)));}catch(_e){return encodeURIComponent('[]');}}
         function openCustomerHistoryModal(trigger){const enc=trigger&&trigger.getAttribute('data-history');let rows=[];try{const parsed=enc?JSON.parse(decodeURIComponent(enc)):[];rows=buildHistoryTimelineRows(Array.isArray(parsed)?parsed:[]);}catch(_e){rows=[];}const body=document.getElementById('historyModalBody');if(body)body.innerHTML=renderHistoryModalInnerHtml(rows);setModalOpen('historyModal',true);}
         function hideModemSnDropdown(){const d=document.getElementById('modemSnLiveResults');if(d){d.hidden=true;d.innerHTML='';}}
         async function runModemSnSearch(rawQuery){const el=document.getElementById('modemSnLiveResults');if(!el)return;const q=String(rawQuery??'').trim();if(q.length<2){hideModemSnDropdown();return;}if(modemSnAbortController)modemSnAbortController.abort();modemSnAbortController=new AbortController();try{const res=await fetch(`/api/modem-search?sn=${encodeURIComponent(q)}`,{headers:{Accept:'application/json'},credentials:'same-origin',signal:modemSnAbortController.signal});const json=await res.json();if(!res.ok||json.success!==true)throw new Error(json.error||'Axtarış alınmadı');const customers=Array.isArray(json.customers)?json.customers:[];if(!customers.length){el.hidden=false;el.innerHTML='<div class="modem-sn-row" style="cursor:default"><span class="modem-sn-row-name" style="color:#64748b">Uyğun S/N tapılmadı</span></div>';return;}el.hidden=false;el.innerHTML=customers.map(c=>`<button type="button" class="modem-sn-row" data-code="${escapeHtml(String(c.odeme_kodu||''))}"><span class="modem-sn-row-name">${escapeHtml(c.ad_soyad||'')}</span><span class="modem-sn-row-sn">${escapeHtml(c.modem||'')}</span></button>`).join('');}catch(err){if(err.name==='AbortError')return;el.hidden=false;el.innerHTML=`<div class="modem-sn-row" style="cursor:default"><span class="modem-sn-row-name" style="color:#64748b">${escapeHtml(err.message||'Xəta')}</span></div>`;}}
         const debouncedModemSnSearch=debounce((event)=>runModemSnSearch(event.target&&event.target.value),200);
         function renderCustomerListModal(){const body=document.getElementById('customerListBody');if(!body)return;updateCustomerListHeader();const customers=customerListState.filteredCustomers;const totalLabel=customerListState.search?`${customers.length} uyğun nəticə`:`${customerListState.totalCustomers} müştəri`;if(customers.length===0){body.innerHTML=`<div class="customer-list-empty"><i class="fa-regular fa-folder-open"></i><p>${customerListState.search?'Axtarışa uyğun müştəri tapılmadı.':'Siyahıda müştəri yoxdur.'}</p></div>`;return;}const listHtml=`<div class="all-customers-toolbar"><span><i class="fa-solid fa-layer-group"></i> Səhifə ${customerListState.page} / ${customerListState.totalPages}</span><strong>${escapeHtml(totalLabel)}</strong></div><div class="compact-list">${customers.map((item,index)=>createCustomerListItem(item,index,customerListState.type)).join('')}</div>`;const paginationHtml=customerListState.type==='search'?'':`<div class="pagination"><button type="button" ${customerListState.page<=1?'disabled':''} onclick="loadCustomerListPage(${customerListState.page-1})">Əvvəlki</button><span style="padding:8px 15px">Səhifə ${customerListState.page} / ${customerListState.totalPages}</span><button type="button" ${customerListState.page>=customerListState.totalPages?'disabled':''} onclick="loadCustomerListPage(${customerListState.page+1})">Növbəti</button></div>`;body.innerHTML=listHtml+paginationHtml;}
         const handleCustomerListSearch=debounce((event)=>{customerListState.search=normalizeSearch(event.target.value);applyCustomerListFilter();},180);

         function collectPhotoUrlsOrdered(o){const out=[],seen=new Set();function push(u){const s=String(u??'').trim();if(!s||s.toLowerCase()==='null'||seen.has(s))return;seen.add(s);out.push(s);}['photo1','photo2','photo3'].forEach(k=>push(o?.[k]));String(o?.drive_links??'').split(',').forEach(x=>push(String(x).trim()));return out;}
         function buildCustomerPhotoRowHtml(r){const urls=collectPhotoUrlsOrdered(r);if(!urls.length)return'';return`<div class="customer-card-global__photo-row" role="group" aria-label="Şəkillər">${urls.map((l,i)=>`<button type="button" class="btn-image drive-link" onclick='window.open(${JSON.stringify(l)},"_blank")' title="Drive"><i class="fa-solid fa-image"></i> Foto ${i+1}</button>`).join('')}</div>`;}
         function openModal(odemeKodu,index,type='search'){setModalOpen('historyModal',false);currentModalType=type;currentModalList=Array.isArray(modalLists[type])?[...modalLists[type]]:[];if(!currentModalList.length&&odemeKodu)currentModalList=[String(odemeKodu)];currentModalIndex=currentModalList.map(String).indexOf(String(odemeKodu));if(currentModalIndex<0)currentModalIndex=Number.isInteger(index)?index:0;loadModalCustomer(odemeKodu);}
        async function loadModalCustomer(odemeKodu){
const modalBody=document.getElementById('modalBody');
const modalTitle=document.getElementById('modalTitle');
const counter=document.getElementById('modalCounter');
const prevBtn=document.getElementById('prevBtn');
const nextBtn=document.getElementById('nextBtn');
if(!modalBody||!modalTitle)return;
setModalOpen('historyModal',false);
if(modalAbortController)modalAbortController.abort();
modalAbortController=new AbortController();
const requestId=++modalRequestSeq;
modalTitle.textContent='Müştəri məlumatı';
modalBody.innerHTML=createSpinner('Məlumat yüklənir...');
setModalOpen('customerModal',true);
if(counter)counter.textContent=currentModalList.length?`${currentModalIndex+1} / ${currentModalList.length}`:'';
if(prevBtn)prevBtn.disabled=currentModalIndex<=0;
if(nextBtn)nextBtn.disabled=currentModalIndex>=currentModalList.length-1;
try{
const res=await fetch(`/customer/${encodeURIComponent(odemeKodu)}`,{headers:{Accept:'application/json'},credentials:'same-origin',signal:modalAbortController.signal});
const contentType=res.headers.get('content-type')||'';
if(!contentType.includes('application/json'))throw new Error(res.status===401?'Sessiya bitib. Zəhmət olmasa yenidən daxil olun.':'Server JSON formatında cavab qaytarmadı.');
const json=await res.json();
if(requestId!==modalRequestSeq)return;
if(!res.ok||json.success!==true||!json.data)throw new Error(json.error||'Məlumat tapılmadı.');
const r=json.data;
const isArchived=r.arxiv===true||['hə','he','true','1'].includes(String(r.arxiv??'').trim().toLowerCase());
const customerName=String(r.ad_soyad||'').trim()||'Adsız müştəri';
modalTitle.innerHTML=`<span class="modal-customer-name-block">${escapeHtml(customerName)}</span>${isArchived?'<span class="badge archived" style="font-size:13px"><i class="fa-solid fa-box-archive"></i> Arxivdə</span>':''}`;
const isProblem=String(r.qeyd||'').toLowerCase().includes('problem');
let html='';
modalFields.forEach(f=>{
if(f.key==='problem_sebebi'&&!isProblem)return;
if(f.key==='netice'&&(!isProblem||!String(r.netice||'').trim()))return;
let val=r[f.key];
if(f.type==='date')val=formatDate(val);
if(!val||String(val).trim()===''||String(val).toLowerCase()==='yox')return;
const rowFull=f.full?' info-item-row--full':'';
html+=`<div class="info-item info-item-row${rowFull}"><label class="info-label">${escapeHtml(f.label)}</label>`;
if(f.type==='tel'){
const cleanTel=String(val).replace(/\s/g,'');
const waTel='994'+cleanTel.replace(/^0/,'');
html+=`<p class="info-value info-value--contact"><span class="customer-card-global__tel-line"><a href="tel:${encodeURIComponent(cleanTel)}" class="info-link customer-card-global__telnum">${escapeHtml(val)}</a><a href="https://wa.me/${encodeURIComponent(waTel)}" target="_blank" rel="noopener noreferrer" class="customer-card-global__wa" aria-label="WhatsApp"><i class="fa-brands fa-whatsapp"></i></a></span></p></div>`;
}else if(f.type==='status'){
const statusClass=String(val).trim().toLowerCase()==='həll olundu'?'result-success':'result-failed';
html+=`<p class="info-value ${statusClass}">${escapeHtml(val)}</p></div>`;
}else{
html+=`<p class="info-value"><span class="info-text">${escapeHtml(val)}${f.suffix||''}</span></p></div>`;
}
});
html+=buildCustomerPhotoRowHtml(r);
const codeArg=JSON.stringify(String(r.odeme_kodu||'')).replace(/'/g,'\u0027');
const idArg=JSON.stringify(r.id ?? '').replace(/'/g,'\u0027');
html+=`<div class="customer-card-actions"><button type="button" class="btn-customer-history btn-card-action" data-history="${encodeHistoryDataAttribute(r.history)}" onclick="openCustomerHistoryModal(this)">📜 Fəaliyyət Tarixçəsi</button><a href="/edit/${encodeURIComponent(r.odeme_kodu)}" class="btn-edit btn-card-action">📝 Redaktə</a><button type="button" class="btn-delete btn-card-action" onclick='deleteCustomer(${codeArg}, ${idArg})'>🗑️ Sil</button>${isArchived?`<button type="button" class="btn-unarchive btn-card-action" onclick='toggleArchive(${codeArg}, ${idArg}, false)'>📦 Arxivdən Çıxart</button>`:`<button type="button" class="btn-archive btn-card-action" onclick='toggleArchive(${codeArg}, ${idArg}, true)'>📦 Arxivə Göndər</button>`}</div>`;
modalBody.innerHTML=html;
}catch(error){
if(error.name==='AbortError')return;
console.error('[customer-modal] Müştəri yüklənmədi:',error);
modalTitle.textContent='Xəta';
modalBody.innerHTML=`<div class="not-found" style="margin:0"><p><i class="fa-solid fa-triangle-exclamation"></i> ${escapeHtml(error.message||'Məlumat yüklənmədi.')}</p></div>`;
}
}
         function navigateModal(direction){const newIndex=currentModalIndex+direction;if(newIndex>=0&&newIndex<currentModalList.length){currentModalIndex=newIndex;loadModalCustomer(currentModalList[currentModalIndex]);}}

         async function postJson(url,body){const res=await fetch(url,{method:'POST',headers:{'Content-Type':'application/json',Accept:'application/json'},credentials:'same-origin',body:JSON.stringify(body)});const contentType=res.headers.get('content-type')||'';if(!contentType.includes('application/json'))throw new Error('Server JSON formatında cavab qaytarmadı.');const json=await res.json();if(!res.ok||json.success!==true)throw new Error(json.error||`Server xətası (${res.status})`);return json;}
        async function deleteCustomer(odemeKodu,id){if(!confirm(`"${odemeKodu}" ödəniş kodlu müştərini silmək istəyirsiniz?`))return;try{const safeId=String(id??'').trim();if(!safeId)throw new Error('Müştəri ID-si tapılmadı.');await postJson(`/delete/${encodeURIComponent(safeId)}`,{odemeKodu:String(odemeKodu??'')});alert('Müştəri silindi');location.reload();}catch(error){alert('Xəta: '+error.message);}}
        async function toggleArchive(odemeKodu,id,archive){const action=archive?'arxivə göndərmək':'arxivdən çıxartmaq';if(!confirm(`"${odemeKodu}" ödəniş kodlu müştərini ${action} istəyirsiniz?`))return;try{const safeId=String(id??'').trim();if(!safeId)throw new Error('Müştəri ID-si tapılmadı.');await postJson(`/archive/${encodeURIComponent(safeId)}`,{archive,odemeKodu:String(odemeKodu??'')});alert(archive?'Müştəri arxivə göndərildi':'Müştəri arxivdən çıxarıldı');location.reload();}catch(error){alert('Xəta: '+error.message);}}

         document.addEventListener('click',(e)=>{if(!e.target.closest('#modemSnLiveWrap'))hideModemSnDropdown();const item=e.target.closest('.list-item[data-code]');if(item){openModal(item.dataset.code,Number.parseInt(item.dataset.index,10)||0,item.dataset.list||'search');return;}if(e.target.classList.contains('modal'))closeModal(e.target.id);});
         function initSearchFormToggle(){const c=document.getElementById('searchFormContainer');const b=document.getElementById('toggleSearchBtn');if(!c||!b)return;const mq=window.matchMedia('(max-width: 768px)');function sync(){if(mq.matches){c.classList.remove('search-form-open');b.setAttribute('aria-expanded','false');}else{c.classList.add('search-form-open');b.setAttribute('aria-expanded','true');}}sync();if(typeof mq.addEventListener==='function')mq.addEventListener('change',sync);else if(typeof mq.addListener==='function')mq.addListener(sync);b.addEventListener('click',()=>{if(!mq.matches)return;c.classList.toggle('search-form-open');b.setAttribute('aria-expanded',String(c.classList.contains('search-form-open')));});}
         document.addEventListener('keydown',(e)=>{if(e.key==='Enter'||e.key===' '){const item=e.target.closest?.('.list-item[data-code]');if(item){e.preventDefault();openModal(item.dataset.code,Number.parseInt(item.dataset.index,10)||0,item.dataset.list||'search');return;}}if(e.key==='Escape'){if(document.getElementById('historyModal')?.classList.contains('is-open')){closeModal('historyModal');return;}}const customerOpen=document.getElementById('customerModal')?.classList.contains('is-open');if(customerOpen){if(e.key==='Escape'){closeModal('customerModal');return;}if(e.key==='ArrowLeft')navigateModal(-1);if(e.key==='ArrowRight')navigateModal(1);}if(e.key==='Escape'){if(document.getElementById('chartModal')?.classList.contains('is-open')){closeModal('chartModal');return;}if(document.getElementById('customerListModal')?.classList.contains('is-open'))closeModal('customerListModal');}});
         document.addEventListener('DOMContentLoaded',()=>{setupChartToggle();initSearchFormToggle();document.getElementById('customerListSearch')?.addEventListener('input',handleCustomerListSearch);document.getElementById('modemSnLiveSearch')?.addEventListener('input',debouncedModemSnSearch);document.getElementById('modemSnLiveResults')?.addEventListener('click',(e)=>{const btn=e.target.closest('.modem-sn-row[data-code]');if(!btn)return;e.preventDefault();const code=btn.getAttribute('data-code');if(!code)return;hideModemSnDropdown();const inp=document.getElementById('modemSnLiveSearch');if(inp)inp.value='';openModal(code,0,'modem');});});
      </script>
   </body>
</html>
