<!DOCTYPE html>
<html lang="az">
<head>
    <title>Müştəri Panel</title>
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=0">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    <style>
        :root {
            --bg: #0f172a; --card: #1e293b; --card-soft: #223047; --card-glass: rgba(30, 41, 59, 0.85);
            --border: #334155; --border-soft: rgba(148, 163, 184, 0.2); --green: #10b981;
            --green-dark: #059669; --text: #e2e8f0; --muted: #94a3b8; --blue: #3b82f6;
            --purple: #8b5cf6; --orange: #f59e0b; --red: #ef4444; --gray: #6b7280;
        }

        * { box-sizing: border-box; -webkit-tap-highlight-color: transparent; }
        body {
            font-family: system-ui, -apple-system, sans-serif; margin: 0;
            background: radial-gradient(circle at top, #13203a 0, var(--bg) 45%);
            color: var(--text); min-height: 100vh;
        }
        body.modal-open { overflow: hidden; }

        /* HEADER */
        .header {
            background: linear-gradient(90deg, #047857, #10b981);
            padding: 12px 16px; display: flex; justify-content: space-between;
            align-items: center; box-shadow: 0 10px 30px rgba(0,0,0,0.25);
            position: sticky; top: 0; z-index: 900;
        }
        .header h1 { margin: 0; font-size: 16px; font-weight: 800; color: #fff; }
        .header .actions { display: flex; gap: 8px; }
        .header .actions a {
            text-decoration: none; font-weight: 700; font-size: 13px; padding: 8px 12px;
            border-radius: 10px; color: #fff; background: rgba(255,255,255,0.2); transition: 0.2s;
        }
        .header .actions a.btn-logout { background: var(--red); }

        .container { padding: 15px; max-width: 1000px; margin: auto; }

        /* CARDS & STATS */
        .stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 15px; margin-bottom: 20px; }
        .stat-card {
            background: var(--card-glass); border: 1px solid var(--border-soft);
            padding: 20px; border-radius: 16px; cursor: pointer; transition: 0.3s;
        }
        .stat-card:hover { transform: translateY(-3px); border-color: var(--green); background: var(--card); }
        .stat-card h3 { margin: 0; font-size: 13px; color: var(--muted); text-transform: uppercase; }
        .stat-card p { margin: 10px 0 0; font-size: 28px; font-weight: 900; }
        .stat-card.purple { border-left: 4px solid var(--purple); }
        .stat-card.green { border-left: 4px solid var(--green); }
        .stat-card.gray { border-left: 4px solid var(--gray); }

        /* SEARCH SECTION */
        .search-section { background: var(--card-glass); padding: 15px; border-radius: 16px; margin-bottom: 20px; border: 1px solid var(--border-soft); }
        .search-box { display: flex; gap: 10px; margin-bottom: 12px; }
        .search-box input { flex: 1; padding: 12px; border-radius: 10px; border: 1px solid var(--border); background: #0f172a; color: #fff; }
        .search-box button { padding: 12px 20px; background: var(--green); border: none; border-radius: 10px; color: #fff; font-weight: 800; cursor: pointer; }

        /* LIST ITEMS */
        .list-item {
            background: var(--card-glass); padding: 14px; border-radius: 14px; margin-bottom: 10px;
            display: flex; justify-content: space-between; align-items: center; cursor: pointer;
            transition: 0.2s; border: 1px solid var(--border-soft);
        }
        .list-item:hover { transform: translateX(5px); border-color: var(--green); background: #273549; }
        .list-item .name { font-weight: 800; font-size: 15px; margin-bottom: 4px; display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
        .badge { font-size: 10px; padding: 3px 8px; border-radius: 12px; font-weight: 800; text-transform: uppercase; }
        .badge.qosulma { background: rgba(16,185,129,0.2); color: #6ee7b7; }
        .badge.kocurme { background: rgba(245,158,11,0.2); color: #fbbf24; }
        .badge.archived { background: rgba(148,163,184,0.2); color: #cbd5e1; }

        /* MODALS */
        .modal {
            display: none; position: fixed; inset: 0; background: rgba(2,6,23,0.85);
            backdrop-filter: blur(8px); z-index: 1000; align-items: center; justify-content: center; padding: 15px;
        }
        .modal.is-open { display: flex; }
        .modal-content {
            background: var(--card); border: 1px solid var(--border-soft);
            width: 100%; max-width: 800px; max-height: 90vh; border-radius: 20px;
            display: flex; flex-direction: column; overflow: hidden;
        }
        .modal-header { padding: 15px 20px; border-bottom: 1px solid var(--border-soft); display: flex; justify-content: space-between; align-items: center; }
        .modal-body { padding: 20px; overflow-y: auto; flex: 1; }
        .modal-body.grid { display: grid; grid-template-columns: 1fr 1fr; gap: 15px; }
        .close-btn { font-size: 24px; cursor: pointer; color: var(--muted); }

        .info-item label { font-size: 11px; color: var(--muted); text-transform: uppercase; display: block; margin-bottom: 4px; }
        .info-item p { margin: 0; font-weight: 600; word-break: break-word; }
        .full-width { grid-column: 1 / -1; }

        .btn-wa { background: #25D366; color: #fff; padding: 6px 12px; border-radius: 8px; text-decoration: none; display: inline-flex; align-items: center; gap: 5px; font-size: 13px; }
        .btn-edit { background: var(--blue); color: #fff; padding: 8px 15px; border-radius: 8px; text-decoration: none; }
        .btn-delete { background: var(--red); color: #fff; border: none; padding: 8px 15px; border-radius: 8px; cursor: pointer; }

        @media (max-width: 600px) {
            .modal-body.grid { grid-template-columns: 1fr; }
            .header h1 span { display: none; }
        }
    </style>
</head>
<body>

<div class="header">
    <div class="logo"><h1><i class="fa-solid fa-database"></i> <span>Müştəri Paneli</span></h1></div>
    <div class="actions">
        <a href="/add"><i class="fa-solid fa-plus"></i> Əlavə Et</a>
        <a href="/logout" class="btn-logout"><i class="fa-solid fa-right-from-bracket"></i></a>
    </div>
</div>

<div class="container">
    <div class="search-section">
        <form class="search-box" method="GET">
            <input type="text" name="q" value="<%= q || '' %>" placeholder="Ad, telefon və ya kod...">
            <button type="submit"><i class="fa-solid fa-magnifying-glass"></i></button>
        </form>
    </div>

    <% if (!q && !startDate && !endDate) { %>
        <div class="stats">
            <div class="stat-card purple" onclick="openCustomerListModal('all')">
                <h3>Ümumi Müştəri</h3>
                <p><%= totalCount %></p>
            </div>
            <div class="stat-card green" onclick="openCustomerListModal('today')">
                <h3>Bu Gün</h3>
                <p><%= todayCustomers.length %></p>
            </div>
            <div class="stat-card gray" onclick="openCustomerListModal('archive')">
                <h3>Arxiv</h3>
                <p><%= archivedCustomers.length %></p>
            </div>
        </div>
    <% } %>

    <div class="result-list">
        <% results.forEach((item, index) => { 
            const qeydText = (item['Qeyd'] || '').toLowerCase();
            const isArchived = (item['Arxiv'] || '').toLowerCase() === 'hə';
            const typeClass = isArchived ? 'archived' : (qeydText.includes('köç') ? 'kocurme' : 'qosulma');
        %>
            <div class="list-item" onclick="openModal('<%= item['Ödəniş kodu'] %>')">
                <div class="list-main">
                    <div class="name">
                        <%= item['Ad, Soyad, Ata adı'] %>
                        <span class="badge <%= typeClass %>"><%= isArchived ? 'Arxiv' : (typeClass === 'kocurme' ? 'Köçürmə' : 'Qoşulma') %></span>
                    </div>
                    <div style="font-size: 13px; color: var(--muted)">Kod: <%= item['Ödəniş kodu'] %> | Tel: <%= item['Telefon nömrəsi'] %></div>
                </div>
                <i class="fa-solid fa-chevron-right" style="color: var(--muted)"></i>
            </div>
        <% }) %>
    </div>
</div>

<div id="customerModal" class="modal">
    <div class="modal-content">
        <div class="modal-header">
            <h2 id="modalTitle" style="margin:0; font-size:18px;">Müştəri Məlumatı</h2>
            <span class="close-btn" onclick="closeModal('customerModal')">&times;</span>
        </div>
        <div class="modal-body grid" id="modalBody">
            </div>
    </div>
</div>

<div id="customerListModal" class="modal">
    <div class="modal-content" style="max-width: 900px;">
        <div class="modal-header">
            <h2 id="customerListTitle">Siyahı</h2>
            <span class="close-btn" onclick="closeModal('customerListModal')">&times;</span>
        </div>
        <div class="modal-body" id="customerListBody">
            <div class="loading-block">Yüklənir...</div>
        </div>
    </div>
</div>

<script>
const monthlyStats = <%- JSON.stringify(monthlyStats || {}) %>;

function openModal(odemeKodu) {
    const modal = document.getElementById('customerModal');
    const body = document.getElementById('modalBody');
    body.innerHTML = '<p>Yüklənir...</p>';
    modal.classList.add('is-open');
    document.body.classList.add('modal-open');

    fetch(`/customer/${encodeURIComponent(odemeKodu)}`)
        .then(res => res.json())
        .then(json => {
            if (!json.success) throw new Error(json.error);
            const r = json.data;
            const isArchived = (r['Arxiv'] || '').toLowerCase() === 'hə';
            
            let html = `
                <div class="info-item">
                    <label>Ad, Soyad</label>
                    <p>${r['Ad, Soyad, Ata adı'] || '-'}</p>
                </div>
                <div class="info-item">
                    <label>Ödəniş Kodu</label>
                    <p>${r['Ödəniş kodu'] || '-'}</p>
                </div>
                <div class="info-item">
                    <label>Telefon</label>
                    <p>
                        <a href="tel:${r['Telefon nömrəsi']}" style="color:inherit; text-decoration:none;">${r['Telefon nömrəsi']}</a>
                        <a href="https://wa.me/994${r['Telefon nömrəsi']?.replace(/^0/,'')}" target="_blank" class="btn-wa"><i class="fa-brands fa-whatsapp"></i></a>
                    </p>
                </div>
                <div class="info-item">
                    <label>Aylıq Ödəniş</label>
                    <p>${r['Aylıq ödəniş'] || '0'} AZN</p>
                </div>
                <div class="info-item full-width">
                    <label>Ünvan</label>
                    <p>${r['Ünvan'] || '-'}</p>
                </div>
                <div class="info-item full-width">
                    <label>Qeyd</label>
                    <p>${r['Qeyd'] || '-'}</p>
                </div>
                <div class="info-item full-width" style="margin-top:20px; display:flex; gap:10px;">
                    <a href="/edit/${r['Ödəniş kodu']}" class="btn-edit"><i class="fa-solid fa-pen"></i> Redaktə</a>
                    <button class="btn-delete" onclick="deleteCustomer('${r['Ödəniş kodu']}', ${r.rowIndex})"><i class="fa-solid fa-trash"></i> Sil</button>
                </div>
            `;
            body.innerHTML = html;
        })
        .catch(err => {
            body.innerHTML = `<p style="color:red">Xəta: ${err.message}</p>`;
        });
}

function closeModal(id) {
    document.getElementById(id).classList.remove('is-open');
    document.body.classList.remove('modal-open');
}

async function deleteCustomer(odemeKodu, rowIndex) {
    if(!confirm('Bu müştərini silmək istədiyinizə əminsiniz?')) return;
    try {
        const res = await fetch(`/delete/${encodeURIComponent(odemeKodu)}`, {
            method: 'POST',
            headers: {'Content-Type': 'application/json'},
            body: JSON.stringify({rowIndex})
        });
        const json = await res.json();
        if(json.success) { alert('Silindi'); location.reload(); }
        else throw new Error(json.error);
    } catch(err) { alert('Xəta: ' + err.message); }
}

// Esc düyməsi ilə modalları bağlamaq
document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
        closeModal('customerModal');
        closeModal('customerListModal');
    }
});
</script>
</body>
</html>
