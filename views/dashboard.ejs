<!DOCTYPE html>
<html>
   <head>
      <title>Müştəri Panel</title>
      <meta name="viewport" content="width=device-width, initial-scale=1" />
      <link
         rel="stylesheet"
         href="[cdnjs.cloudflare.com](https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css)"
      />
      <script src="[cdn.jsdelivr.net](https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js)"></script>
      <style>
         :root {
            --bg: #0f172a;
            --card: #1e293b;
            --card-soft: #223047;
            --card-glass: rgba(30, 41, 59, 0.82);
            --border: #334155;
            --border-soft: rgba(148, 163, 184, 0.22);
            --green: #10b981;
            --green-dark: #059669;
            --text: #e2e8f0;
            --muted: #94a3b8;
            --muted-2: #cbd5e1;
            --blue: #3b82f6;
            --purple: #8b5cf6;
            --orange: #f59e0b;
            --red: #ef4444;
            --gray: #6b7280;
            --glow: rgba(16, 185, 129, 0.22);
            --z-modal-base: 1000;
            --z-modal-list: 1100;
            --z-modal-chart: 1150;
            --z-modal-detail: 1200;
         }
         * {
            box-sizing: border-box;
         }
         body {
            font-family:
               system-ui,
               -apple-system,
               BlinkMacSystemFont,
               "Segoe UI",
               sans-serif;
            margin: 0;
            background-image: url("[raw.githubusercontent.com](https://raw.githubusercontent.com/AsadAsadov/Selnet/main/home.jpg)");
            background-size: cover;
            background-position: center center;
            background-repeat: no-repeat;
            background-attachment: fixed;
            background-color: #0f172a;
            color: var(--text);
            min-height: 100vh;
         }
         .header {
            background: rgba(15, 23, 42, 0.75);
            backdrop-filter: blur(18px);
            -webkit-backdrop-filter: blur(18px);
            padding: 16px 20px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 10px;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.22);
            border-bottom: 1px solid rgba(255, 255, 255, 0.08);
         }
         .header .logo {
            display: flex;
            align-items: center;
            gap: 10px;
            color: #f8fafc;
         }
         .header h1 {
            margin: 0;
            font-size: 16px;
            font-weight: 800;
            letter-spacing: 0.5px;
         }
         .header .actions {
            display: flex;
            align-items: center;
            gap: 10px;
         }
         .header .actions a {
            text-decoration: none;
            font-weight: 700;
            font-size: 13px;
            padding: 9px 16px;
            border-radius: 14px;
            display: flex;
            align-items: center;
            gap: 6px;
            color: #fff;
            transition: all 0.24s ease;
            box-shadow: 0 8px 24px rgba(0, 0, 0, 0.16);
         }
         .header .actions a:first-child {
            background: rgba(255, 255, 255, 0.14);
            border: 1px solid rgba(255, 255, 255, 0.18);
            color: #f8fafc;
         }
         .header .actions a:first-child:hover {
            background: rgba(255, 255, 255, 0.2);
            transform: translateY(-1px);
         }
         .header .actions a.btn-logout {
            background: rgba(239, 68, 68, 0.94);
            border: 1px solid rgba(220, 38, 38, 0.85);
         }
         .header .actions a.btn-logout:hover {
            background: rgba(220, 38, 38, 0.95);
            box-shadow: 0 8px 28px rgba(239, 68, 68, 0.25);
            transform: translateY(-1px);
         }
         .container {
            padding: 15px;
            max-width: 1000px;
            margin: auto;
         }
         .search-section,
         .card,
         .stat-card,
         .chart-container,
         .list-item,
         .not-found,
         .error {
            box-shadow: 0 14px 30px rgba(0, 0, 0, 0.14);
         }
         .search-section {
            background: rgba(15, 23, 42, 0.55);
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 22px;
            padding: 22px;
            margin-bottom: 20px;
            backdrop-filter: blur(10px);
         }
         .search-filter-section {
            display: flex;
            flex-wrap: wrap;
            gap: 12px;
            align-items: center;
            margin-bottom: 18px;
         }
         .search-box {
            display: flex;
            align-items: center;
            gap: 12px;
            flex: 2 1 420px;
            min-width: 260px;
            padding: 0;
            border: none;
            background: transparent;
         }
         .brand-logo-container {
            display: flex;
            align-items: center;
            justify-content: center;
            background: rgba(255, 255, 255, 0.05);
            backdrop-filter: blur(5px);
            padding: 5px 12px;
            border-radius: 12px;
            border: 1px solid rgba(255, 255, 255, 0.1);
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
            flex-shrink: 0;
         }
         .brand-logo {
            height: 45px;
            width: auto;
            object-fit: contain;
            filter: brightness(0) invert(1);
         }
         .search-wrapper {
            display: flex;
            align-items: center;
            position: relative;
            flex: 1;
            min-width: 0;
         }
         .search-wrapper input {
            width: 100%;
            padding: 12px 14px 12px 44px;
            background: rgba(30, 41, 59, 0.5);
            border: 1px solid var(--border);
            border-radius: 14px;
            color: var(--text);
            font-size: 15px;
            min-width: 0;
            transition: border-color 0.3s ease, box-shadow 0.3s ease, background 0.3s ease;
         }
         .search-icon {
            position: absolute;
            left: 14px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--green);
            pointer-events: none;
            font-size: 16px;
         }
         .search-wrapper input:focus,
         .date-filter input[type="date"]:focus {
            outline: none;
            border-color: var(--green);
            box-shadow: 0 0 10px var(--glow);
         }
         .date-filter {
            display: flex;
            gap: 12px;
            flex: 1 1 320px;
            min-width: 260px;
            align-items: center;
            padding: 0;
            border: none;
            background: transparent;
         }
         .search-box button {
            padding: 12px 20px;
            background: var(--green);
            border: none;
            border-radius: 10px;
            color: #fff;
            font-weight: 800;
            cursor: pointer;
         }
         .search-box button:hover {
            background: var(--green-dark);
         }

         /* === Mobil görünüş üçün düzəlişlər (max-width:768px) === */
         @media (max-width: 768px) {
            .search-filter-section {
               flex-direction: column !important;
               align-items: center !important;
               justify-content: center !important;
               width: 100% !important;
               gap: 14px !important;
            }
            .brand-logo {
               display: block !important;
               margin: 0 auto 16px auto !important;
               height: 38px !important;
            }
            .search-box {
               flex-direction: column !important;
               width: 100% !important;
               gap: 10px !important;
            }
            .search-wrapper input {
               width: 100%;
               height: 42px !important;
               border-radius: 10px !important;
               font-size: 14px !important;
            }
            .search-box button {
               width: 100%;
               height: 42px;
               border-radius: 10px;
               font-size: 14px;
            }
            .date-filter {
               display: grid !important;
               grid-template-columns: repeat(2, 1fr) !important;
               gap: 10px !important;
               width: 100% !important;
            }
            .date-filter input[type="date"] {
               height: 40px !important;
               font-size: 13px !important;
               text-align: center !important;
               border-radius: 8px !important;
            }
            .filter-actions {
               display: flex !important;
               flex-direction: row !important;
               justify-content: center !important;
               width: 100% !important;
               gap: 10px !important;
               margin-top: 14px !important;
            }
            .btn-filter,
            .btn-clear {
               flex: 1;
               height: 42px !important;
               font-size: 14px !important;
            }
         }
      </style>
   </head>
   <body>
      <div class="header">
         <div class="logo">
            <h1>
               <i class="fa-solid fa-database"></i> Müştəri Axtarış Sistemi
            </h1>
         </div>
         <div class="actions">
            <a href="/add"
               ><i class="fa-solid fa-plus"></i><span>Əlavə Et</span></a
            >
            <a href="/logout" class="btn-logout"
               ><i class="fa-solid fa-right-from-bracket"></i
               ><span>Çıxış</span></a
            >
         </div>
      </div>

      <% const dateText = (item) => formatDate(item && item['Timestamp']); const
      getType = (item) => { const qeydText = (item && item['Qeyd'] ||
      '').toLowerCase(); const isArchived = (item && item['Arxiv'] ||
      '').toLowerCase() === 'hə'; const typeClass = isArchived ? 'archived-item'
      : (qeydText.includes('köç') ? 'kocurme' : 'qosulma'); const badgeClass =
      isArchived ? 'archived' : typeClass; const typeLabel = isArchived ?
      'Arxivdə' : (qeydText.includes('köç') ? 'Köçürmə' : 'Qoşulma'); const
      iconClass = isArchived ? 'fa-box-archive' : (typeClass === 'kocurme' ?
      'fa-truck-moving' : 'fa-plug'); return { typeClass, badgeClass, typeLabel,
      iconClass }; }; %>

      <div class="container">
         <div class="search-section">
            <div class="search-filter-section">
               <!-- 🔍 Axtarış qutusu -->
               <form class="search-box" method="GET">
                  <div class="brand-logo-container">
                     <img
                        src="[raw.githubusercontent.com](https://raw.githubusercontent.com/AsadAsadov/Selnet/main/selnet.png)"
                        alt="Selnet"
                        class="brand-logo"
                     />
                  </div>
                  <div class="search-wrapper">
                     <i class="fa-solid fa-magnifying-glass search-icon"></i>
                     <input
                        type="text"
                        name="q"
                        value="<%= q || '' %>"
                        placeholder="Ödəniş kodunu daxil edin"
                     />
                  </div>
                  <button type="submit">
                     <i class="fa-solid fa-magnifying-glass"></i> Axtar
                  </button>
               </form>

               <!-- 📅 Tarix filterləri -->
               <form class="date-filter" method="GET">
                  <input type="hidden" name="q" value="<%= q || '' %>" />
                  <input
                     type="date"
                     name="startDate"
                     value="<%= startDate || '' %>"
                  />
                  <input
                     type="date"
                     name="endDate"
                     value="<%= endDate || '' %>"
                  />
                  <div class="filter-actions">
                     <button type="submit" class="btn-filter">
                        <i class="fa-solid fa-filter"></i> Filter
                     </button>
                     <% if (q || startDate || endDate) { %>
                     <a href="/" class="btn-clear">
                        <i class="fa-solid fa-xmark"></i> Təmizlə
                     </a>
                     <% } %>
                  </div>
               </form>
            </div>
         </div>

         <% if (errorMsg) { %>
         <div class="error">
            <p>
               <i class="fa-solid fa-triangle-exclamation"></i> <%= errorMsg %>
            </p>
         </div>
         <% } else if (q || startDate || endDate) { %>
         <% if (results.length > 0) { %>

         <div class="search-info">
            <% if (q) { %>Axtarış: "<%= q %>" - <% } %> 
            <% if (startDate || endDate) { %>
              Tarix: <%= startDate || '...' %> - <%= endDate || '...' %> - 
            <% } %>
            <%= totalResults %> nəticə tapıldı
         </div>

         <% if (results.length === 1) { %>
         <% const result = results[0];
            const isArchived = (result['Arxiv'] || '').toLowerCase() === 'hə';
         %>

         <% if (isArchived) { %>
         <div class="archive-notice">
            <i class="fa-solid fa-box-archive"></i>
            <span>Bu müştəri arxivdədir</span>
         </div>
         <% } %>

         <div class="card">
            <div class="card-header">
               <h2><%= result['Ad, Soyad, Ata adı'] || 'Adsız müştəri' %></h2>
               <span>Ödəniş kodu: <%= result['Ödəniş kodu'] %> | Qeydiyyat:
                     <%= dateText(result) %></span>
               <div style="margin-top:15px;display:flex;gap:10px;flex-wrap:wrap;">
                  <a href="/edit/<%= result['Ödəniş kodu'] %>" class="btn-edit">
                     <i class="fa-solid fa-pen"></i> Redaktə
                  </a>
                  <button
                     class="btn-delete"
                     onclick="deleteCustomer('<%= result['Ödəniş kodu'] %>', <%= result.rowIndex %>)">
                     <i class="fa-solid fa-trash"></i> Sil
                  </button>
                  <% if (isArchived) { %>
                    <button class="btn-unarchive"
                       onclick="toggleArchive('<%= result['Ödəniş kodu'] %>', <%= result.rowIndex %>, false)">
                       <i class="fa-solid fa-box-open"></i> Arxivdən Çıxart
                    </button>
                  <% } else { %>
                    <button class="btn-archive"
                       onclick="toggleArchive('<%= result['Ödəniş kodu'] %>', <%= result.rowIndex %>, true)">
                       <i class="fa-solid fa-box-archive"></i> Arxivə Göndər
                    </button>
                  <% } %>
               </div>
            </div>
            <div class="card-body">
               <%- include('card-content', {result: result}) %>
            </div>
         </div>

         <% } else { %>

         <!-- 📋 Birdən çox nəticə (siyahı görünüşü) -->
         <div class="result-list" id="searchResults">
            <% results.forEach((item, index) => { const t = getType(item); %>
            <div
               class="list-item <%= t.typeClass %>"
               data-code="<%= item['Ödəniş kodu'] %>"
               data-index="<%= index %>"
               data-list="search"
               role="button"
               tabindex="0"
            >
               <div class="list-main">
                  <div class="list-top">
                     <div class="name list-item-name">
                        <%= item['Ad, Soyad, Ata adı'] || 'Adsız müştəri' %>
                        <span class="badge <%= t.badgeClass %>">
                           <i class="fa-solid <%= t.iconClass %>"></i> <%= t.typeLabel %>
                        </span>
                     </div>
                     <span class="list-date"
                        ><i class="fa-regular fa-calendar"></i> <%= dateText(item) %></span>
                  </div>
                  <div class="meta">
                     <strong>Kod:</strong> <%= item['Ödəniş kodu'] || '-' %> ·
                     <strong>Tel:</strong> <%= item['Telefon nömrəsi'] || '-' %>
                     <% if (item['Ünvan']) { %>
                     · <%= item['Ünvan'] %>
                     <% } %>
                  </div>
               </div>
               <i class="fa-solid fa-chevron-right chevron"></i>
            </div>
            <% }) %>
         </div>

         <!-- 📄 Səhifələmə -->
         <% if (totalPages > 1) { %>
         <div class="pagination">
            <% if (currentPage > 1) { %>
            <a href="/?q=<%= q %>&startDate=<%= startDate %>&endDate=<%= endDate %>&page=<%= currentPage - 1 %>">
               Əvvəlki
            </a>
            <% } %>
            <span style="padding:8px 15px">
               Səhifə <%= currentPage %> / <%= totalPages %>
            </span>
            <% if (currentPage < totalPages) { %>
            <a href="/?q=<%= q %>&startDate=<%= startDate %>&endDate=<%= endDate %>&page=<%= currentPage + 1 %>">
               Növbəti
            </a>
            <% } %>
         </div>
         <% } %>
         <% } %>

         <% } else { %>
         <div class="not-found">
            <p><i class="fa-solid fa-circle-xmark"></i> Nəticə tapılmadı</p>
         </div>
         <% } %>
         <% } else { %>

         <!-- 📊 Statistik kartlar -->
         <div class="stats">
            <div
               class="stat-card purple"
               onclick="openCustomerListModal('all')"
            >
               <h3>Ümumi Müştəri Sayı</h3>
               <p><%= totalCount %></p>
               <span style="font-size: 12px; color: var(--muted)"
                  >Kliklə hamısına bax</span>
            </div>
            <div
               class="stat-card green"
               onclick="openCustomerListModal('today')"
            >
               <h3>Bu gün əlavə olunanlar</h3>
               <p><%= todayCustomers.length %></p>
               <span style="font-size: 12px; color: var(--muted)"
                  >Kliklə siyahıya bax</span>
            </div>
            <div
               class="stat-card gray"
               onclick="openCustomerListModal('archive')"
            >
               <h3>Arxivdə olanlar</h3>
               <p><%= archivedCustomers.length %></p>
               <span style="font-size: 12px; color: var(--muted)"
                  >Kliklə arxivə bax</span>
            </div>
         </div>

         <!-- 📈 Qrafik - Aylıq Qoşulma Statistikası -->
         <div class="chart-container" id="monthlyStatsCard">
            <button
               class="chart-toggle"
               type="button"
               id="chartToggle"
               aria-expanded="false"
               aria-controls="chartPanel"
            >
               <span class="chart-toggle-title"
                  ><i class="fa-solid fa-chart-line"></i> Aylıq Qoşulma Statistikası</span
               >
               <span class="chart-toggle-icon"
                  ><i class="fa-solid fa-chevron-down"></i
               ></span>
            </button>
            <div class="chart-panel" id="chartPanel">
               <div class="chart-inner">
                  <% if (monthlyStats.labels.length > 0) { %>
                  <div class="chart-actions">
                     <button class="btn-expand" onclick="openChartModal()">
                        <i class="fa-solid fa-expand"></i> Böyüt
                     </button>
                  </div>
                  <div class="chart-scroll">
                     <div
                        class="chart-wrapper"
                        style="min-width:<%= Math.max(560, monthlyStats.labels.length * 92) %>px;">
                        <canvas id="monthlyChart"></canvas>
                     </div>
                  </div>
                  <div class="chart-buttons" data-chart-scope="main">
                     <button class="chart-btn active" data-type="total"
                        onclick="updateChart('total','main')">Ümumi</button>
                     <button class="chart-btn green" data-type="qosulma"
                        onclick="updateChart('qosulma','main')">Qoşulma</button>
                     <button class="chart-btn orange" data-type="kocurme"
                        onclick="updateChart('kocurme','main')">Köçürmə</button>
                  </div>
                  <% } else { %>
                  <div class="chart-empty">
                     <i class="fa-regular fa-chart-bar"></i>
                     <strong>Statistika tapılmadı</strong>
                     <span>Chart üçün aylıq məlumat yoxdur.</span>
                  </div>
                  <% } %>
               </div>
            </div>
         </div>

         <% } %>
      </div>

      <!-- 👁️‍🗨️ Müştəri Detal Modal -->
      <div id="customerModal" class="modal" aria-hidden="true">
         <div class="modal-content customer-detail-modal-content">
            <div class="modal-header">
               <h2 id="modalTitle"></h2>
               <div class="modal-controls">
                  <button onclick="navigateModal(-1)" id="prevBtn">
                     <i class="fa-solid fa-chevron-left"></i>
                  </button>
                  <span id="modalCounter" style="color: var(--muted); font-size: 14px"></span>
                  <button onclick="navigateModal(1)" id="nextBtn">
                     <i class="fa-solid fa-chevron-right"></i>
                  </button>
                  <span class="close-btn" onclick="closeModal('customerModal')">&times;</span>
               </div>
            </div>
            <div class="modal-body grid" id="modalBody"></div>
         </div>
      </div>

      <!-- 📊 Chart Modal -->
      <div id="chartModal" class="modal" aria-hidden="true">
         <div class="modal-content large">
            <div class="modal-header">
               <h2>Aylıq Qoşulma Statistikası</h2>
               <span class="close-btn" onclick="closeModal('chartModal')">&times;</span>
            </div>
            <div class="modal-body">
               <% if (monthlyStats.labels.length > 0) { %>
               <div class="chart-scroll">
                  <div class="modal-chart-frame" style="min-width:<%= Math.max(620, monthlyStats.labels.length * 96) %>px;">
                     <canvas id="modalChart"></canvas>
                  </div>
               </div>
               <div class="chart-buttons" data-chart-scope="modal">
                  <button class="chart-btn active" data-type="total"
                     onclick="updateChart('total','modal')">Ümumi</button>
                  <button class="chart-btn green" data-type="qosulma"
                     onclick="updateChart('qosulma','modal')">Qoşulma</button>
                  <button class="chart-btn orange" data-type="kocurme"
                     onclick="updateChart('kocurme','modal')">Köçürmə</button>
               </div>
               <% } else { %>
               <div class="chart-empty">
                  <i class="fa-regular fa-chart-bar"></i>
                  <strong>Statistika tapılmadı</strong>
               </div>
               <% } %>
            </div>
         </div>
      </div>

      <!-- 🧾 Müştəri Siyahısı Modal -->
      <div id="customerListModal" class="modal" aria-hidden="true">
         <div class="modal-content customer-list-modal-content">
            <div class="modal-header customer-list-header">
               <div>
                  <h2 id="customerListTitle">
                     <i class="fa-solid fa-users"></i> Bütün Müştərilər
                     <span class="modal-count-badge" id="customerListCount">0</span>
                  </h2>
                  <p id="customerListSubtitle">Siyahı yüklənir...</p>
               </div>
               <span class="close-btn" onclick="closeModal('customerListModal')">&times;</span>
            </div>

            <div class="customer-modal-search">
               <i class="fa-solid fa-magnifying-glass"></i>
               <input id="customerListSearch" type="search"
                  autocomplete="off"
                  placeholder="Ad, telefon və ya ödəniş kodu üzrə axtar..." />
            </div>

            <div class="modal-body customer-list-body" id="customerListBody">
               <div class="loading-block">
                  <div class="skeleton-list">
                     <div class="skeleton-card"></div>
                     <div class="skeleton-card"></div>
                     <div class="skeleton-card"></div>
                  </div>
               </div>
            </div>
         </div>
      </div>

      <!-- 📜 Skriptlər -->
      <script>
         let currentModalIndex = 0;
         let currentModalList = [];
         let currentModalType = '';
         let mainChart = null;
         let modalChartInstance = null;
         let customerListAbortController = null;
         let modalAbortController = null;
         let modalRequestSeq = 0;
         let mainChartInitialized = false;
         let activeChartType = 'total';
         let customerListState = {
            type: 'all',
            page: 1,
            limit: 10,
            totalPages: 1,
            totalCustomers: 0,
            customers: [],
            filteredCustomers: [],
            search: ''
         };

         const chartData = <%- JSON.stringify(monthlyStats) %>;
         const chartHasData = Array.isArray(chartData.labels) && chartData.labels.length > 0;

         const modalLists = {
            search: <%- JSON.stringify(results.map(r => r['Ödəniş kodu']).filter(Boolean)) %>,
            today: <%- JSON.stringify(todayCustomers.map(r => r['Ödəniş kodu']).filter(Boolean)) %>,
            archive: <%- JSON.stringify(archivedCustomers.map(r => r['Ödəniş kodu']).filter(Boolean)) %>,
            all: []
         };

         const embeddedSearchCustomers = <%- JSON.stringify(results || []) %>;

         const customerListConfig = {
            all: {
               title: 'Bütün Müştərilər',
               icon: 'fa-users',
               endpoint: '/api/all-customers',
               subtitle: 'Bütün müştəri bazası'
            },
            today: {
               title: 'Bu gün əlavə olunanlar',
               icon: 'fa-calendar-day',
               endpoint: '/api/today-customers',
               subtitle: 'Bugünkü aktiv qeydiyyatlar'
            },
            archive: {
               title: 'Arxivdə olanlar',
               icon: 'fa-box-archive',
               endpoint: '/api/archive-customers',
               subtitle: 'Arxiv statuslu müştərilər'
            },
            search: {
               title: 'Axtarış nəticələri',
               icon: 'fa-magnifying-glass',
               endpoint: null,
               subtitle: 'Cari axtarış nəticələri'
            }
         };

         function escapeHtml(value) {
            return String(value ?? '')
               .replace(/&/g, '&amp;')
               .replace(/</g, '&lt;')
               .replace(/>/g, '&gt;')
               .replace(/"/g, '&quot;')
               .replace(/'/g, '&#039;');
         }

         function formatDate(timestamp) {
            if (!timestamp) return 'Tarix yoxdur';
            const raw = String(timestamp).trim();
            const iso = raw.match(/^(\d{4})-(\d{1,2})-(\d{1,2})/);
            if (iso)
               return `${iso[3].padStart(2, '0')}.${iso[2].padStart(2, '0')}.${iso[1]}`;
            const parsed = new Date(raw);
            if (!Number.isNaN(parsed.getTime()))
               return `${String(parsed.getDate()).padStart(2, '0')}.${String(parsed.getMonth() + 1).padStart(2, '0')}.${parsed.getFullYear()}`;
            return 'Tarix yoxdur';
         }

         function getCustomerType(item) {
            const qeydText = String(item?.['Qeyd'] || '').toLowerCase();
            const isArchived = String(item?.['Arxiv'] || '').toLowerCase() === 'hə';
            const typeClass = isArchived
               ? 'archived-item'
               : qeydText.includes('köç')
               ? 'kocurme'
               : 'qosulma';
            const badgeClass = isArchived ? 'archived' : typeClass;
            const typeLabel = isArchived
               ? 'Arxivdə'
               : qeydText.includes('köç')
               ? 'Köçürmə'
               : 'Qoşulma';
            const iconClass = isArchived
               ? 'fa-box-archive'
               : typeClass === 'kocurme'
               ? 'fa-truck-moving'
               : 'fa-plug';
            return { typeClass, badgeClass, typeLabel, iconClass };
         }

         function createBadge(type) {
            return `<span class="badge ${type.badgeClass}">
               <i class="fa-solid ${type.iconClass}"></i> ${escapeHtml(type.typeLabel)}</span>`;
         }

         function debounce(fn, wait = 180) {
            let t;
            return (...args) => {
               clearTimeout(t);
               t = setTimeout(() => fn(...args), wait);
            };
         }

         /* ███ CHART FUNKSİYALARI ███ */

         function chartConfig(type = 'total') {
            const colors = {
               total: { bg: 'rgba(59,130,246,.46)', border: '#3b82f6' },
               qosulma: { bg: 'rgba(16,185,129,.52)', border: '#10b981' },
               kocurme: { bg: 'rgba(245,158,11,.55)', border: '#f59e0b' }
            };
            const labels = {
               total: 'Ümumi',
               qosulma: 'Qoşulma',
               kocurme: 'Köçürmə'
            };
            return { label: labels[type], color: colors[type] };
         }

         function buildChart(ctx, type = 'total') {
            const cfg = chartConfig(type);
            return new Chart(ctx, {
               type: 'bar',
               data: {
                  labels: chartData.labels,
                  datasets: [
                     {
                        label: cfg.label,
                        data: chartData[type],
                        backgroundColor: cfg.color.bg,
                        borderColor: cfg.color.border,
                        borderWidth: 2,
                        borderRadius: 8
                     }
                  ]
               },
               options: {
                  responsive: true,
                  maintainAspectRatio: false,
                  plugins: { legend: { labels: { color: '#e2e8f0' } } },
                  scales: {
                     y: {
                        beginAtZero: true,
                        ticks: { color: '#94a3b8' },
                        grid: { color: 'rgba(51,65,85,.7)' }
                     },
                     x: {
                        ticks: { color: '#cbd5e1' },
                        grid: { color: 'rgba(51,65,85,.45)' }
                     }
                  }
               }
            });
         }

         function initChart() {
            if (!chartHasData || mainChartInitialized) return;
            const ctx = document.getElementById('monthlyChart');
            if (!ctx) return;
            mainChart = buildChart(ctx, activeChartType);
            mainChartInitialized = true;
         }

         function openChartModal() {
            setModalOpen('chartModal', true);
            if (chartHasData && !modalChartInstance) {
               const ctx = document.getElementById('modalChart');
               if (ctx) modalChartInstance = buildChart(ctx, activeChartType);
            }
         }

         function updateChart(type, scope = 'main') {
            activeChartType = type;
            const cfg = chartConfig(type);
            [mainChart, modalChartInstance]
               .filter(Boolean)
               .forEach(chart => {
                  chart.data.datasets[0].label = cfg.label;
                  chart.data.datasets[0].data = chartData[type] || [];
                  chart.data.datasets[0].backgroundColor = cfg.color.bg;
                  chart.data.datasets[0].borderColor = cfg.color.border;
                  chart.update();
               });
         }

         /* ███ MODAL FUNKSİYALARI ███ */

         function setModalOpen(id, open) {
            const el = document.getElementById(id);
            if (!el) return;
            el.classList.toggle('is-open', open);
            el.setAttribute('aria-hidden', !open);
            document.body.classList.toggle('modal-open', open);
         }

         function closeModal(id) {
            setModalOpen(id, false);
         }

         function navigateModal(direction) {
            const newIndex = currentModalIndex + direction;
            if (newIndex >= 0 && newIndex < currentModalList.length) {
               currentModalIndex = newIndex;
               loadModalCustomer(currentModalList[newIndex]);
            }
         }

         /* ███ MÜŞTƏRİ DETAL MODALI ███ */
         async function loadModalCustomer(code){
            const body=document.getElementById('modalBody');
            const title=document.getElementById('modalTitle');
            const counter=document.getElementById('modalCounter');
            const prevBtn=document.getElementById('prevBtn');
            const nextBtn=document.getElementById('nextBtn');
            if(!body||!title)return;
            setModalOpen('customerModal',true);
            body.innerHTML=`<div class="loader-inline"><span class="spinner"></span>Məlumat yüklənir...</div>`;
            title.textContent='Müştəri məlumatı';
            counter.textContent=currentModalList.length?`${currentModalIndex+1} / ${currentModalList.length}`:'';
            prevBtn.disabled=currentModalIndex<=0;
            nextBtn.disabled=currentModalIndex>=currentModalList.length-1;

            try{
               const res=await fetch(`/customer/${encodeURIComponent(code)}`,{headers:{Accept:'application/json'}});
               const json=await res.json();
               if(!res.ok||!json.success)throw new Error(json.error||'Xəta');
               const r=json.data;
               const isArchived=(r['Arxiv']||'').toLowerCase()==='hə';
               title.innerHTML=`${escapeHtml(r['Ad, Soyad, Ata adı']||'Adsız')}
                  ${isArchived?'<span class="badge archived"><i class="fa-solid fa-box-archive"></i> Arxivdə</span>':''}`;
               let html='';
               const fields=[
                  { key:'Ödəniş kodu', label:'Ödəniş Kodu' },
                  { key:'Telefon nömrəsi', label:'Telefon', type:'tel' },
                  { key:'Aylıq ödəniş', label:'Aylıq Ödəniş', suffix:' AZN' },
                  { key:'Ünvan', label:'Ünvan', full:true },
                  { key:'Qeyd', label:'Qeyd', full:true }
               ];
               fields.forEach(f=>{
                  let val=r[f.key];
                  if(val&&String(val).trim()!==''){
                     html+=`<div class="info-item ${f.full?'full-width':''}">
                        <label>${f.label}</label><p class="info-text">${escapeHtml(val)}${f.suffix||''}</p></div>`;
                  }
               });
               body.innerHTML=html;
            }catch(e){
               body.innerHTML=`<div class="not-found"><p><i class="fa-solid fa-triangle-exclamation"></i> ${escapeHtml(e.message)}</p></div>`;
            }
         }

         /* ███ CRUD ƏMƏLİYYATLARI ███ */
         async function postJson(url,body){
            const r=await fetch(url,{
               method:'POST',
               headers:{'Content-Type':'application/json'},
               body:JSON.stringify(body)
            });
            const j=await r.json();
            if(!r.ok||!j.success)throw new Error(j.error||'Xəta');
            return j;
         }

         async function deleteCustomer(code,row){
            if(!confirm(`${code} kodlu müştərini silmək istəyirsiniz?`))return;
            try{
               await postJson(`/delete/${encodeURIComponent(code)}`,{rowIndex:row});
               alert('Müştəri silindi');
               location.reload();
            }catch(e){alert('Xəta: '+e.message);}
         }

         async function toggleArchive(code,row,archive){
            const txt=archive?'arxivə göndərmək':'arxivdən çıxartmaq';
            if(!confirm(`${code} kodlu müştərini ${txt} istəyirsiniz?`))return;
            try{
               await postJson(`/archive/${encodeURIComponent(code)}`,{rowIndex:row,archive});
               alert(archive?'Müştəri arxivə göndərildi':'Müştəri arxivdən çıxarıldı');
               location.reload();
            }catch(e){alert('Xəta: '+e.message);}
         }

         /* ███ HADİSƏ DİNLƏYİCİLƏR ███ */
         document.addEventListener('click',e=>{
            const el=e.target.closest('.list-item[data-code]');
            if(el){
               openModal(el.dataset.code,Number(el.dataset.index||0),'search');
               return;
            }
            if(e.target.classList.contains('modal'))closeModal(e.target.id);
         });

         document.addEventListener('keydown',e=>{
            if(e.key==='Escape'){
               ['customerModal','chartModal','customerListModal']
               .forEach(id=>{
                  if(document.getElementById(id)?.classList.contains('is-open'))
                     closeModal(id);
               });
            }
            if(e.key==='ArrowLeft')navigateModal(-1);
            if(e.key==='ArrowRight')navigateModal(1);
         });

         document.addEventListener('DOMContentLoaded',()=>{
            initChart();
         });
      </script>
   </body>
</html>
