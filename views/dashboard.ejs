												if (ctx) modalChartInstance = buildChart(ctx, activeChartType);
											});
										} else if (modalChartInstance) {
											setTimeout(() => modalChartInstance.resize(), 120);
										}
									}

									function updateChart(type, scope = 'main') {
										if (!chartData[type]) return;
										activeChartType = type;
										const cfg = chartConfig(type);
										['main', 'modal'].forEach(syncScope => syncChartButtons(syncScope, type));
										[mainChart, modalChartInstance].filter(Boolean).forEach(chart => {
											chart.data.datasets[0].label = cfg.label;
											chart.data.datasets[0].data = chartData[type] || [];
											chart.data.datasets[0].backgroundColor = cfg.color.bg;
											chart.data.datasets[0].borderColor = cfg.color.border;
											chart.update('active');
										});
									}

									function updateCustomerListHeader() {
										const cfg = customerListConfig[customerListState.type] || customerListConfig.all;
										const title = document.getElementById('customerListTitle');
										const count = document.getElementById('customerListCount');
										const subtitle = document.getElementById('customerListSubtitle');
										if (title) title.innerHTML = `<i class="fa-solid ${cfg.icon}"></i> ${escapeHtml(cfg.title)} <span class="modal-count-badge" id="customerListCount">${Number(customerListState.totalCustomers)||0}</span>`;
										if (count) count.textContent = Number(customerListState.totalCustomers) || 0;
										if (subtitle) subtitle.textContent = `${cfg.subtitle} · Səhifə ${customerListState.page} / ${customerListState.totalPages}`;
									}

									function setCustomerListSearchValue(value = '') {
										const input = document.getElementById('customerListSearch');
