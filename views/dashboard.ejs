<!DOCTYPE html><html><head>
<title>Müştəri Panel</title><meta name="viewport" content="width=device-width, initial-scale=1">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<style>
:root{--bg:#0f172a;--card:#1e293b;--card-soft:#223047;--card-glass:rgba(30,41,59,.82);--border:#334155;--border-soft:rgba(148,163,184,.22);--green:#10b981;--green-dark:#059669;--text:#e2e8f0;--muted:#94a3b8;--muted-2:#cbd5e1;--blue:#3b82f6;--purple:#8b5cf6;--orange:#f59e0b;--red:#ef4444;--gray:#6b7280;--glow:rgba(16,185,129,.22)}
*{box-sizing:border-box}body{font-family:system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;margin:0;background:radial-gradient(circle at top,#13203a 0,var(--bg) 45%);color:var(--text);min-height:100vh}.header{background:linear-gradient(90deg,#047857,#10b981);padding:12px 16px;display:flex;justify-content:space-between;align-items:center;gap:10px;box-shadow:0 12px 30px rgba(0,0,0,.22)}.header .logo{display:flex;align-items:center;gap:8px;color:#fff}.header h1{margin:0;font-size:16px;font-weight:800;letter-spacing:.5px}.header .actions{display:flex;align-items:center;gap:8px}.header .actions a{text-decoration:none;font-weight:700;font-size:13px;padding:8px 14px;border-radius:10px;display:flex;align-items:center;gap:6px;color:#fff;transition:all .2s ease;box-shadow:0 2px 8px rgba(0,0,0,.14)}.header .actions a:first-child{background:rgba(255,255,255,.2);border:1px solid rgba(255,255,255,.32)}.header .actions a:first-child:hover{background:rgba(255,255,255,.3);transform:translateY(-1px)}.header .actions a.btn-logout{background:#ef4444;border:1px solid #dc2626}.header .actions a.btn-logout:hover{background:#dc2626;box-shadow:0 4px 14px rgba(239,68,68,.3);transform:translateY(-1px)}.container{padding:15px;max-width:1000px;margin:auto}.search-section,.card,.stat-card,.chart-container,.list-item,.not-found,.error{box-shadow:0 14px 30px rgba(0,0,0,.14)}.search-section{background:linear-gradient(180deg,var(--card),rgba(30,41,59,.92));border:1px solid var(--border-soft);border-radius:16px;padding:15px;margin-bottom:20px}.search-box{display:flex;gap:10px;margin-bottom:12px}.search-box input{flex:1;padding:12px;background:rgba(15,23,42,.88);border:1px solid var(--border);border-radius:10px;color:var(--text);font-size:15px;min-width:0}.search-box input:focus,.date-filter input[type="date"]:focus{outline:none;border-color:var(--green);box-shadow:0 0 0 3px rgba(16,185,129,.12)}.search-box button{padding:12px 20px;background:var(--green);border:none;border-radius:10px;color:#fff;font-weight:800;cursor:pointer;white-space:nowrap}.search-box button:hover{background:var(--green-dark)}.date-filter{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px;align-items:center;width:100%}.date-filter label{font-size:13px;color:var(--muted-2);grid-column:1/-1;margin-bottom:2px;display:flex;align-items:center;gap:6px}.date-filter input[type="date"]{padding:10px 5px;background:rgba(15,23,42,.88);border:1px solid var(--border);border-radius:10px;color:var(--text);font-size:13px;width:100%;text-align:center;min-width:0}.filter-actions{display:flex;flex-direction:column;gap:10px;grid-column:1/-1;margin-top:4px;width:100%}.btn-filter,.btn-clear{width:100%;justify-content:center}.btn-filter{padding:10px 15px;background:var(--green);border:none;border-radius:10px;color:#fff;cursor:pointer;font-weight:700;white-space:nowrap}.btn-filter:hover{background:var(--green-dark)}.btn-clear{display:inline-flex;align-items:center;gap:6px;padding:10px 15px;background:var(--border);border-radius:10px;color:var(--text);text-decoration:none;font-size:14px;white-space:nowrap}.search-info{color:var(--muted-2);font-size:14px;margin-bottom:20px}.stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:15px;margin-bottom:18px}.stat-card{background:linear-gradient(180deg,var(--card),rgba(30,41,59,.86));border:1px solid var(--border-soft);padding:20px;border-radius:16px;cursor:pointer;transition:all .22s ease;position:relative;overflow:hidden}.stat-card:before{content:"";position:absolute;inset:0;background:radial-gradient(circle at right top,rgba(255,255,255,.08),transparent 40%);pointer-events:none}.stat-card:hover{border-color:var(--green);transform:translateY(-2px);box-shadow:0 18px 38px rgba(0,0,0,.22),0 0 22px var(--glow)}.stat-card h3{margin:0 0 5px;color:var(--muted-2);font-size:14px;font-weight:600}.stat-card p{margin:0;font-size:28px;font-weight:900}.stat-card.blue{border-left:4px solid var(--blue)}.stat-card.green{border-left:4px solid var(--green)}.stat-card.purple{border-left:4px solid var(--purple)}.stat-card.gray{border-left:4px solid var(--gray)}.chart-container{background:linear-gradient(180deg,var(--card),rgba(30,41,59,.88));border:1px solid var(--border-soft);border-radius:16px;margin-bottom:25px;overflow:hidden}.chart-toggle{width:100%;background:transparent;border:none;color:var(--text);padding:16px 18px;display:flex;justify-content:space-between;align-items:center;gap:15px;cursor:pointer;text-align:left}.chart-toggle:hover{background:rgba(16,185,129,.07)}.chart-toggle-title{display:flex;align-items:center;gap:10px;font-size:18px;font-weight:800}.chart-toggle-icon{width:34px;height:34px;border-radius:10px;background:rgba(15,23,42,.78);border:1px solid var(--border-soft);display:inline-flex;align-items:center;justify-content:center;transition:transform .25s ease,color .25s ease;color:var(--muted-2)}.chart-container.is-open .chart-toggle-icon{transform:rotate(180deg);color:var(--green)}.chart-panel{max-height:0;opacity:0;overflow:hidden;transition:max-height .42s ease,opacity .28s ease}.chart-container.is-open .chart-panel{max-height:520px;opacity:1}.chart-inner{padding:0 18px 18px}.chart-actions{display:flex;justify-content:flex-end;margin-bottom:10px}.btn-expand{background:var(--border);border:none;color:var(--text);padding:8px 12px;border-radius:8px;cursor:pointer;font-size:13px}.btn-expand:hover{background:var(--green)}.chart-wrapper{height:300px;position:relative}.chart-empty{height:220px;border:1px dashed var(--border);border-radius:14px;display:flex;flex-direction:column;align-items:center;justify-content:center;color:var(--muted);gap:10px;background:rgba(15,23,42,.35)}.chart-empty i{font-size:34px;color:var(--muted)}.chart-buttons{display:flex;gap:8px;margin-top:15px;flex-wrap:wrap}.chart-btn{padding:8px 16px;background:var(--border);border:none;border-radius:8px;color:var(--text);cursor:pointer;font-size:14px;font-weight:700}.chart-btn:hover{box-shadow:0 0 0 3px rgba(16,185,129,.12)}.chart-btn.active{background:var(--green)}.chart-btn.orange.active{background:var(--orange)}.chart-btn.blue.active{background:var(--blue)}.card{background:var(--card);border:1px solid var(--border-soft);border-radius:16px;overflow:hidden;margin-bottom:20px}.card-header{padding:20px;border-bottom:1px solid var(--border-soft)}.card-header h2{margin:0 0 5px;font-size:22px}.card-header span{color:var(--muted);font-size:14px}.card-body{padding:20px;display:grid;grid-template-columns:1fr 1fr;gap:20px}.info-item label{font-size:12px;color:var(--muted);display:block;margin-bottom:5px;text-transform:uppercase;letter-spacing:.04em}.info-item p{margin:0;font-size:16px;font-weight:600;word-break:break-word;display:flex;align-items:center;gap:10px;flex-wrap:wrap}.info-item a{color:var(--green);text-decoration:none;font-weight:800;cursor:pointer}.full-width{grid-column:1/-1}.section-title{font-size:18px;margin:25px 0 15px;color:var(--text);display:flex;align-items:center;gap:10px}.result-list,.compact-list{display:grid;gap:10px}.list-item{background:linear-gradient(180deg,var(--card),rgba(30,41,59,.9));border:1px solid var(--border-soft);padding:12px 14px;border-radius:14px;margin-bottom:10px;display:flex;justify-content:space-between;align-items:center;gap:12px;cursor:pointer;transition:transform .2s ease,border-color .2s ease,box-shadow .2s ease,background .2s ease;position:relative;overflow:hidden}.result-list .list-item{padding:14px 15px}.list-item:hover{border-color:rgba(16,185,129,.82);background:#273549;transform:translateX(5px);box-shadow:0 10px 26px rgba(0,0,0,.18),0 0 18px rgba(16,185,129,.16)}.list-item .chevron{color:var(--muted);transition:transform .2s ease,color .2s ease}.list-item:hover .chevron{transform:translateX(4px);color:var(--green)}.list-main{min-width:0;flex:1}.list-top{display:flex;align-items:center;gap:8px;justify-content:space-between;min-width:0}.list-item .name{font-weight:850;color:#f8fafc;font-size:15px;line-height:1.25;min-width:0}.list-item-name{display:flex;align-items:center;flex-wrap:wrap;gap:6px}.meta{font-size:13px;color:var(--muted);margin-top:5px;line-height:1.4}.meta strong{color:var(--muted-2);font-weight:700}.list-date{font-size:11px;color:#d1fae5;background:rgba(16,185,129,.13);border:1px solid rgba(16,185,129,.28);border-radius:999px;padding:4px 8px;white-space:nowrap;font-weight:800}.list-item.kocurme .list-date{color:#ffedd5;background:rgba(245,158,11,.13);border-color:rgba(245,158,11,.3)}.list-item.archived-item .list-date{color:#d1d5db;background:rgba(107,114,128,.16);border-color:rgba(107,114,128,.32)}.list-item.qosulma{border-left:4px solid var(--green)}.list-item.kocurme{border-left:4px solid var(--orange)}.list-item.archived-item{border-left:4px solid var(--gray);opacity:.84}.badge{display:inline-flex;align-items:center;gap:5px;padding:4px 9px;border-radius:999px;font-size:11px;font-weight:850;letter-spacing:.01em;border:1px solid transparent}.badge.qosulma{background:linear-gradient(135deg,rgba(16,185,129,.24),rgba(16,185,129,.09));color:#6ee7b7;border-color:rgba(16,185,129,.28)}.badge.kocurme{background:linear-gradient(135deg,rgba(245,158,11,.24),rgba(245,158,11,.08));color:#fbbf24;border-color:rgba(245,158,11,.3)}.badge.archived{background:linear-gradient(135deg,rgba(107,114,128,.25),rgba(107,114,128,.08));color:#d1d5db;border-color:rgba(107,114,128,.34)}.pagination{display:flex;gap:10px;justify-content:center;margin-top:20px;flex-wrap:wrap}.pagination a,.pagination button{padding:8px 15px;background:var(--card);border:1px solid var(--border);border-radius:8px;color:var(--text);text-decoration:none;cursor:pointer}.pagination a.active{background:var(--green);border-color:var(--green)}.not-found,.error{text-align:center;padding:40px;color:var(--muted);background:var(--card);border:1px solid var(--border-soft);border-radius:16px}.error{color:#fca5a5}.archive-notice{background:rgba(107,114,128,.15);border:1px solid var(--gray);padding:10px 15px;border-radius:10px;margin-bottom:15px;display:flex;align-items:center;gap:10px;color:var(--muted-2)}.modal{display:none;position:fixed;z-index:1000;left:0;top:0;width:100%;height:100%;background:rgba(2,6,23,.78);align-items:center;justify-content:center;backdrop-filter:blur(10px);padding:14px}.modal.is-open{display:flex}.modal-content{background:linear-gradient(180deg,var(--card-glass),rgba(15,23,42,.9));border:1px solid rgba(148,163,184,.24);border-radius:20px;width:90%;max-width:760px;max-height:90vh;overflow-y:auto;box-shadow:0 30px 80px rgba(0,0,0,.5),inset 0 1px 0 rgba(255,255,255,.06);animation:modalScale .26s ease;scrollbar-width:thin;scrollbar-color:rgba(16,185,129,.65) rgba(15,23,42,.65)}.modal-content::-webkit-scrollbar{width:10px}.modal-content::-webkit-scrollbar-track{background:rgba(15,23,42,.65);border-radius:20px}.modal-content::-webkit-scrollbar-thumb{background:linear-gradient(180deg,var(--green),#047857);border-radius:20px;border:2px solid rgba(15,23,42,.65)}.modal-content.large{max-width:1000px}@keyframes modalScale{from{transform:scale(.94) translateY(16px);opacity:0}to{transform:scale(1) translateY(0);opacity:1}}.modal-header{padding:18px 20px;border-bottom:1px solid var(--border-soft);display:flex;justify-content:space-between;align-items:center;position:sticky;top:0;background:rgba(30,41,59,.92);backdrop-filter:blur(14px);z-index:10;gap:15px}.modal-header h2{margin:0;font-size:20px;flex:1}.modal-controls{display:flex;gap:10px;align-items:center;white-space:nowrap}.modal-controls button{background:var(--border);border:none;color:var(--text);padding:8px 12px;border-radius:8px;cursor:pointer;font-size:16px}.modal-controls button:hover{background:var(--green)}.modal-controls button:disabled{opacity:.35;cursor:not-allowed}.close-btn{font-size:30px;cursor:pointer;color:var(--muted);line-height:1;transition:color .2s ease,transform .2s ease}.close-btn:hover{color:#fff;transform:rotate(90deg)}.modal-body{padding:20px}.modal-body.grid{display:grid;grid-template-columns:1fr 1fr;gap:20px}.all-customers-toolbar{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:14px;color:var(--muted);font-size:13px}.loading-block{padding:22px}.skeleton-list{display:grid;gap:12px}.skeleton-card{height:68px;border-radius:14px;background:linear-gradient(90deg,rgba(51,65,85,.45) 25%,rgba(100,116,139,.42) 37%,rgba(51,65,85,.45) 63%);background-size:400% 100%;animation:shimmer 1.25s ease infinite;border:1px solid var(--border-soft)}.loader-inline{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:12px;padding:42px;color:var(--muted)}.spinner{width:34px;height:34px;border:3px solid rgba(148,163,184,.25);border-top-color:var(--green);border-radius:50%;animation:spin .8s linear infinite}.spinner.small{width:20px;height:20px;border-width:2px}@keyframes shimmer{0%{background-position:100% 0}100%{background-position:0 0}}@keyframes spin{to{transform:rotate(360deg)}}.btn-wa{display:inline-flex;align-items:center;gap:6px;padding:6px 12px;background:#25D366;color:#fff!important;border-radius:8px;text-decoration:none;font-weight:700;font-size:14px}.btn-wa:hover{background:#1da851}.btn-edit,.btn-delete,.btn-archive,.btn-unarchive{padding:8px 14px;border:none;border-radius:8px;color:#fff;cursor:pointer;font-weight:700;font-size:14px;text-decoration:none;display:inline-flex;align-items:center;gap:6px}.btn-edit{background:var(--blue)}.btn-edit:hover{background:#2563eb}.btn-delete{background:var(--red)}.btn-delete:hover{background:#dc2626}.btn-archive{background:var(--gray)}.btn-archive:hover{background:#4b5563}.btn-unarchive{background:var(--green)}.btn-unarchive:hover{background:var(--green-dark)}.btn-image{display:inline-flex;align-items:center;gap:6px;padding:6px 12px;background:var(--blue);color:#fff!important;border-radius:8px;text-decoration:none;font-weight:700;font-size:14px;cursor:pointer;border:none}.btn-image:hover{background:#2563eb}.hidden{display:none!important}@media (max-width:600px){.container{padding:12px}.card-body,.modal-body.grid,.stats{grid-template-columns:1fr}.search-box{flex-direction:column}.chart-wrapper{height:250px}.modal{padding:8px}.modal-content{width:100%;max-height:94vh;border-radius:16px}.modal-header{padding:14px;align-items:flex-start}.modal-header h2{font-size:17px}.modal-controls{gap:6px}.modal-controls button{padding:7px 9px}.modal-body{padding:14px}.list-item{align-items:flex-start}.list-top{align-items:flex-start;flex-direction:column}.list-date{align-self:flex-start}.chevron{margin-top:4px}.all-customers-toolbar{flex-direction:column;align-items:flex-start}.chart-toggle-title{font-size:16px}.header h1{font-size:14px}.header .actions a{padding:7px 10px;font-size:12px}.header .actions a span{display:none}}@media (max-width:400px){.date-filter{grid-template-columns:1fr}.chart-container.is-open .chart-panel{max-height:620px}}
</style></head><body>

<div class="header">
  <div class="logo"><h1><i class="fa-solid fa-database"></i> Müştəri Axtarış Sistemi</h1></div>
  <div class="actions">
    <a href="/add"><i class="fa-solid fa-plus"></i><span>Əlavə Et</span></a>
    <a href="/logout" class="btn-logout"><i class="fa-solid fa-right-from-bracket"></i><span>Çıxış</span></a>
  </div>
</div>

<%
  const dateText = (item) => formatDate(item && item['Timestamp']);
  const getType = (item) => {
    const qeydText = (item && item['Qeyd'] || '').toLowerCase();
    const isArchived = (item && item['Arxiv'] || '').toLowerCase() === 'hə';
    const typeClass = isArchived ? 'archived-item' : (qeydText.includes('köç') ? 'kocurme' : 'qosulma');
    const badgeClass = isArchived ? 'archived' : typeClass;
    const typeLabel = isArchived ? 'Arxivdə' : (qeydText.includes('köç') ? 'Köçürmə' : 'Qoşulma');
    const iconClass = isArchived ? 'fa-box-archive' : (typeClass === 'kocurme' ? 'fa-truck-moving' : 'fa-plug');
    return { typeClass, badgeClass, typeLabel, iconClass };
  };
%>

<div class="container">
  <div class="search-section">
    <form class="search-box" method="GET">
      <input type="text" name="q" value="<%= q || '' %>" placeholder="Ödəniş kodu, Telefon, Ad və ya Ünvan...">
      <button type="submit"><i class="fa-solid fa-magnifying-glass"></i> Axtar</button>
    </form>
    <form class="date-filter" method="GET">
      <input type="hidden" name="q" value="<%= q || '' %>">
      <label><i class="fa-solid fa-calendar"></i> Tarix:</label>
      <input type="date" name="startDate" value="<%= startDate || '' %>">
      <input type="date" name="endDate" value="<%= endDate || '' %>">
      <div class="filter-actions">
        <button type="submit" class="btn-filter"><i class="fa-solid fa-filter"></i> Filter</button>
        <% if (q || startDate || endDate) { %><a href="/" class="btn-clear"><i class="fa-solid fa-xmark"></i> Təmizlə</a><% } %>
      </div>
    </form>
  </div>

  <% if (errorMsg) { %>
    <div class="error"><p><i class="fa-solid fa-triangle-exclamation"></i> <%= errorMsg %></p></div>
  <% } else if (q || startDate || endDate) { %>
    <% if (results.length > 0) { %>
      <div class="search-info">
        <% if (q) { %>Axtarış: "<%= q %>" - <% } %>
        <% if (startDate || endDate) { %>Tarix: <%= startDate || '...' %> - <%= endDate || '...' %> - <% } %>
        <%= totalResults %> nəticə tapıldı
      </div>

      <% if (results.length === 1) { %>
        <% const result = results[0]; const isArchived = (result['Arxiv'] || '').toLowerCase() === 'hə'; %>
        <% if (isArchived) { %><div class="archive-notice"><i class="fa-solid fa-box-archive"></i><span>Bu müştəri arxivdədir</span></div><% } %>
        <div class="card">
          <div class="card-header">
            <h2><%= result['Ad, Soyad, Ata adı'] || 'Adsız müştəri' %></h2>
            <span>Ödəniş kodu: <%= result['Ödəniş kodu'] %> | Qeydiyyat: <%= dateText(result) %></span>
            <div style="margin-top:15px;display:flex;gap:10px;flex-wrap:wrap">
              <a href="/edit/<%= result['Ödəniş kodu'] %>" class="btn-edit"><i class="fa-solid fa-pen"></i> Redaktə</a>
              <button class="btn-delete" onclick="deleteCustomer('<%= result['Ödəniş kodu'] %>', <%= result.rowIndex %>)"><i class="fa-solid fa-trash"></i> Sil</button>
              <% if (isArchived) { %><button class="btn-unarchive" onclick="toggleArchive('<%= result['Ödəniş kodu'] %>', <%= result.rowIndex %>, false)"><i class="fa-solid fa-box-open"></i> Arxivdən Çıxart</button><% } else { %><button class="btn-archive" onclick="toggleArchive('<%= result['Ödəniş kodu'] %>', <%= result.rowIndex %>, true)"><i class="fa-solid fa-box-archive"></i> Arxivə Göndər</button><% } %>
            </div>
          </div>
          <div class="card-body"><%- include('card-content', {result: result}) %></div>
        </div>
      <% } else { %>
        <div class="result-list" id="searchResults">
          <% results.forEach((item, index) => { const t = getType(item); %>
            <div class="list-item <%= t.typeClass %>" data-code="<%= item['Ödəniş kodu'] %>" data-index="<%= index %>" data-list="search" role="button" tabindex="0">
              <div class="list-main">
                <div class="list-top">
                  <div class="name list-item-name"><%= item['Ad, Soyad, Ata adı'] || 'Adsız müştəri' %><span class="badge <%= t.badgeClass %>"><i class="fa-solid <%= t.iconClass %>"></i> <%= t.typeLabel %></span></div>
                  <span class="list-date"><i class="fa-regular fa-calendar"></i> <%= dateText(item) %></span>
                </div>
                <div class="meta"><strong>Kod:</strong> <%= item['Ödəniş kodu'] || '-' %> · <strong>Tel:</strong> <%= item['Telefon nömrəsi'] || '-' %> <% if (item['Ünvan']) { %> · <%= item['Ünvan'] %><% } %></div>
              </div>
              <i class="fa-solid fa-chevron-right chevron"></i>
            </div>
          <% }) %>
        </div>
        <% if (totalPages > 1) { %>
          <div class="pagination">
            <% if (currentPage > 1) { %><a href="/?q=<%= q %>&startDate=<%= startDate %>&endDate=<%= endDate %>&page=<%= currentPage - 1 %>">Əvvəlki</a><% } %>
            <span style="padding:8px 15px">Səhifə <%= currentPage %> / <%= totalPages %></span>
            <% if (currentPage < totalPages) { %><a href="/?q=<%= q %>&startDate=<%= startDate %>&endDate=<%= endDate %>&page=<%= currentPage + 1 %>">Növbəti</a><% } %>
          </div>
        <% } %>
      <% } %>
    <% } else { %><div class="not-found"><p><i class="fa-solid fa-circle-xmark"></i> Nəticə tapılmadı</p></div><% } %>
  <% } else { %>
    <div class="stats">
      <div class="stat-card purple" onclick="openAllCustomersModal()"><h3>Ümumi Müştəri Sayı</h3><p><%= totalCount %></p><span style="font-size:12px;color:var(--muted)">Kliklə hamısına bax</span></div>
      <div class="stat-card green" onclick="showTodayList()"><h3>Bu gün əlavə olunanlar</h3><p><%= todayCustomers.length %></p><span style="font-size:12px;color:var(--muted)">Kliklə siyahıya bax</span></div>
      <div class="stat-card gray" onclick="showArchiveList()"><h3>Arxivdə olanlar</h3><p><%= archivedCustomers.length %></p><span style="font-size:12px;color:var(--muted)">Kliklə arxivə bax</span></div>
    </div>

    <div class="chart-container" id="monthlyStatsCard">
      <button class="chart-toggle" type="button" id="chartToggle" aria-expanded="false" aria-controls="chartPanel">
        <span class="chart-toggle-title"><i class="fa-solid fa-chart-line"></i> Aylıq Qoşulma Statistikası</span>
        <span class="chart-toggle-icon"><i class="fa-solid fa-chevron-down"></i></span>
      </button>
      <div class="chart-panel" id="chartPanel">
        <div class="chart-inner">
          <% if (monthlyStats.labels.length > 0) { %>
            <div class="chart-actions"><button class="btn-expand" onclick="openChartModal()"><i class="fa-solid fa-expand"></i> Böyüt</button></div>
            <div class="chart-wrapper"><canvas id="monthlyChart"></canvas></div>
            <div class="chart-buttons" data-chart-scope="main">
              <button class="chart-btn active" data-type="total" onclick="updateChart('total','main')">Ümumi</button>
              <button class="chart-btn green" data-type="qosulma" onclick="updateChart('qosulma','main')">Qoşulma</button>
              <button class="chart-btn orange" data-type="kocurme" onclick="updateChart('kocurme','main')">Köçürmə</button>
            </div>
          <% } else { %>
            <div class="chart-empty"><i class="fa-regular fa-chart-bar"></i><strong>Statistika tapılmadı</strong><span>Chart üçün aylıq məlumat yoxdur.</span></div>
          <% } %>
        </div>
      </div>
    </div>

    <div id="todayList" class="hidden compact-list">
      <h3 class="section-title"><i class="fa-solid fa-calendar-day"></i> Bu gün əlavə olunanlar - <%= todayCustomers.length %> nəfər</h3>
      <% todayCustomers.forEach((item, index) => { const t = getType(item); %>
        <div class="list-item <%= t.typeClass %>" data-code="<%= item['Ödəniş kodu'] %>" data-index="<%= index %>" data-list="today" role="button" tabindex="0">
          <div class="list-main"><div class="list-top"><div class="name list-item-name"><%= item['Ad, Soyad, Ata adı'] || 'Adsız müştəri' %><span class="badge <%= t.badgeClass %>"><i class="fa-solid <%= t.iconClass %>"></i> <%= t.typeLabel %></span></div><span class="list-date"><i class="fa-regular fa-calendar"></i> <%= dateText(item) %></span></div><div class="meta"><strong>Kod:</strong> <%= item['Ödəniş kodu'] || '-' %> · <strong>Tel:</strong> <%= item['Telefon nömrəsi'] || '-' %></div></div>
          <i class="fa-solid fa-chevron-right chevron"></i>
        </div>
      <% }) %>
    </div>

    <div id="archiveList" class="hidden compact-list">
      <h3 class="section-title"><i class="fa-solid fa-box-archive"></i> Arxivdə olanlar - <%= archivedCustomers.length %> nəfər</h3>
      <% archivedCustomers.forEach((item, index) => { const t = getType(item); %>
        <div class="list-item <%= t.typeClass %>" data-code="<%= item['Ödəniş kodu'] %>" data-index="<%= index %>" data-list="archive" role="button" tabindex="0">
          <div class="list-main"><div class="list-top"><div class="name list-item-name"><%= item['Ad, Soyad, Ata adı'] || 'Adsız müştəri' %><span class="badge archived"><i class="fa-solid fa-box-archive"></i> Arxivdə</span></div><span class="list-date"><i class="fa-regular fa-calendar"></i> <%= dateText(item) %></span></div><div class="meta"><strong>Kod:</strong> <%= item['Ödəniş kodu'] || '-' %> · <strong>Tel:</strong> <%= item['Telefon nömrəsi'] || '-' %></div></div>
          <i class="fa-solid fa-chevron-right chevron"></i>
        </div>
      <% }) %>
    </div>
  <% } %>
</div>

<div id="customerModal" class="modal">
  <div class="modal-content">
    <div class="modal-header">
      <h2 id="modalTitle"></h2>
      <div class="modal-controls">
        <button onclick="navigateModal(-1)" id="prevBtn"><i class="fa-solid fa-chevron-left"></i></button>
        <span id="modalCounter" style="color:var(--muted);font-size:14px"></span>
        <button onclick="navigateModal(1)" id="nextBtn"><i class="fa-solid fa-chevron-right"></i></button>
        <span class="close-btn" onclick="closeModal('customerModal')">&times;</span>
      </div>
    </div>
    <div class="modal-body grid" id="modalBody"></div>
  </div>
</div>

<div id="chartModal" class="modal">
  <div class="modal-content large">
    <div class="modal-header"><h2>Aylıq Qoşulma Statistikası</h2><span class="close-btn" onclick="closeModal('chartModal')">&times;</span></div>
    <div class="modal-body">
      <% if (monthlyStats.labels.length > 0) { %>
        <div style="height:500px"><canvas id="modalChart"></canvas></div>
        <div class="chart-buttons" data-chart-scope="modal">
          <button class="chart-btn active" data-type="total" onclick="updateChart('total','modal')">Ümumi</button>
          <button class="chart-btn green" data-type="qosulma" onclick="updateChart('qosulma','modal')">Qoşulma</button>
          <button class="chart-btn orange" data-type="kocurme" onclick="updateChart('kocurme','modal')">Köçürmə</button>
        </div>
      <% } else { %><div class="chart-empty"><i class="fa-regular fa-chart-bar"></i><strong>Statistika tapılmadı</strong></div><% } %>
    </div>
  </div>
</div>

<div id="allCustomersModal" class="modal">
  <div class="modal-content">
    <div class="modal-header"><h2><i class="fa-solid fa-users"></i> Bütün Müştərilər</h2><span class="close-btn" onclick="closeModal('allCustomersModal')">&times;</span></div>
    <div class="modal-body" id="allCustomersBody"><div class="loading-block"><div class="skeleton-list"><div class="skeleton-card"></div><div class="skeleton-card"></div><div class="skeleton-card"></div></div></div></div>
  </div>
</div>

<script>
let currentModalIndex = 0;
let currentModalList = [];
let currentModalType = '';
let mainChart = null;
let modalChartInstance = null;
let allCustomersPage = 1;
let allCustomersAbortController = null;
let modalAbortController = null;
let modalRequestSeq = 0;
let mainChartInitialized = false;
const chartData = <%- JSON.stringify(monthlyStats) %>;
const chartHasData = Array.isArray(chartData.labels) && chartData.labels.length > 0;
const modalLists = {
  search: <%- JSON.stringify(results.map(r => r['Ödəniş kodu']).filter(Boolean)) %>,
  today: <%- JSON.stringify(todayCustomers.map(r => r['Ödəniş kodu']).filter(Boolean)) %>,
  archive: <%- JSON.stringify(archivedCustomers.map(r => r['Ödəniş kodu']).filter(Boolean)) %>,
  all: []
};

function escapeHtml(value){return String(value ?? '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#039;');}
function formatDate(timestamp){
  if(timestamp === undefined || timestamp === null || String(timestamp).trim() === '') return 'Tarix yoxdur';
  const raw = String(timestamp).trim();
  let match = raw.match(/^(\d{1,2})\/(\d{1,2})\/(\d{4})/);
  if(match){const m=Number(match[1]),d=Number(match[2]),y=Number(match[3]);if(m>=1&&m<=12&&d>=1&&d<=31)return `${String(d).padStart(2,'0')}.${String(m).padStart(2,'0')}.${y}`;}
  match = raw.match(/^(\d{4})-(\d{1,2})-(\d{1,2})/);
  if(match){const y=Number(match[1]),m=Number(match[2]),d=Number(match[3]);if(m>=1&&m<=12&&d>=1&&d<=31)return `${String(d).padStart(2,'0')}.${String(m).padStart(2,'0')}.${y}`;}
  const parsed = new Date(raw);
  if(!Number.isNaN(parsed.getTime())) return `${String(parsed.getDate()).padStart(2,'0')}.${String(parsed.getMonth()+1).padStart(2,'0')}.${parsed.getFullYear()}`;
  return 'Tarix yoxdur';
}
function getCustomerType(item){const qeydText=String(item?.['Qeyd']||'').toLowerCase();const isArchived=String(item?.['Arxiv']||'').toLowerCase()==='hə';const typeClass=isArchived?'archived-item':(qeydText.includes('köç')?'kocurme':'qosulma');const badgeClass=isArchived?'archived':typeClass;const typeLabel=isArchived?'Arxivdə':(qeydText.includes('köç')?'Köçürmə':'Qoşulma');const iconClass=isArchived?'fa-box-archive':(typeClass==='kocurme'?'fa-truck-moving':'fa-plug');return{typeClass,badgeClass,typeLabel,iconClass};}
function createBadge(type){return `<span class="badge ${type.badgeClass}"><i class="fa-solid ${type.iconClass}"></i> ${escapeHtml(type.typeLabel)}</span>`;}
function createLoadingSkeleton(count=3){return `<div class="loading-block"><div class="skeleton-list">${Array.from({length:count},()=>'<div class="skeleton-card"></div>').join('')}</div></div>`;}
function createSpinner(text='Yüklənir...'){return `<div class="loader-inline"><span class="spinner"></span><span>${escapeHtml(text)}</span></div>`;}
function createCustomerListItem(item,index,listType='all'){
  const type=getCustomerType(item);const odemeKodu=String(item?.['Ödəniş kodu']??'');const adSoyad=item?.['Ad, Soyad, Ata adı']||'Adsız müştəri';const telefon=item?.['Telefon nömrəsi']||'-';const unvan=item?.['Ünvan']||'';
  return `<div class="list-item ${type.typeClass}" data-code="${escapeHtml(odemeKodu)}" data-index="${Number(index)||0}" data-list="${escapeHtml(listType)}" role="button" tabindex="0"><div class="list-main"><div class="list-top"><div class="name list-item-name">${escapeHtml(adSoyad)}${createBadge(type)}</div><span class="list-date"><i class="fa-regular fa-calendar"></i> ${escapeHtml(formatDate(item?.['Timestamp']))}</span></div><div class="meta"><strong>Kod:</strong> ${escapeHtml(odemeKodu||'-')} · <strong>Tel:</strong> ${escapeHtml(telefon)}${unvan?` · ${escapeHtml(unvan)}`:''}</div></div><i class="fa-solid fa-chevron-right chevron"></i></div>`;
}

function setModalOpen(id,isOpen){const el=document.getElementById(id);if(!el)return;el.classList.toggle('is-open',isOpen);el.style.display=isOpen?'flex':'none';}
function closeModal(id){setModalOpen(id,false);if(id==='customerModal'&&modalAbortController){modalAbortController.abort();modalAbortController=null;}}

function showTodayList(){document.getElementById('todayList')?.classList.toggle('hidden');document.getElementById('archiveList')?.classList.add('hidden');}
function showArchiveList(){document.getElementById('archiveList')?.classList.toggle('hidden');document.getElementById('todayList')?.classList.add('hidden');}

function setupChartToggle(){const card=document.getElementById('monthlyStatsCard');const toggle=document.getElementById('chartToggle');if(!card||!toggle)return;const saved=localStorage.getItem('monthlyStatsChartOpen')==='true';setChartOpen(saved,false);toggle.addEventListener('click',()=>setChartOpen(!card.classList.contains('is-open'),true));}
function setChartOpen(open,persist){const card=document.getElementById('monthlyStatsCard');const toggle=document.getElementById('chartToggle');if(!card||!toggle)return;card.classList.toggle('is-open',open);toggle.setAttribute('aria-expanded',String(open));if(persist)localStorage.setItem('monthlyStatsChartOpen',String(open));if(open&&chartHasData&&!mainChartInitialized){requestAnimationFrame(()=>initChart());}else if(open&&mainChart){setTimeout(()=>mainChart.resize(),260);}}
function chartConfig(type='total'){const colors={total:{bg:'rgba(16,185,129,.52)',border:'#10b981'},qosulma:{bg:'rgba(16,185,129,.52)',border:'#10b981'},kocurme:{bg:'rgba(245,158,11,.55)',border:'#f59e0b'}};const labels={total:'Ümumi',qosulma:'Qoşulma',kocurme:'Köçürmə'};return{label:labels[type]||labels.total,color:colors[type]||colors.total};}
function buildChart(ctx,type='total'){const cfg=chartConfig(type);return new Chart(ctx,{type:'bar',data:{labels:chartData.labels,datasets:[{label:cfg.label,data:chartData[type]||[],backgroundColor:cfg.color.bg,borderColor:cfg.color.border,borderWidth:2,borderRadius:8}]},options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{labels:{color:'#e2e8f0'}}},scales:{y:{beginAtZero:true,ticks:{color:'#94a3b8',stepSize:1,precision:0},grid:{color:'rgba(51,65,85,.8)'}},x:{ticks:{color:'#cbd5e1'},grid:{color:'rgba(51,65,85,.45)'}}}}});}
function initChart(){if(!chartHasData||mainChartInitialized)return;const ctx=document.getElementById('monthlyChart');if(!ctx)return;mainChart=buildChart(ctx,'total');mainChartInitialized=true;}
function openChartModal(){setModalOpen('chartModal',true);if(chartHasData&&!modalChartInstance){requestAnimationFrame(()=>{const ctx=document.getElementById('modalChart');if(ctx)modalChartInstance=buildChart(ctx,'total');});}else if(modalChartInstance){setTimeout(()=>modalChartInstance.resize(),120);}}
function updateChart(type,scope='main'){const chart=scope==='modal'?modalChartInstance:mainChart;if(!chart)return;const cfg=chartConfig(type);document.querySelectorAll(`.chart-buttons[data-chart-scope="${scope}"] .chart-btn`).forEach(b=>b.classList.toggle('active',b.dataset.type===type));chart.data.datasets[0].label=cfg.label;chart.data.datasets[0].data=chartData[type]||[];chart.data.datasets[0].backgroundColor=cfg.color.bg;chart.data.datasets[0].borderColor=cfg.color.border;chart.update();}

async function openAllCustomersModal(){setModalOpen('allCustomersModal',true);await loadAllCustomers(1);}
function showAllCustomersError(message){const body=document.getElementById('allCustomersBody');if(!body)return;body.innerHTML=`<div class="not-found" style="margin:0"><p><i class="fa-solid fa-triangle-exclamation"></i> ${escapeHtml(message||'Müştərilər yüklənmədi.')}</p><button class="btn-edit" type="button" onclick="loadAllCustomers(${Number(allCustomersPage)||1})"><i class="fa-solid fa-rotate-right"></i> Yenidən cəhd et</button></div>`;}
async function loadAllCustomers(page=1){const requestedPage=Number.parseInt(page,10)||1;allCustomersPage=requestedPage;const body=document.getElementById('allCustomersBody');if(!body)return;if(allCustomersAbortController)allCustomersAbortController.abort();allCustomersAbortController=new AbortController();body.innerHTML=createLoadingSkeleton(5);try{const res=await fetch(`/api/all-customers?page=${encodeURIComponent(requestedPage)}&limit=10`,{headers:{Accept:'application/json'},credentials:'same-origin',signal:allCustomersAbortController.signal});const contentType=res.headers.get('content-type')||'';if(!contentType.includes('application/json')){throw new Error(res.status===401?'Sessiya bitib. Zəhmət olmasa yenidən daxil olun.':'Server JSON formatında cavab qaytarmadı.');}const json=await res.json();if(!res.ok||json.success!==true)throw new Error(json.error||`Server xətası (${res.status})`);const customers=Array.isArray(json.customers)?json.customers:(Array.isArray(json.data)?json.data:[]);const totalPages=Math.max(1,Number.parseInt(json.totalPages,10)||1);const currentPage=Math.min(Math.max(1,Number.parseInt(json.currentPage,10)||requestedPage),totalPages);const totalCustomers=Number.parseInt(json.totalCustomers,10)||customers.length;modalLists.all=customers.map(c=>c&&c['Ödəniş kodu']).filter(code=>code!==undefined&&code!==null&&String(code).trim()!=='').map(String);if(customers.length===0){body.innerHTML='<div class="not-found" style="margin:0"><p><i class="fa-solid fa-circle-info"></i> Müştəri tapılmadı.</p></div>';return;}const fragment=document.createDocumentFragment();const wrap=document.createElement('div');wrap.className='compact-list';wrap.innerHTML=`<div class="all-customers-toolbar"><span><i class="fa-solid fa-layer-group"></i> Səhifə ${currentPage} / ${totalPages}</span><strong>${totalCustomers} müştəri</strong></div>${customers.map((item,index)=>createCustomerListItem(item,index,'all')).join('')}`;fragment.appendChild(wrap);const pagination=document.createElement('div');pagination.className='pagination';pagination.innerHTML=`${currentPage>1?`<button type="button" onclick="loadAllCustomers(${currentPage-1})">Əvvəlki</button>`:''}<span style="padding:8px 15px">Səhifə ${currentPage} / ${totalPages}</span>${currentPage<totalPages?`<button type="button" onclick="loadAllCustomers(${currentPage+1})">Növbəti</button>`:''}`;fragment.appendChild(pagination);allCustomersPage=currentPage;body.replaceChildren(fragment);}catch(error){if(error.name==='AbortError')return;console.error('[all-customers] Müştərilər yüklənmədi:',error);showAllCustomersError(error.message);}}

function openModal(odemeKodu,index,type='search'){currentModalType=type;currentModalList=Array.isArray(modalLists[type])?[...modalLists[type]]:[];if(!currentModalList.length&&odemeKodu)currentModalList=[String(odemeKodu)];currentModalIndex=currentModalList.map(String).indexOf(String(odemeKodu));if(currentModalIndex<0)currentModalIndex=Number.isInteger(index)?index:0;loadModalCustomer(odemeKodu);}
async function loadModalCustomer(odemeKodu){const modalBody=document.getElementById('modalBody');const modalTitle=document.getElementById('modalTitle');const counter=document.getElementById('modalCounter');const prevBtn=document.getElementById('prevBtn');const nextBtn=document.getElementById('nextBtn');if(!modalBody||!modalTitle)return;if(modalAbortController)modalAbortController.abort();modalAbortController=new AbortController();const requestId=++modalRequestSeq;modalTitle.textContent='Müştəri məlumatı';modalBody.innerHTML=createSpinner('Məlumat yüklənir...');setModalOpen('customerModal',true);counter.textContent=currentModalList.length?`${currentModalIndex+1} / ${currentModalList.length}`:'';prevBtn.disabled=currentModalIndex<=0;nextBtn.disabled=currentModalIndex>=currentModalList.length-1;try{const res=await fetch(`/customer/${encodeURIComponent(odemeKodu)}`,{headers:{Accept:'application/json'},credentials:'same-origin',signal:modalAbortController.signal});const contentType=res.headers.get('content-type')||'';if(!contentType.includes('application/json'))throw new Error(res.status===401?'Sessiya bitib. Zəhmət olmasa yenidən daxil olun.':'Server JSON formatında cavab qaytarmadı.');const json=await res.json();if(requestId!==modalRequestSeq)return;if(!res.ok||json.success!==true||!json.data)throw new Error(json.error||'Məlumat tapılmadı.');const r=json.data;const isArchived=String(r['Arxiv']||'').toLowerCase()==='hə';modalTitle.innerHTML=`${escapeHtml(r['Ad, Soyad, Ata adı']||'Adsız')} ${isArchived?'<span class="badge archived" style="font-size:14px;vertical-align:middle"><i class="fa-solid fa-box-archive"></i> Arxivdə</span>':''}`;const fields=[{key:'Ödəniş kodu',label:'Ödəniş Kodu'},{key:'Telefon nömrəsi',label:'Telefon',type:'tel'},{key:'Aylıq ödəniş',label:'Aylıq Ödəniş',suffix:' AZN'},{key:'Ş/V FİN',label:'Ş/V FİN'},{key:'Ş/V Seriya',label:'Ş/V Seriya'},{key:'Modem S/N',label:'Modem S/N'},{key:'Tv Box',label:'TV Box'},{key:'Komendant',label:'Komendant'},{key:'Şifrə:',label:'Şifrə'},{key:'Timestamp',label:'Qeydiyyat tarixi',type:'date'},{key:'Ünvan',label:'Ünvan',full:true},{key:'Qeyd',label:'Qeyd',full:true},{key:'Müqavilə və Modemin şəkli',label:'Müqavilə Şəkli',type:'image',full:true}];let html='';fields.forEach(f=>{let val=r[f.key];if(f.type==='date')val=formatDate(val);if(val&&String(val).trim()!==''&&String(val).toLowerCase()!=='yox'){html+=`<div class="info-item ${f.full?'full-width':''}"><label>${escapeHtml(f.label)}</label><p>`;if(f.type==='tel'){const cleanTel=String(val).replace(/\s/g,'');const waTel='994'+cleanTel.replace(/^0/,'');html+=`<a href="tel:${encodeURIComponent(cleanTel)}">${escapeHtml(val)}</a><a href="https://wa.me/${encodeURIComponent(waTel)}" target="_blank" class="btn-wa"><i class="fa-brands fa-whatsapp"></i> WhatsApp</a>`;}else if(f.type==='image'){const links=String(val).split(',').map(l=>l.trim()).filter(Boolean);html+=links.map((l,i)=>`<a class="btn-image" href="${escapeHtml(l)}" target="_blank"><i class="fa-solid fa-image"></i> Şəkil ${i+1}</a>`).join(' ');}else{html+=`${escapeHtml(val)}${f.suffix||''}`;}html+='</p></div>';}});const codeArg=JSON.stringify(String(r['Ödəniş kodu']||'')).replace(/'/g,'\\u0027');html+=`<div class="info-item full-width" style="display:flex;gap:10px;margin-top:10px;flex-wrap:wrap"><a href="/edit/${encodeURIComponent(r['Ödəniş kodu'])}" class="btn-edit"><i class="fa-solid fa-pen"></i> Redaktə</a><button class="btn-delete" onclick='deleteCustomer(${codeArg}, ${Number(r.rowIndex)||0})'><i class="fa-solid fa-trash"></i> Sil</button>${isArchived?`<button class="btn-unarchive" onclick='toggleArchive(${codeArg}, ${Number(r.rowIndex)||0}, false)'><i class="fa-solid fa-box-open"></i> Arxivdən Çıxart</button>`:`<button class="btn-archive" onclick='toggleArchive(${codeArg}, ${Number(r.rowIndex)||0}, true)'><i class="fa-solid fa-box-archive"></i> Arxivə Göndər</button>`}</div>`;modalBody.innerHTML=html;}catch(error){if(error.name==='AbortError')return;console.error('[customer-modal] Müştəri yüklənmədi:',error);modalTitle.textContent='Xəta';modalBody.innerHTML=`<div class="not-found" style="margin:0"><p><i class="fa-solid fa-triangle-exclamation"></i> ${escapeHtml(error.message||'Məlumat yüklənmədi.')}</p></div>`;}}
function navigateModal(direction){const newIndex=currentModalIndex+direction;if(newIndex>=0&&newIndex<currentModalList.length){currentModalIndex=newIndex;loadModalCustomer(currentModalList[currentModalIndex]);}}

async function postJson(url,body){const res=await fetch(url,{method:'POST',headers:{'Content-Type':'application/json',Accept:'application/json'},credentials:'same-origin',body:JSON.stringify(body)});const contentType=res.headers.get('content-type')||'';if(!contentType.includes('application/json'))throw new Error('Server JSON formatında cavab qaytarmadı.');const json=await res.json();if(!res.ok||json.success!==true)throw new Error(json.error||`Server xətası (${res.status})`);return json;}
async function deleteCustomer(odemeKodu,rowIndex){if(!confirm(`"${odemeKodu}" ödəniş kodlu müştərini silmək istəyirsiniz?`))return;try{await postJson(`/delete/${encodeURIComponent(odemeKodu)}`,{rowIndex});alert('Müştəri silindi');location.reload();}catch(error){alert('Xəta: '+error.message);}}
async function toggleArchive(odemeKodu,rowIndex,archive){const action=archive?'arxivə göndərmək':'arxivdən çıxartmaq';if(!confirm(`"${odemeKodu}" ödəniş kodlu müştərini ${action} istəyirsiniz?`))return;try{await postJson(`/archive/${encodeURIComponent(odemeKodu)}`,{rowIndex,archive});alert(archive?'Müştəri arxivə göndərildi':'Müştəri arxivdən çıxarıldı');location.reload();}catch(error){alert('Xəta: '+error.message);}}

document.addEventListener('click',(e)=>{const item=e.target.closest('.list-item[data-code]');if(item){openModal(item.dataset.code,Number.parseInt(item.dataset.index,10)||0,item.dataset.list||'search');return;}if(e.target.classList.contains('modal'))closeModal(e.target.id);});
document.addEventListener('keydown',(e)=>{if(e.key==='Enter'||e.key===' '){const item=e.target.closest?.('.list-item[data-code]');if(item){e.preventDefault();openModal(item.dataset.code,Number.parseInt(item.dataset.index,10)||0,item.dataset.list||'search');return;}}const customerOpen=document.getElementById('customerModal')?.classList.contains('is-open');if(customerOpen){if(e.key==='Escape')closeModal('customerModal');if(e.key==='ArrowLeft')navigateModal(-1);if(e.key==='ArrowRight')navigateModal(1);}if(e.key==='Escape'){closeModal('chartModal');closeModal('allCustomersModal');}});
document.addEventListener('DOMContentLoaded',setupChartToggle);
</script>

</body></html>
