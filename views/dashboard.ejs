  };
  const labels = {
    total: 'Ümumi',
    qosulma: 'Qoşulma',
    kocurme: 'Köçürmə'
  };
  document.querySelectorAll('.chart-btn').forEach(b => {
    b.classList.remove('active');
    if (b.dataset.type === type) b.classList.add('active');
  });
  mainChart.data.datasets[0].label = labels[type];
  mainChart.data.datasets[0].data = chartData[type];
  mainChart.data.datasets[0].backgroundColor = colors[type].bg;
  mainChart.data.datasets[0].borderColor = colors[type].border;
  mainChart.update();
}

