<!DOCTYPE html>
<html>
   <head>
      <title>Müştəri Panel</title>
      <meta name="viewport" content="width=device-width, initial-scale=1" />
      <link
         rel="stylesheet"
         href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css"
      />
      <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
      <style>
         :root {
            --bg: #0f172a;
            --card: #1e293b;
            --card-soft: #223047;
            --card-glass: rgba(30, 41, 59, 0.82);
            --border: #334155;
            --border-soft: rgba(148, 163, 184, 0.22);
            --green: #10b981;
            --green-dark: #059669;
            --text: #e2e8f0;
            --muted: #94a3b8;
            --muted-2: #cbd5e1;
            --blue: #3b82f6;
            --purple: #8b5cf6;
            --orange: #f59e0b;
            --red: #ef4444;
            --gray: #6b7280;
            --glow: rgba(16, 185, 129, 0.22);
            --z-modal-base: 1000;
            --z-modal-list: 1100;
            --z-modal-chart: 1150;
            --z-modal-detail: 1200;
         }
         * {
            box-sizing: border-box;
         }
         body {
            font-family:
               system-ui,
               -apple-system,
               BlinkMacSystemFont,
               "Segoe UI",
               sans-serif;
            margin: 0;
            background-image: url("https://raw.githubusercontent.com/AsadAsadov/Selnet/main/home.jpg");
            background-size: cover;
            background-position: center center;
            background-repeat: no-repeat;
            background-attachment: fixed;
            background-color: #0f172a;
            color: var(--text);
            min-height: 100vh;
         }
         .header {
            background: rgba(15, 23, 42, 0.75);
            backdrop-filter: blur(18px);
            -webkit-backdrop-filter: blur(18px);
            padding: 16px 20px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 10px;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.22);
            border-bottom: 1px solid rgba(255, 255, 255, 0.08);
         }
         .header .logo {
            display: flex;
            align-items: center;
            gap: 10px;
            color: #f8fafc;
         }
         .header h1 {
            margin: 0;
            font-size: 16px;
            font-weight: 800;
            letter-spacing: 0.5px;
         }
         .header .actions {
            display: flex;
            align-items: center;
            gap: 10px;
         }
         .header .actions a {
            text-decoration: none;
            font-weight: 700;
            font-size: 13px;
            padding: 9px 16px;
            border-radius: 14px;
            display: flex;
            align-items: center;
            gap: 6px;
            color: #fff;
            transition: all 0.24s ease;
            box-shadow: 0 8px 24px rgba(0, 0, 0, 0.16);
         }
         .header .actions a:first-child {
            background: rgba(255, 255, 255, 0.14);
            border: 1px solid rgba(255, 255, 255, 0.18);
            color: #f8fafc;
         }
         .header .actions a:first-child:hover {
            background: rgba(255, 255, 255, 0.2);
            transform: translateY(-1px);
         }
         .header .actions a.btn-logout {
            background: rgba(239, 68, 68, 0.94);
            border: 1px solid rgba(220, 38, 38, 0.85);
         }
         .header .actions a.btn-logout:hover {
            background: rgba(220, 38, 38, 0.95);
            box-shadow: 0 8px 28px rgba(239, 68, 68, 0.25);
            transform: translateY(-1px);
         }
         .container {
            padding: 15px;
            max-width: 1000px;
            margin: auto;
         }
         .search-section,
         .card,
         .stat-card,
         .chart-container,
         .list-item,
         .not-found,
         .error {
            box-shadow: 0 14px 30px rgba(0, 0, 0, 0.14);
         }
         .search-section {
            background: rgba(15, 23, 42, 0.55);
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 22px;
            padding: 22px;
            margin-bottom: 20px;
            backdrop-filter: blur(10px);
         }
         .search-filter-section {
            display: flex;
            flex-wrap: wrap;
            gap: 12px;
            align-items: center;
            margin-bottom: 18px;
         }
         
         .search-box {
            display: flex;
            align-items: center;
            gap: 12px;
            flex: 2 1 420px;
            min-width: 260px;
            padding: 0;
            border: none;
            background: transparent;
         }
         
         .brand-logo-container {
            display: flex;
            align-items: center;
            justify-content: center;
            background: rgba(255, 255, 255, 0.05);
            backdrop-filter: blur(5px);
            padding: 5px 12px;
            border-radius: 12px;
            border: 1px solid rgba(255, 255, 255, 0.1);
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
            flex-shrink: 0;
         }
         
         .brand-logo {
            height: 45px;
            width: auto;
            object-fit: contain;
            filter: brightness(0) invert(1);
         }
         
         .search-wrapper {
            display: flex;
            align-items: center;
            position: relative;
            flex: 1;
            min-width: 0;
         }
         
         .search-wrapper input {
            width: 100%;
            padding: 12px 14px 12px 44px;
            background: rgba(30, 41, 59, 0.5);
            border: 1px solid var(--border);
            border-radius: 14px;
            color: var(--text);
            font-size: 15px;
            min-width: 0;
            transition:
               border-color 0.3s ease,
               box-shadow 0.3s ease,
               background 0.3s ease;
         }
         
         .search-icon {
            position: absolute;
            left: 14px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--green);
            pointer-events: none;
            font-size: 16px;
         }
         
         .search-wrapper input:focus,
         .date-filter input[type="date"]:focus {
            outline: none;
            border-color: var(--green);
            box-shadow: 0 0 10px var(--glow);
         }
         
         .date-filter {
            display: flex;
            align-items: center;
            gap: 10px;
            flex-wrap: wrap;
            flex: 1 1 340px;
            min-width: 280px;
            background: transparent;
         }
         
         .date-filter label {
            display: none;
         }
         
         .date-filter input[type="date"] {
            flex: 1;
            min-width: 130px;
            padding: 12px 14px;
            background: rgba(30, 41, 59, 0.55);
            border: 1px solid var(--border);
            border-radius: 14px;
            color: var(--text);
            font-size: 14px;
            text-align: center;
            transition:
               border-color 0.3s ease,
               box-shadow 0.3s ease,
               background 0.3s ease;
         }
         
         .date-filter input[type="date"]::-webkit-calendar-picker-indicator {
            filter: invert(64%) sepia(39%) saturate(403%) hue-rotate(101deg)
               brightness(100%) contrast(97%);
         }
         
         .date-filter input[type="date"]::-moz-focus-inner {
            border: 0;
         }
         
         .search-box button {
            padding: 12px 20px;
            background: var(--green);
            border: none;
            border-radius: 10px;
            color: #fff;
            font-weight: 800;
            cursor: pointer;
            white-space: nowrap;
         }
         
         .search-box button:hover {
            background: var(--green-dark);
         }
         
         .filter-actions {
            display: flex;
            align-items: center;
            gap: 10px;
            flex-wrap: wrap;
         }
         
         .btn-filter {
            padding: 10px 15px;
            background: var(--green);
            border: none;
            border-radius: 10px;
            color: #fff;
            cursor: pointer;
            font-weight: 700;
            white-space: nowrap;
         }
         
         .btn-filter:hover {
            background: var(--green-dark);
         }
         
         .btn-clear {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 10px 15px;
            background: var(--border);
            border-radius: 10px;
            color: var(--text);
            text-decoration: none;
            font-size: 14px;
            white-space: nowrap;
         }
         
         .search-info {
            color: var(--muted-2);
            font-size: 14px;
            margin-bottom: 20px;
         }
         
         @media (max-width: 768px) {
         
            .header {
               flex-direction: column;
               align-items: stretch;
               gap: 14px;
               padding: 15px;
            }
         
            .header .actions {
               width: 100%;
               display: flex;
               gap: 10px;
            }
         
            .header .actions a {
               flex: 1;
               justify-content: center;
            }
         
            .search-section {
               padding: 16px;
               border-radius: 18px;
            }
         
            .search-filter-section {
               flex-direction: column;
               align-items: stretch;
               gap: 14px;
            }
         
            .search-box {
               width: 100%;
               flex-direction: column;
               align-items: stretch;
               gap: 12px;
               min-width: 100%;
            }
         
            .brand-logo-container {
               width: 100%;
               justify-content: center;
               padding: 12px;
            }
         
            .search-wrapper {
               width: 100%;
            }
         
            .search-wrapper input {
               width: 100%;
               font-size: 16px;
            }
         
            .date-filter {
               width: 100%;
               flex-direction: column;
               align-items: stretch;
               min-width: 100%;
            }
         
            .date-filter input[type="date"] {
               width: 100%;
               min-width: 100%;
            }
         
            .filter-actions {
               width: 100%;
               flex-direction: column;
            }
         
            .btn-filter,
            .btn-clear,
            .search-box button {
               width: 100%;
               justify-content: center;
            }
         
            .container {
               padding: 12px;
            }
         }
         .stats {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 15px;
            margin-bottom: 18px;
         }
         .stat-card {
            background: linear-gradient(
               180deg,
               var(--card),
               rgba(30, 41, 59, 0.86)
            );
            border: 1px solid var(--border-soft);
            padding: 20px;
            border-radius: 16px;
            cursor: pointer;
            transition: all 0.22s ease;
            position: relative;
            overflow: hidden;
         }
         .stat-card:before {
            content: "";
            position: absolute;
            inset: 0;
            background: radial-gradient(
               circle at right top,
               rgba(255, 255, 255, 0.08),
               transparent 40%
            );
            pointer-events: none;
         }
         .stat-card:hover {
            border-color: var(--green);
            transform: translateY(-2px);
            box-shadow:
               0 18px 38px rgba(0, 0, 0, 0.22),
               0 0 22px var(--glow);
         }
         .stat-card h3 {
            margin: 0 0 5px;
            color: var(--muted-2);
            font-size: 14px;
            font-weight: 600;
         }
         .stat-card p {
            margin: 0;
            font-size: 28px;
            font-weight: 900;
         }
         .stat-card.blue {
            border-left: 4px solid var(--blue);
         }
         .stat-card.green {
            border-left: 4px solid var(--green);
         }
         .stat-card.purple {
            border-left: 4px solid var(--purple);
         }
         .stat-card.gray {
            border-left: 4px solid var(--gray);
         }
         .chart-container {
            background: rgba(15, 23, 42, 0.82);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 22px;
            margin-bottom: 25px;
            overflow: hidden;
            box-shadow: 0 24px 60px rgba(0, 0, 0, 0.22);
            backdrop-filter: blur(6px);
         }
         .chart-toggle {
            width: 100%;
            background: transparent;
            border: none;
            color: var(--text);
            padding: 16px 18px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 15px;
            cursor: pointer;
            text-align: left;
         }
         .chart-toggle:hover {
            background: rgba(16, 185, 129, 0.07);
         }
         .chart-toggle-title {
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: 18px;
            font-weight: 800;
         }
         .chart-toggle-icon {
            width: 34px;
            height: 34px;
            border-radius: 10px;
            background: rgba(15, 23, 42, 0.78);
            border: 1px solid var(--border-soft);
            display: inline-flex;
            align-items: center;
            justify-content: center;
            transition:
               transform 0.25s ease,
               color 0.25s ease;
            color: var(--muted-2);
         }
         .chart-container.is-open .chart-toggle-icon {
            transform: rotate(180deg);
            color: var(--green);
         }
         .chart-panel {
            max-height: 0;
            opacity: 0;
            overflow: hidden;
            transition:
               max-height 0.42s ease,
               opacity 0.28s ease;
         }
         .chart-container.is-open .chart-panel {
            max-height: 520px;
            opacity: 1;
         }
         .chart-inner {
            background: rgba(15, 23, 42, 0.18);
            border-radius: 0 0 22px 22px;
            backdrop-filter: blur(6px);
            -webkit-backdrop-filter: blur(6px);
            padding: 18px;
         }
         .chart-actions {
            display: flex;
            justify-content: flex-end;
            margin-bottom: 14px;
         }
         .btn-expand {
            background: var(--border);
            border: none;
            color: var(--text);
            padding: 8px 12px;
            border-radius: 8px;
            cursor: pointer;
            font-size: 13px;
         }
         .btn-expand:hover {
            background: var(--green);
         }
         .chart-scroll {
            width: 100%;
            overflow-x: hidden;
            overflow-y: hidden;
            padding-bottom: 6px;
            scrollbar-color: var(--green) rgba(15, 23, 42, 0.55);
         }
         .chart-scroll::-webkit-scrollbar {
            height: 8px;
         }
         .chart-scroll::-webkit-scrollbar-thumb {
            background: var(--green);
            border-radius: 999px;
         }
         .chart-scroll::-webkit-scrollbar-track {
            background: rgba(15, 23, 42, 0.55);
            border-radius: 999px;
         }
         .chart-wrapper {
            width: 100% !important;
            min-width: 0 !important;
            max-width: 100%;
            height: 320px;
            position: relative;
         }
         .chart-wrapper canvas {
            width: 100% !important;
            height: 100% !important;
            display: block;
         }
         .chart-empty {
            height: 220px;
            border: 1px dashed var(--border);
            border-radius: 14px;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            color: var(--muted);
            gap: 10px;
            background: rgba(15, 23, 42, 0.35);
         }
         .chart-empty i {
            font-size: 34px;
            color: var(--muted);
         }
         .modal-chart-frame {
            width: 100% !important;
            min-width: 0 !important;
            height: min(56vh, 520px);
            min-height: 280px;
            overflow: hidden;
         }
         .chart-buttons {
            display: flex;
            gap: 8px;
            margin-top: 15px;
            flex-wrap: wrap;
         }
         .chart-btn {
            padding: 8px 16px;
            background: var(--border);
            border: none;
            border-radius: 8px;
            color: var(--text);
            cursor: pointer;
            font-size: 14px;
            font-weight: 700;
         }
         .chart-btn:hover {
            box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.12);
         }
         .chart-btn.active {
            background: var(--green);
         }
         .chart-btn.orange.active {
            background: var(--orange);
         }
         .chart-btn.blue.active {
            background: var(--blue);
         }
         .card {
            background: var(--card);
            border: 1px solid var(--border-soft);
            border-radius: 16px;
            overflow: hidden;
            margin-bottom: 20px;
         }
         .card-header {
            padding: 20px;
            border-bottom: 1px solid var(--border-soft);
         }
         .card-header h2 {
            margin: 0 0 5px;
            font-size: 22px;
         }
         .card-header span {
            color: var(--muted);
            font-size: 14px;
         }
         .card-body {
            padding: 20px;
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
         }
         .info-item label {
            font-size: 12px;
            color: var(--muted);
            display: block;
            margin-bottom: 5px;
            text-transform: uppercase;
            letter-spacing: 0.04em;
         }
         .info-item {
            min-width: 0;
            max-width: 100%;
         }
         .info-item p,
         .info-value {
            margin: 0;
            width: 100%;
            min-width: 0;
            max-width: 100%;
            font-size: 16px;
            font-weight: 600;
            line-height: 1.45;
            white-space: normal;
            word-break: normal;
            overflow-wrap: break-word;
         }
         .info-text {
            display: block;
            min-width: 0;
            max-width: 100%;
            white-space: pre-wrap;
            word-break: normal;
            overflow-wrap: break-word;
         }
         .info-value--contact,
         .info-value--links {
            display: flex;
            align-items: center;
            gap: 10px;
            flex-wrap: wrap;
         }
         .info-item a {
            min-width: 0;
            max-width: 100%;
            color: var(--green);
            text-decoration: none;
            font-weight: 800;
            cursor: pointer;
            word-break: normal;
            overflow-wrap: break-word;
         }
         .full-width {
            grid-column: 1/-1;
         }
         .section-title {
            font-size: 18px;
            margin: 25px 0 15px;
            color: var(--text);
            display: flex;
            align-items: center;
            gap: 10px;
         }
         .result-list,
         .compact-list {
            display: grid;
            gap: 10px;
         }
         .list-item {
            background: linear-gradient(
               180deg,
               var(--card),
               rgba(30, 41, 59, 0.9)
            );
            border: 1px solid var(--border-soft);
            padding: 12px 14px;
            border-radius: 14px;
            margin-bottom: 10px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 12px;
            cursor: pointer;
            transition:
               transform 0.2s ease,
               border-color 0.2s ease,
               box-shadow 0.2s ease,
               background 0.2s ease;
            position: relative;
            overflow: hidden;
         }
         .result-list .list-item {
            padding: 14px 15px;
         }
         .list-item:hover {
            border-color: rgba(16, 185, 129, 0.82);
            background: #273549;
            transform: translateX(5px);
            box-shadow:
               0 10px 26px rgba(0, 0, 0, 0.18),
               0 0 18px rgba(16, 185, 129, 0.16);
         }
         .list-item .chevron {
            color: var(--muted);
            transition:
               transform 0.2s ease,
               color 0.2s ease;
         }
         .list-item:hover .chevron {
            transform: translateX(4px);
            color: var(--green);
         }
         .list-main {
            min-width: 0;
            flex: 1;
         }
         .list-top {
            display: flex;
            align-items: center;
            gap: 8px;
            justify-content: space-between;
            min-width: 0;
         }
         .list-item .name {
            font-weight: 850;
            color: #f8fafc;
            font-size: 15px;
            line-height: 1.25;
            min-width: 0;
         }
         .list-item-name {
            display: flex;
            align-items: center;
            flex-wrap: wrap;
            gap: 12px;
            flex: 1;
         }
         .list-item-name > .badge {
            margin-left: auto;
         }
         .meta {
            font-size: 13px;
            color: var(--muted);
            margin-top: 5px;
            line-height: 1.4;
         }
         .meta strong {
            color: var(--muted-2);
            font-weight: 700;
         }
         .list-date {
            font-size: 11px;
            color: #d1fae5;
            background: rgba(16, 185, 129, 0.13);
            border: 1px solid rgba(16, 185, 129, 0.28);
            border-radius: 999px;
            padding: 4px 8px;
            white-space: nowrap;
            font-weight: 800;
         }
         .list-item.kocurme .list-date {
            color: #ffedd5;
            background: rgba(245, 158, 11, 0.13);
            border-color: rgba(245, 158, 11, 0.3);
         }
         .list-item.archived-item .list-date {
            color: #d1d5db;
            background: rgba(107, 114, 128, 0.16);
            border-color: rgba(107, 114, 128, 0.32);
         }
         .list-item.qosulma {
            border-left: 4px solid var(--green);
         }
         .list-item.kocurme {
            border-left: 4px solid var(--orange);
         }
         .list-item.archived-item {
            border-left: 4px solid var(--gray);
            opacity: 0.84;
         }
         .badge {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            padding: 6px 12px;
            border-radius: 10px;
            font-size: 12px;
            font-weight: 800;
            letter-spacing: 0.02em;
            border: 1.5px solid;
            flex-shrink: 0;
         }
         .badge.qosulma {
            background: rgba(16, 185, 129, 0.2);
            color: var(--green);
            border-color: var(--green);
         }
         .badge.kocurme {
            background: rgba(245, 158, 11, 0.2);
            color: var(--orange);
            border-color: var(--orange);
         }
         .badge.archived {
            background: rgba(107, 114, 128, 0.2);
            color: var(--gray);
            border-color: var(--gray);
         }
         .pagination {
            display: flex;
            gap: 10px;
            justify-content: center;
            margin-top: 20px;
            flex-wrap: wrap;
         }
         .pagination a,
         .pagination button {
            padding: 8px 15px;
            background: var(--card);
            border: 1px solid var(--border);
            border-radius: 8px;
            color: var(--text);
            text-decoration: none;
            cursor: pointer;
         }
         .pagination a.active {
            background: var(--green);
            border-color: var(--green);
         }
         .not-found,
         .error {
            text-align: center;
            padding: 40px;
            color: var(--muted);
            background: var(--card);
            border: 1px solid var(--border-soft);
            border-radius: 16px;
         }
         .error {
            color: #fca5a5;
         }
         .archive-notice {
            background: rgba(107, 114, 128, 0.15);
            border: 1px solid var(--gray);
            padding: 10px 15px;
            border-radius: 10px;
            margin-bottom: 15px;
            display: flex;
            align-items: center;
            gap: 10px;
            color: var(--muted-2);
         }
         body.modal-open {
            overflow: hidden;
            touch-action: none;
         }
         .modal {
            display: none;
            position: fixed;
            inset: 0;
            z-index: var(--z-modal-base);
            width: auto;
            height: 100dvh;
            min-height: 100dvh;
            padding: clamp(14px, 3vh, 32px) clamp(12px, 3vw, 28px);
            padding-top: max(clamp(14px, 3vh, 32px), env(safe-area-inset-top));
            padding-right: max(
               clamp(12px, 3vw, 28px),
               env(safe-area-inset-right)
            );
            padding-bottom: max(
               clamp(14px, 3vh, 32px),
               env(safe-area-inset-bottom)
            );
            padding-left: max(
               clamp(12px, 3vw, 28px),
               env(safe-area-inset-left)
            );
            align-items: center;
            justify-content: center;
            background: radial-gradient(
                  circle at 50% 18%,
                  rgba(16, 185, 129, 0.12),
                  transparent 34%
               ),
               rgba(2, 6, 23, 0.76);
            backdrop-filter: blur(12px) saturate(1.08);
            -webkit-backdrop-filter: blur(12px) saturate(1.08);
            overflow: hidden;
            overscroll-behavior: contain;
         }
         .modal.is-open {
            display: flex;
         }
         .modal-content {
            width: min(92vw, 840px);
            max-height: calc(
               100dvh -
                  max(
                     clamp(28px, 6vh, 64px),
                     calc(
                        env(safe-area-inset-top) + env(safe-area-inset-bottom) +
                           28px
                     )
                  )
            );
            min-height: 0;
            display: flex;
            flex-direction: column;
            overflow: hidden;
            background: linear-gradient(
               145deg,
               rgba(30, 41, 59, 0.88),
               rgba(15, 23, 42, 0.96)
            );
            border: 1px solid rgba(148, 163, 184, 0.26);
            border-radius: 22px;
            box-shadow:
               0 28px 80px rgba(0, 0, 0, 0.48),
               0 10px 28px rgba(2, 6, 23, 0.3),
               inset 0 1px 0 rgba(255, 255, 255, 0.07);
            animation: modalScale 0.22s cubic-bezier(0.2, 0.8, 0.2, 1);
            contain: layout paint;
            touch-action: auto;
         }
         .modal-content.large {
            width: min(94vw, 1100px);
         }
         .customer-detail-modal-content {
            width: min(92vw, 940px);
         }
         @keyframes modalScale {
            from {
               transform: scale(0.97) translate3d(0, 10px, 0);
               opacity: 0;
            }
            to {
               transform: scale(1) translate3d(0, 0, 0);
               opacity: 1;
            }
         }
