										const badgeClass = isArchived ? 'archived' : typeClass;
										const typeLabel = isArchived ? 'Arxivdə' : (qeydText.includes('köç') ? 'Köçürmə' : 'Qoşulma');
										const iconClass = isArchived ? 'fa-box-archive' : (typeClass === 'kocurme' ? 'fa-truck-moving' : 'fa-plug');
										return {
											typeClass,
											badgeClass,
											typeLabel,
											iconClass
										};
									}

									function createBadge(type) {
										return `<span class="badge ${type.badgeClass}"><i class="fa-solid ${type.iconClass}"></i> ${escapeHtml(type.typeLabel)}</span>`;
									}

									function createLoadingSkeleton(count = 3) {
