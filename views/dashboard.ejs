<!DOCTYPE html><html><head>
<title>Müştəri Panel</title><meta name="viewport" content="width=device-width, initial-scale=1">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
<style>
:root{--bg:#0f172a;--card:#1e293b;--border:#334155;--green:#10b981;--text:#e2e8f0;--muted:#94a3b8}
body{font-family:system-ui;margin:0;background:var(--bg);color:var(--text)}
.header{background:linear-gradient(90deg, #059669, #10b981);padding:15px 30px;display:flex;justify-content:space-between;align-items:center}
.header h1{margin:0;font-size:20px}.header a{color:#fff;text-decoration:none;font-weight:500}
.container{padding:20px;max-width:900px;margin:auto}
.search-box{display:flex;gap:10px;margin-bottom:15px}
.search-box input{flex:1;padding:15px;background:var(--card);border:1px solid var(--border);border-radius:8px;color:var(--text);font-size:16px}
.search-box button{padding:15px 25px;background:var(--green);border:none;border-radius:8px;color:#fff;font-weight:bold;cursor:pointer}
.search-info{color:var(--muted);font-size:14px;margin-bottom:20px}
.card{background:var(--card);border:1px solid var(--border);border-radius:12px;overflow:hidden;margin-bottom:20px}
.card-header{padding:20px;border-bottom:1px solid var(--border)}
.card-header h2{margin:0 0 5px 0;font-size:22px}.card-header span{color:var(--muted);font-size:14px}
.card-body{padding:20px;display:grid;grid-template-columns:1fr 1fr;gap:20px}
.info-item label{font-size:12px;color:var(--muted);display:block;margin-bottom:5px;text-transform:uppercase}
.info-item p{margin:0;font-size:16px;font-weight:500;word-break:break-word}
.info-item a{color:var(--green);text-decoration:none;font-weight:bold}
.full-width{grid-column:1 / -1}
.result-list.list-item{background:var(--card);border:1px solid var(--border);padding:15px;border-radius:8px;margin-bottom:10px;display:flex;justify-content:space-between;align-items:center;cursor:pointer;transition:0.2s}
.result-list.list-item:hover{border-color:var(--green);background:#273549}
.list-item.name{font-weight:600}.list-item.meta{font-size:13px;color:var(--muted)}
.pagination{display:flex;gap:10px;justify-content:center;margin-top:20px}
.pagination a{padding:8px 15px;background:var(--card);border:1px solid var(--border);border-radius:6px;color:var(--text);text-decoration:none}
.pagination a.active{background:var(--green);border-color:var(--green)}
.not-found,.error{text-align:center;padding:40px;color:var(--muted);background:var(--card);border-radius:12px}
.error{color:#f87171}
.modal{display:none;position:fixed;z-index:1000;left:0;top:0;width:100%;height:100%;background:rgba(0,0,0,0.7);align-items:center;justify-content:center}
.modal-content{background:var(--card);border:1px solid var(--border);border-radius:12px;width:90%;max-width:700px;max-height:90vh;overflow-y:auto}
.modal-header{padding:20px;border-bottom:1px solid var(--border);display:flex;justify-content:space-between;align-items:center}
.modal-header h2{margin:0}.close-btn{font-size:28px;cursor:pointer;color:var(--muted)}
.modal-body{padding:20px;display:grid;grid-template-columns:1fr 1fr;gap:20px}
@media (max-width:600px){.card-body,.modal-body{grid-template-columns:1fr}}
</style></head><body>
<div class="header">
  <h1><i class="fa-solid fa-database"></i> Müştəri Axtarış Sistemi</h1>
  <a href="/logout"><i class="fa-solid fa-right-from-bracket"></i> Çıxış</a>
</div>
<div class="container">
  <form class="search-box" method="GET">
    <input type="text" name="q" value="<%= q || '' %>" placeholder="Ödəniş kodu, Telefon, Ad və ya Ünvan ilə axtar..." required>
    <button type="submit"><i class="fa-solid fa-magnifying-glass"></i> Axtar</button>
  </form>

  <% if (errorMsg) { %>
    <div class="error"><p><i class="fa-solid fa-triangle-exclamation"></i> <%= errorMsg %></p></div>
  <% } else if (results.length > 0) { %>
    <div class="search-info">Axtarış: "<%= q %>" - <%= totalResults %> nəticə tapıldı</div>

    <% if (results.length === 1) { %>
      <% const result = results[0]; %>
      <div class="card">
        <div class="card-header">
          <h2><%= result['Ad, Soyad, Ata adı'] || 'Adsız müştəri' %></h2>
          <span>Ödəniş kodu: <%= result['Ödəniş kodu'] %> | Qeydiyyat: <%= result['Timestamp'] %></span>
        </div>
        <div class="card-body">
          <%- include('card-content', {result: result}) %>
        </div>
      </div>
    <% } else { %>
      <div class="result-list">
        <% results.forEach(item => { %>
          <div class="list-item" onclick="openModal('<%= item['Ödəniş kodu'] %>')">
            <div>
              <div class="name"><%= item['Ad, Soyad, Ata adı'] %></div>
              <div class="meta">Kod: <%= item['Ödəniş kodu'] %> | Tel: <%= item['Telefon nömrəsi'] %></div>
            </div>
            <i class="fa-solid fa-chevron-right"></i>
          </div>
        <% }) %>
      </div>
      <% if (totalPages > 1) { %>
        <div class="pagination">
          <% if (currentPage > 1) { %><a href="/?q=<%= q %>&page=<%= currentPage - 1 %>">Əvvəlki</a><% } %>
          <% for(let i = 1; i <= totalPages; i++) { %>
            <a href="/?q=<%= q %>&page=<%= i %>" class="<%= i === currentPage? 'active' : '' %>"><%= i %></a>
          <% } %>
          <% if (currentPage < totalPages) { %><a href="/?q=<%= q %>&page=<%= currentPage + 1 %>">Növbəti</a><% } %>
        </div>
      <% } %>
    <% } %>
  <% } else if (q) { %>
    <div class="not-found"><p><i class="fa-solid fa-circle-xmark"></i> "<%= q %>" üzrə nəticə tapılmadı</p></div>
  <% } %>
</div>

<!-- POPUP MODAL -->
<div id="customerModal" class="modal">
  <div class="modal-content">
    <div class="modal-header">
      <h2 id="modalTitle"></h2>
      <span class="close-btn" onclick="closeModal()">&times;</span>
    </div>
    <div class="modal-body" id="modalBody"></div>
  </div>
</div>

<script>
async function openModal(odemeKodu) {
  const modal = document.getElementById('customerModal');
  const modalBody = document.getElementById('modalBody');
  const modalTitle = document.getElementById('modalTitle');
  modalBody.innerHTML = '<p>Yüklənir...</p>';
  modal.style.display = 'flex';

  const res = await fetch(`/customer/${odemeKodu}`);
  const json = await res.json();

  if (json.success) {
    const r = json.data;
    modalTitle.innerHTML = `${r['Ad, Soyad, Ata adı'] || 'Adsız'} <span style="font-size:14px;color:#94a3b8;font-weight:normal">| ${r['Ödəniş kodu']}</span>`;

    const fields = [
      { key: 'Telefon nömrəsi', label: 'Telefon', type: 'tel' },
      { key: 'Aylıq ödəniş', label: 'Aylıq Ödəniş', suffix: ' AZN' },
      { key: 'Ş/V FİN', label: 'Ş/V FİN' },
      { key: 'Ş/V Seriya', label: 'Ş/V Seriya' },
      { key: 'Modem S/N', label: 'Modem S/N' },
      { key: 'Tv Box', label: 'TV Box' },
      { key: 'Komendant', label: 'Komendant' },
      { key: 'Şifrə:', label: 'Şifrə' },
      { key: 'Ünvan', label: 'Ünvan', full: true },
      { key: 'Qeyd', label: 'Qeyd', full: true },
      { key: 'Müqavilə və Modemin şəkli', label: 'Müqavilə Şəkli', type: 'link', full: true }
    ];

    let html = '';
    fields.forEach(f => {
      const val = r[f.key];
      if (val && val.toString().trim()!== '' && val.toString().toLowerCase()!== 'yox') {
        html += `<div class="info-item ${f.full? 'full-width' : ''}">
          <label>${f.label}</label><p>`;
        if (f.type === 'tel') html += `<a href="tel:${val}">${val}</a>`;
        else if (f.type === 'link') {
          const links = val.split(',').map(l => l.trim());
          html += links.map(l => `<a href="${l}" target="_blank">Şəkilə bax</a>`).join(' | ');
        } else html += `${val}${f.suffix || ''}`;
        html += `</p></div>`;
      }
    });
    modalBody.innerHTML = html;
  } else {
    modalBody.innerHTML = '<p>Məlumat tapılmadı.</p>';
  }
}
function closeModal() {
  document.getElementById('customerModal').style.display = 'none';
}
window.onclick = function(e) {
  if (e.target == document.getElementById('customerModal')) closeModal();
}
</script>

</body></html>
