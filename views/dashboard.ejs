									async function openCustomerListModal(type = 'all') {
										customerListState = {
											...customerListState,
											type: customerListConfig[type] ? type : 'all',
											page: 1,
											totalPages: 1,
											totalCustomers: 0,
											customers: [],
											filteredCustomers: [],
											search: ''
