										return (...args) => {
											clearTimeout(timeout);
											timeout = setTimeout(() => fn(...args), wait);
										};
									}

									function normalizeSearch(value) {
										return String(value ?? '').toLowerCase().replace(/\s+/g, '').trim();
									}

									function customerMatchesSearch(item, query) {
										if (!query) return true;
										const haystack = [item?.['Ad, Soyad, Ata adı'], item?.['Telefon nömrəsi'], item?.['Ödəniş kodu']].map(normalizeSearch).join('|');
										return haystack.includes(query);
									}

									function createCustomerListItem(item, index, listType = 'all') {
										const type = getCustomerType(item);
										const odemeKodu = String(item?.['Ödəniş kodu'] ?? '');
