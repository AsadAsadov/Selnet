<!DOCTYPE html>
<html>
   <head>
      <title>Müştəri Panel</title>
      <meta name="viewport" content="width=device-width, initial-scale=1" />
      <link
         rel="stylesheet"
         href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css"
      />
      <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
      <style>
         :root {
            --bg: #0f172a;
            --card: #1e293b;
            --card-soft: #223047;
            --card-glass: rgba(30, 41, 59, 0.82);
            --border: #334155;
            --border-soft: rgba(148, 163, 184, 0.22);
            --green: #10b981;
            --green-dark: #059669;
            --text: #e2e8f0;
            --muted: #94a3b8;
            --muted-2: #cbd5e1;
            --blue: #3b82f6;
            --purple: #8b5cf6;
            --orange: #f59e0b;
            --red: #ef4444;
            --gray: #6b7280;
            --glow: rgba(16, 185, 129, 0.22);
            --z-modal-base: 1000;
            --z-modal-list: 1100;
            --z-modal-chart: 1150;
            --z-modal-detail: 1200;
            --z-modal-history: 1300;
         }
         * {
            box-sizing: border-box;
         }
         body {
            font-family:
               system-ui,
               -apple-system,
               BlinkMacSystemFont,
               "Segoe UI",
               sans-serif;
            margin: 0;
            background-image: url("https://raw.githubusercontent.com/AsadAsadov/Selnet/main/home.jpg");
            background-size: cover;
            background-position: center center;
            background-repeat: no-repeat;
            background-attachment: fixed;
            background-color: #0f172a;
            color: var(--text);
            min-height: 100vh;
         }
         .header {
            background: rgba(15, 23, 42, 0.75);
            backdrop-filter: blur(18px);
            -webkit-backdrop-filter: blur(18px);
            padding: 16px 20px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 10px;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.22);
            border-bottom: 1px solid rgba(255, 255, 255, 0.08);
         }
         .header .logo {
            display: flex;
            align-items: center;
            gap: 10px;
            color: #f8fafc;
         }
         .header h1 {
            margin: 0;
            font-size: 16px;
            font-weight: 800;
            letter-spacing: 0.5px;
         }
         .header .actions {
            display: flex;
            align-items: center;
            gap: 10px;
         }
         .header .actions a {
            text-decoration: none;
            font-weight: 700;
            font-size: 13px;
            padding: 9px 16px;
            border-radius: 14px;
            display: flex;
            align-items: center;
            gap: 6px;
            color: #fff;
            transition: all 0.24s ease;
            box-shadow: 0 8px 24px rgba(0, 0, 0, 0.16);
         }
         .header .actions a:first-child {
            background: rgba(255, 255, 255, 0.14);
            border: 1px solid rgba(255, 255, 255, 0.18);
            color: #f8fafc;
         }
         .header .actions a:first-child:hover {
            background: rgba(255, 255, 255, 0.2);
            transform: translateY(-1px);
         }
         .header .actions a.btn-logout {
            background: rgba(239, 68, 68, 0.94);
            border: 1px solid rgba(220, 38, 38, 0.85);
         }
         .header .actions a.btn-logout:hover {
            background: rgba(220, 38, 38, 0.95);
            box-shadow: 0 8px 28px rgba(239, 68, 68, 0.25);
            transform: translateY(-1px);
         }
         .container {
            padding: 15px;
            max-width: 1000px;
            margin: auto;
         }
         .search-section,
         .card,
         .stat-card,
         .chart-container,
         .list-item,
         .not-found,
         .error {
            box-shadow: 0 14px 30px rgba(0, 0, 0, 0.14);
         }
         .search-section {
            background: rgba(15, 23, 42, 0.55);
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 22px;
            padding: 22px;
            margin-bottom: 20px;
            backdrop-filter: blur(10px);
         }
         .w-100 {
            width: 100%;
         }
         .mb-3 {
            margin-bottom: 1rem;
         }
         .btn {
            display: inline-block;
            font: inherit;
            text-align: center;
            vertical-align: middle;
            cursor: pointer;
            border-radius: 10px;
            border: 1px solid transparent;
            padding: 12px 14px;
            font-weight: 700;
            line-height: 1.25;
         }
         .btn.btn-secondary {
            width: 100%;
            background: rgba(51, 65, 85, 0.85);
            border-color: rgba(148, 163, 184, 0.4);
            color: var(--text);
            transition:
               background 0.18s ease,
               border-color 0.18s ease,
               box-shadow 0.18s ease;
         }
         .btn.btn-secondary:hover {
            border-color: rgba(16, 185, 129, 0.55);
            background: rgba(71, 85, 105, 0.92);
            box-shadow: 0 8px 22px rgba(2, 6, 23, 0.25);
         }
         #toggleSearchBtn {
            display: none;
         }
         @media (max-width: 768px) {
            #toggleSearchBtn {
               display: block;
            }
         }
         @media (max-width: 768px) {
            #searchFormContainer:not(.search-form-open) {
               display: none !important;
            }
         }
         @media (min-width: 769px) {
            #searchFormContainer {
               display: block !important;
            }
         }

         .search-filter-section {
            display: flex;
            flex-wrap: wrap;
            gap: 12px;
            align-items: center;
            margin-bottom: 0;
         }
         
         .search-box {
            display: flex;
            align-items: center;
            gap: 12px;
            flex: 2 1 420px;
            min-width: 260px;
            padding: 0;
            border: none;
            background: transparent;
         }
         
         .brand-logo-container {
            display: flex;
            align-items: center;
            justify-content: center;
            background: rgba(255, 255, 255, 0.05);
            backdrop-filter: blur(5px);
            padding: 5px 12px;
            border-radius: 12px;
            border: 1px solid rgba(255, 255, 255, 0.1);
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
            flex-shrink: 0;
         }
         
         .brand-logo {
            height: 45px;
            width: auto;
            object-fit: contain;
            filter: brightness(0) invert(1);
         }
         
         .search-wrapper {
            display: flex;
            align-items: center;
            position: relative;
            flex: 1;
            min-width: 0;
         }
         
         .search-wrapper input {
            width: 100%;
            padding: 12px 14px 12px 44px;
            background: rgba(30, 41, 59, 0.5);
            border: 1px solid var(--border);
            border-radius: 14px;
            color: var(--text);
            font-size: 15px;
            min-width: 0;
            transition:
               border-color 0.3s ease,
               box-shadow 0.3s ease,
               background 0.3s ease;
         }
         
         .search-icon {
            position: absolute;
            left: 14px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--green);
            pointer-events: none;
            font-size: 16px;
         }
         
         .search-wrapper input:focus,
         .date-filter input[type="date"]:focus {
            outline: none;
            border-color: var(--green);
            box-shadow: 0 0 10px var(--glow);
         }
         
         .date-filter {
            display: flex;
            align-items: center;
            gap: 10px;
            flex-wrap: wrap;
            flex: 1 1 340px;
            min-width: 280px;
            background: transparent;
         }
         
         .date-filter label {
            display: none;
         }
         
         .date-filter input[type="date"] {
            flex: 1;
            min-width: 0;
            padding: 6px 2px;
            background: rgba(30, 41, 59, 0.55);
            border: 1px solid var(--border);
            border-radius: 14px;
            color: var(--text);
            font-size: 14px;
            text-align: center;
            transition:
               border-color 0.3s ease,
               box-shadow 0.3s ease,
               background 0.3s ease;
         }
         
         .date-filter input[type="date"]::-webkit-calendar-picker-indicator {
            filter: invert(64%) sepia(39%) saturate(403%) hue-rotate(101deg)
               brightness(100%) contrast(97%);
         }
         
         .date-filter input[type="date"]::-moz-focus-inner {
            border: 0;
         }
         
         .search-box button {
            padding: 12px 20px;
            background: var(--green);
            border: none;
            border-radius: 10px;
            color: #fff;
            font-weight: 800;
            cursor: pointer;
            white-space: nowrap;
         }
         
         .search-box button:hover {
            background: var(--green-dark);
         }

         .modem-sn-live-wrap {
            position: relative;
            flex: 0 1 220px;
            min-width: 140px;
            max-width: 280px;
         }
         .modem-sn-inner {
            display: flex;
            align-items: center;
            position: relative;
            border-radius: 14px;
            border: 1px solid var(--border);
            background: rgba(30, 41, 59, 0.5);
            transition:
               border-color 0.25s ease,
               box-shadow 0.25s ease;
         }
         .modem-sn-inner:focus-within {
            border-color: var(--green);
            box-shadow: 0 0 0 1px rgba(16, 185, 129, 0.25);
         }
         .modem-sn-icon {
            position: absolute;
            left: 12px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--muted-2);
            font-size: 14px;
            pointer-events: none;
         }
         .modem-sn-inner input {
            width: 100%;
            border: none;
            background: transparent;
            color: var(--text);
            font-size: 14px;
            padding: 11px 12px 11px 40px;
            border-radius: 14px;
            outline: none;
         }
         .modem-sn-inner input::placeholder {
            color: var(--muted-2);
         }
         .modem-sn-dropdown {
            position: absolute;
            z-index: 40;
            left: 0;
            right: 0;
            top: calc(100% + 6px);
            max-height: min(52vh, 320px);
            overflow-y: auto;
            border-radius: 12px;
            border: 1px solid rgba(148, 163, 184, 0.35);
            background: rgba(15, 23, 42, 0.97);
            box-shadow: 0 16px 40px rgba(0, 0, 0, 0.35);
            -webkit-overflow-scrolling: touch;
         }
         .modem-sn-row {
            display: flex;
            flex-direction: column;
            align-items: flex-start;
            gap: 4px;
            width: 100%;
            text-align: left;
            padding: 10px 12px;
            border: none;
            border-bottom: 1px solid rgba(51, 65, 85, 0.6);
            background: transparent;
            color: var(--text);
            cursor: pointer;
            font: inherit;
         }
         .modem-sn-row:last-child {
            border-bottom: none;
         }
         .modem-sn-row:active {
            background: rgba(59, 130, 246, 0.15);
         }
         .modem-sn-row-name {
            font-weight: 600;
            font-size: 14px;
         }
         .modem-sn-row-sn {
            font-size: 12px;
            color: var(--muted-2);
            font-family: ui-monospace, monospace;
         }

         .card-body > .customer-card-global,
         .card-body > .customer-details {
            grid-column: 1 / -1;
            width: 100%;
            min-width: 0;
         }

         .customer-details .info-grid {
            display: grid !important;
            grid-template-columns: 1fr 1fr !important;
            gap: 3px 6px !important;
            align-items: start !important;
            min-width: 0;
         }
         .customer-details .info-grid .info-item.info-item-row {
            display: flex !important;
            flex-direction: row !important;
            align-items: baseline !important;
            gap: 4px !important;
            flex-wrap: wrap !important;
            min-width: 0;
            padding: 0;
         }
         .customer-details .info-grid .info-item-row--full {
            grid-column: 1 / -1 !important;
         }
         label.info-label,
         .customer-details .info-grid label.info-label {
            font-size: 12px !important;
            color: #888;
            text-transform: uppercase;
            letter-spacing: 0.03em;
            white-space: normal !important;
            line-height: 1.2;
            margin: 0 !important;
            min-width: 0;
         }
         .customer-details .info-grid .info-value {
            font-size: 13px !important;
            font-weight: 700;
            line-height: 1.25;
            word-break: break-word !important;
            overflow-wrap: anywhere;
            min-width: 0;
         }
         .customer-name {
            margin: 0 0 14px;
            font-size: clamp(17px, 2.8vw, 22px);
            line-height: 1.35;
            display: block;
            width: 100%;
            min-width: 0;
            max-width: 100%;
            word-break: normal;
            overflow-wrap: normal;
            white-space: normal;
         }

         .customer-card-actions {
            display: grid !important;
            grid-template-columns: 1fr 1fr !important;
            gap: 8px !important;
            width: 100% !important;
            max-width: 100%;
            box-sizing: border-box;
            margin-top: 18px;
         }
         .customer-card-actions > .btn-card-action {
            box-sizing: border-box;
            width: 100%;
            min-width: 0;
            margin: 0;
            padding: 8px 4px;
            border-radius: 10px;
            font: inherit;
            font-size: clamp(11px, 2.9vw, 13px);
            font-weight: 700;
            line-height: 1.25;
            text-align: center;
            display: flex;
            align-items: center;
            justify-content: center;
            text-decoration: none;
            cursor: pointer;
            transition:
               background 0.16s ease,
               border-color 0.16s ease,
               box-shadow 0.16s ease,
               filter 0.16s ease;
         }
         .customer-card-actions .btn-customer-history {
            border: 1px solid rgba(148, 163, 184, 0.4);
            background: rgba(51, 65, 85, 0.65);
            color: #e2e8f0;
         }
         .customer-card-actions .btn-customer-history:hover {
            background: rgba(71, 85, 105, 0.85);
            border-color: rgba(148, 163, 184, 0.55);
            box-shadow: 0 4px 14px rgba(2, 6, 23, 0.2);
         }
         .customer-card-actions .btn-edit {
            background: #3b82f6;
            color: #fff;
            border: 1px solid rgba(59, 130, 246, 0.65);
         }
         .customer-card-actions .btn-edit:hover {
            filter: brightness(1.06);
            box-shadow: 0 4px 14px rgba(59, 130, 246, 0.25);
         }
         .customer-card-actions .btn-delete {
            background: #ef4444;
            color: #fff;
            border: 1px solid rgba(239, 68, 68, 0.55);
         }
         .customer-card-actions .btn-delete:hover {
            filter: brightness(1.05);
            box-shadow: 0 4px 14px rgba(239, 68, 68, 0.22);
         }
         .customer-card-actions .btn-archive {
            background: #6b7280;
            color: #fff;
            border: 1px solid rgba(107, 114, 128, 0.55);
         }
         .customer-card-actions .btn-archive:hover {
            filter: brightness(1.06);
         }
         .customer-card-actions .btn-unarchive {
            background: #10b981;
            color: #fff;
            border: 1px solid rgba(16, 185, 129, 0.55);
         }
         .customer-card-actions .btn-unarchive:hover {
            filter: brightness(1.05);
         }

         .modal-body.grid .customer-card-actions {
            align-self: stretch;
         }

         .history-modal-body {
            background: #e8edf3;
            padding: 16px 18px 20px;
            border-radius: 0 0 14px 14px;
            max-height: min(70vh, 520px);
            overflow-y: auto;
         }
         .activity-timeline-wrap {
            background: transparent;
            padding: 0;
         }
         .activity-timeline-empty {
            margin: 0;
            font-size: 15px;
            color: #64748b;
            text-align: center;
            line-height: 1.5;
            padding: 12px 8px;
         }
         .activity-timeline {
            list-style: none;
            margin: 0;
            padding: 0;
         }
         .activity-timeline-item {
            display: flex;
            align-items: flex-start;
            gap: 12px;
            padding: 0 0 14px 0;
         }
         .activity-timeline-item:last-child {
            padding-bottom: 0;
         }
         .activity-timeline-icon {
            flex-shrink: 0;
            width: 28px;
            height: 28px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #f1f5f9;
            border-radius: 50%;
            font-size: 13px;
            line-height: 1;
            border: 1px solid #cbd5e1;
            margin-top: 2px;
         }
         .activity-timeline-time {
            display: block;
            font-size: 12px;
            color: #64748b;
            font-weight: 600;
            margin-bottom: 4px;
         }
         .activity-timeline-event {
            display: block;
            font-size: 14px;
            color: #0f172a;
            font-weight: 700;
         }
         .activity-timeline-note {
            margin: 6px 0 0;
            font-size: 13px;
            color: #334155;
            line-height: 1.45;
            white-space: pre-wrap;
         }
         .activity-timeline-body {
            flex: 1;
            min-width: 0;
            background: #f8fafc;
            border-radius: 10px;
            padding: 10px 12px;
            border: 1px solid #e2e8f0;
         }
         
         .filter-actions {
            display: flex;
            align-items: center;
            gap: 10px;
            flex-wrap: wrap;
         }
         
         .btn-filter {
            padding: 10px 15px;
            background: var(--green);
            border: none;
            border-radius: 10px;
            color: #fff;
            cursor: pointer;
            font-weight: 700;
            white-space: nowrap;
         }
         
         .btn-filter:hover {
            background: var(--green-dark);
         }
         
         .btn-clear {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 10px 15px;
            background: var(--border);
            border-radius: 10px;
            color: var(--text);
            text-decoration: none;
            font-size: 14px;
            white-space: nowrap;
         }
         
         .search-info {
            color: var(--muted-2);
            font-size: 14px;
            margin-bottom: 20px;
         }
         
         @media (max-width: 768px) {
         
            .header {
               flex-direction: column;
               align-items: stretch;
               gap: 14px;
               padding: 15px;
            }
         
            .header .actions {
               width: 100%;
               display: flex;
               gap: 10px;
            }
         
            .header .actions a {
               flex: 1;
               justify-content: center;
            }
         
            .search-section {
               padding: 16px;
               border-radius: 18px;
            }
         
            .search-filter-section {
               flex-direction: column;
               align-items: stretch;
               gap: 14px;
            }
         
            .search-box {
               width: 100%;
               flex-direction: column;
               align-items: stretch;
               gap: 12px;
               min-width: 100%;
            }
         
            .brand-logo-container {
               width: 100%;
               justify-content: center;
               padding: 12px;
            }
         
            .search-wrapper {
               width: 100%;
            }
         
            .search-wrapper input {
               width: 100%;
               font-size: 16px;
            }
         
            .date-filter {
               width: 100%;
               flex-direction: column;
               align-items: stretch;
               min-width: 100%;
            }
         
            .date-filter input[type="date"] {
               width: 100%;
               min-width: 100%;
            }
         
            .filter-actions {
               width: 100%;
               flex-direction: column;
            }
         
            .btn-filter,
            .btn-clear,
            .search-box button {
               width: 100%;
               justify-content: center;
            }

            .stats {
               grid-template-columns: repeat(2, minmax(0, 1fr));
               gap: 10px;
            }
            .stat-card small,
            .stat-card .stat-card-hint {
               display: none !important;
            }
         
            .container {
               padding: 12px;
            }
         }
         .stats {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 12px;
            margin-bottom: 14px;
         }
         .stat-card {
            background:
               linear-gradient(180deg, var(--card), rgba(30, 41, 59, 0.86)),
               radial-gradient(
                  circle at right top,
                  rgba(255, 255, 255, 0.08),
                  transparent 42%
               );
            border: 1px solid var(--border-soft);
            padding: 14px 16px;
            border-radius: 14px;
            cursor: pointer;
            transition: all 0.22s ease;
            overflow: hidden;
         }
         .stat-card:hover {
            border-color: var(--green);
            transform: translateY(-2px);
            box-shadow:
               0 18px 38px rgba(0, 0, 0, 0.22),
               0 0 22px var(--glow);
         }
         .stat-card h3 {
            margin: 0 0 4px;
            color: var(--muted-2);
            font-size: 13px;
            font-weight: 650;
            line-height: 1.25;
         }
         .stat-card p {
            margin: 0;
            font-size: clamp(22px, 5vw, 28px);
            font-weight: 900;
            line-height: 1.1;
         }
         .stat-card.blue {
            border-left: 4px solid var(--blue);
         }
         .stat-card.green {
            border-left: 4px solid var(--green);
         }
         .stat-card.purple {
            border-left: 4px solid var(--purple);
         }
         .stat-card.gray {
            border-left: 4px solid var(--gray);
         }
         .stat-card.red {
            border-left: 4px solid var(--red);
         }
         .badge.problem {
            background: rgba(239, 68, 68, 0.16);
            color: var(--red);
            border-color: var(--red);
         }
         .list-item.problem {
            border-left: 6px solid var(--red);
         }
         .chart-container {
            background: rgba(15, 23, 42, 0.82);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 22px;
            margin-bottom: 25px;
            overflow: hidden;
            box-shadow: 0 24px 60px rgba(0, 0, 0, 0.22);
            backdrop-filter: blur(6px);
         }
         .chart-toggle {
            width: 100%;
            background: transparent;
            border: none;
            color: var(--text);
            padding: 16px 18px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 15px;
            cursor: pointer;
            text-align: left;
         }
         .chart-toggle:hover {
            background: rgba(16, 185, 129, 0.07);
         }
         .chart-toggle-title {
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: 18px;
            font-weight: 800;
         }
         .chart-toggle-icon {
            width: 34px;
            height: 34px;
            border-radius: 10px;
            background: rgba(15, 23, 42, 0.78);
            border: 1px solid var(--border-soft);
            display: inline-flex;
            align-items: center;
            justify-content: center;
            transition:
               transform 0.25s ease,
               color 0.25s ease;
            color: var(--muted-2);
         }
         .chart-container.is-open .chart-toggle-icon {
            transform: rotate(180deg);
