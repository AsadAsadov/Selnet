<div class="customer-details">
  <h2 class="customer-name"><%= result.ad_soyad %></h2>

  <div class="info-grid">
    <% 
      // Massivi birbaşa burada təyin edirik ki, "not defined" xətası verməsin
      const qeydText = String(result.qeyd || '').trim().toLowerCase();
      const isProblem = qeydText.includes('problem');
      const isArchived = ['hə', 'he', 'true', '1'].includes(String(result.arxiv || '').trim().toLowerCase());
      const displayFields = [
        { key: 'odeme_kodu', label: 'ÖDƏNİŞ KODU' },
        { key: 'telefon', label: 'TELEFON', isPhone: true },
        { key: 'ayliq_odenis', label: 'AYLIQ ÖDƏNİŞ', suffix: ' AZN' },
        { key: 'fin', label: 'Ş/V FİN' },
        { key: 'seriya', label: 'Ş/V SERİYA' },
        { key: 'modem', label: 'MODEM S/N' },
        { key: 'tvbox', label: 'TV BOX' },
        { key: 'komendant', label: 'KOMENDANT' },
        { key: 'timestamp', label: 'QEYDİYYAT TARİXİ' },
        { key: 'unvan', label: 'ÜNVAN' },
        { key: 'qeyd', label: 'QEYD' }
      ];

      // Problem statusu yalnız problem qeydli müştərilərdə göstərilir
      if (isProblem && String(result.netice || '').trim() !== '') {
        displayFields.push({ key: 'netice', label: 'İŞİN NƏTİCƏSİ', isStatus: true });
      }

      if (isProblem) {
        displayFields.push({ key: 'problem_sebebi', label: 'PROBLEMIN SƏBƏBİ' });
      }

      displayFields.forEach(field => { 
        const val = result[field.key];
        // Boş olmayan və 'null' olmayan məlumatları göstər
        if (val && val.toString().toLowerCase() !== 'null' && val.toString().trim() !== '') {
    %>
      <div class="info-item">
        <label><%= field.label %></label>
        <p class="info-value">
          <% if (field.isPhone) { %>
            <%= val %>
            <a href="https://wa.me/994<%= val.toString().replace(/^0/, '') %>" target="_blank" class="btn-wa">WhatsApp</a>
          <% } else if (field.isStatus) { %>
            <span class="status-badge"><%= val %></span>
          <% } else { %>
            <%= val %><%= field.suffix || '' %>
          <% } %>
        </p>
      </div>
    <% 
        }
      }); 
    %>
  </div>

  <% 
    let historyRows = [];
    try {
      const h = result.history;
      if (Array.isArray(h)) historyRows = h;
      else if (typeof h === 'string' && h.trim()) {
        const p = JSON.parse(h);
        if (Array.isArray(p)) historyRows = p;
      }
    } catch (e) { historyRows = []; }
    historyRows = historyRows
      .filter(x => x && (x.event || x.note))
      .map(x => ({
        date: x.date || '',
        event: String(x.event || '').trim(),
        note: String(x.note || '').trim()
      }))
      .sort((a, b) => {
        const ta = Date.parse(a.date) || 0;
        const tb = Date.parse(b.date) || 0;
        return tb - ta;
      });
    function historyIcon(ev, note) {
      const t = (String(ev) + ' ' + String(note)).toLowerCase();
      if (t.includes('arxiv')) return '📦';
      if (t.includes('problem')) return '🔴';
      if (t.includes('admin')) return '📝';
      return '📋';
    }
    function formatHistoryWhen(iso) {
      if (!iso) return '—';
      const d = new Date(iso);
      if (Number.isNaN(d.getTime())) return String(iso);
      return d.toLocaleString('az-AZ', { dateStyle: 'short', timeStyle: 'short' });
    }
  %>
  <details class="customer-activity-details">
    <summary class="customer-activity-summary">📜 Fəaliyyət Tarixçəsi</summary>
    <div class="activity-timeline-wrap">
      <% if (!historyRows.length) { %>
        <p class="activity-timeline-empty">Hələ tarixçə qeydi yoxdur.</p>
      <% } else { %>
        <ul class="activity-timeline">
          <% historyRows.forEach(function (row) { %>
            <li class="activity-timeline-item">
              <span class="activity-timeline-icon" aria-hidden="true"><%= historyIcon(row.event, row.note) %></span>
              <div class="activity-timeline-body">
                <time class="activity-timeline-time" datetime="<%= row.date %>"><%= formatHistoryWhen(row.date) %></time>
                <strong class="activity-timeline-event"><%= row.event %></strong>
                <% if (row.note) { %><p class="activity-timeline-note"><%= row.note %></p><% } %>
              </div>
            </li>
          <% }); %>
        </ul>
      <% } %>
    </div>
  </details>

  <div class="modal-actions" style="margin-top: 20px; display: flex; gap: 10px;">
    <a href="/edit/<%= result.odeme_kodu %>" class="btn-edit" style="background: #3b82f6; color: white; padding: 10px; border-radius: 5px; text-decoration: none;">Redaktə</a>
    
    <button onclick="deleteCustomer('<%= result.odeme_kodu %>', '<%= result.id %>')" class="btn-delete" style="background: #ef4444; color: white; padding: 10px; border-radius: 5px; border: none; cursor: pointer;">Sil</button>
    
    <button onclick="toggleArchive('<%= result.odeme_kodu %>', '<%= result.id %>', <%= !isArchived %>)" class="btn-archive" style="background: #6b7280; color: white; padding: 10px; border-radius: 5px; border: none; cursor: pointer;">
      <%= isArchived ? 'Arxivdən Çıxart' : 'Arxivə Göndər' %>
    </button>
  </div>
</div>
