<%
const fields = [
  { key: 'odeme_kodu', label: 'ÖDƏNİŞ KODU' },
  { key: 'telefon', label: 'TELEFON', isPhone: true },
  { key: 'modem', label: 'MODEM S/N' },
  { key: 'tvbox', label: 'TV BOX' },
  { key: 'timestamp', label: 'QEYDİYYAT TARİXİ', isDate: true },
  { key: 'unvan', label: 'ÜNVAN' },
  { key: 'qeyd', label: 'QEYD' },
  { key: 'problem_sebebi', label: 'PROBLEMIN SƏBƏBİ', condition: (r) => r.qeyd === 'Problem' }
];
%>

<% fields.forEach(field => { %>
  <% const rawValue = result[field.key]; %>
  <% const value = field.isDate ? formatDate(rawValue) : rawValue; %>
  <% const shouldShow = field.condition ? field.condition(result) : true; %>
  <% if (shouldShow && value && value.toString().trim() !== '' && value.toString().toLowerCase() !== 'yox') { %>
    <div class="info-item">
      <label><%= field.label %></label>
      <p class="info-value <%= field.isPhone ? 'info-value--contact' : '' %>">
        <% if (field.isPhone) { %>
          <% const cleanTel = value.toString().replace(/\s/g, ''); %>
          <% const waTel = '994' + cleanTel.replace(/^0/, ''); %>
          <a href="tel:<%= cleanTel %>"><%= value %></a>
          <a href="https://wa.me/<%= waTel %>" target="_blank" class="btn-wa">
            <i class="fa-brands fa-whatsapp"></i> WhatsApp
          </a>
        <% } else { %>
          <span class="info-text"><%= value %></span>
        <% } %>
      </p>
    </div>
  <% } %>
<% }) %>
