<div class="customer-details">
  <% if (typeof omitCustomerName === 'undefined' || !omitCustomerName) { %>
  <h2 class="customer-name"><%= result.ad_soyad %></h2>
  <% } %>

  <div class="info-grid">
    <% 
      // Massivi birbaşa burada təyin edirik ki, "not defined" xətası verməsin
      const qeydText = String(result.qeyd || '').trim().toLowerCase();
      const isProblem = qeydText.includes('problem');
      const isArchived = result.arxiv === true || ['hə', 'he', 'true', '1'].includes(String(result.arxiv ?? '').trim().toLowerCase());
      const displayFields = [
        { key: 'odeme_kodu', label: 'ÖDƏNİŞ KODU' },
        { key: 'telefon', label: 'TELEFON', isPhone: true },
        { key: 'ayliq_odenis', label: 'AYLIQ ÖDƏNİŞ', suffix: ' AZN' },
        { key: 'fin', label: 'Ş/V FİN' },
        { key: 'seriya', label: 'Ş/V SERİYA' },
        { key: 'modem', label: 'MODEM S/N' },
        { key: 'tvbox', label: 'TV BOX' },
        { key: 'komendant', label: 'KOMENDANT' },
        { key: 'timestamp', label: 'QEYDİYYAT TARİXİ' },
        { key: 'unvan', label: 'ÜNVAN' },
        { key: 'qeyd', label: 'QEYD' }
      ];

      // Problem statusu yalnız problem qeydli müştərilərdə göstərilir
      if (isProblem && String(result.netice || '').trim() !== '') {
        displayFields.push({ key: 'netice', label: 'İŞİN NƏTİCƏSİ', isStatus: true });
      }

      if (isProblem) {
        displayFields.push({ key: 'problem_sebebi', label: 'PROBLEMIN SƏBƏBİ' });
      }

      const fullSpanKeys = ['unvan', 'qeyd', 'problem_sebebi', 'netice'];
      displayFields.forEach(field => { 
        const val = result[field.key];
        // Boş olmayan və 'null' olmayan məlumatları göstər
        if (val && val.toString().toLowerCase() !== 'null' && val.toString().trim() !== '') {
    %>
      <div class="info-item<%= fullSpanKeys.includes(field.key) ? ' info-item--span-2' : '' %>">
        <label><%= field.label %></label>
        <p class="info-value">
          <% if (field.isPhone) { %>
            <%= val %>
            <a href="https://wa.me/994<%= val.toString().replace(/^0/, '') %>" target="_blank" class="btn-wa">WhatsApp</a>
          <% } else if (field.isStatus) { %>
            <span class="status-badge"><%= val %></span>
          <% } else { %>
            <%= val %><%= field.suffix || '' %>
          <% } %>
        </p>
      </div>
    <% 
        }
      }); 
    %>
  </div>

  <% 
    let historyRows = [];
    try {
      const h = result.history;
      if (Array.isArray(h)) historyRows = h;
      else if (typeof h === 'string' && h.trim()) {
        const p = JSON.parse(h);
        if (Array.isArray(p)) historyRows = p;
      }
    } catch (e) { historyRows = []; }
    historyRows = historyRows
      .filter(x => x && (x.event || x.note))
      .map(x => ({
        date: x.date || '',
        event: String(x.event || '').trim(),
        note: String(x.note || '').trim()
      }))
      .sort((a, b) => {
        const ta = Date.parse(a.date) || 0;
        const tb = Date.parse(b.date) || 0;
        return tb - ta;
      });
  %>
  <div class="customer-card-actions">
    <button
      type="button"
      class="btn-customer-history btn-card-action"
      data-history="<%= encodeURIComponent(JSON.stringify(historyRows)) %>"
      onclick="openCustomerHistoryModal(this)"
    >
      📜 Fəaliyyət Tarixçəsi
    </button>
    <a href="/edit/<%= result.odeme_kodu %>" class="btn-edit btn-card-action">📝 Redaktə</a>
    <button type="button" class="btn-delete btn-card-action" onclick="deleteCustomer('<%= result.odeme_kodu %>', '<%= result.id %>')">🗑️ Sil</button>
    <% if (isArchived) { %>
    <button type="button" class="btn-unarchive btn-card-action" onclick="toggleArchive('<%= result.odeme_kodu %>', '<%= result.id %>', false)">📦 Arxivdən Çıxart</button>
    <% } else { %>
    <button type="button" class="btn-archive btn-card-action" onclick="toggleArchive('<%= result.odeme_kodu %>', '<%= result.id %>', true)">📦 Arxivə Göndər</button>
    <% } %>
  </div>
</div>
