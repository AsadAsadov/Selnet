<div class="customer-details-card">
  <div class="card-header-compact">
    <h2 class="customer-name-text"><%= result.ad_soyad %></h2>
  </div>

  <div class="info-grid-compact">
    <% 
      const displayFields = [
        { key: 'odeme_kodu', label: 'KOD' },
        { key: 'telefon', label: 'TEL', isPhone: true },
        { key: 'ayliq_odenis', label: 'ÖDƏNİŞ', suffix: ' AZN' },
        { key: 'seriya', label: 'SERİYA' },
        { key: 'modem', label: 'MODEM' },
        { key: 'tvbox', label: 'TV BOX' },
        { key: 'timestamp', label: 'TARİX' },
        { key: 'unvan', label: 'ÜNVAN' }
      ];

      displayFields.forEach(field => { 
        const val = result[field.key];
        if (val && val.toString().trim() !== '') {
    %>
      <div class="info-item-compact <%= field.key === 'unvan' ? 'full-width' : '' %>">
        <label><%= field.label %></label>
        <div class="value-container">
          <span class="val-text"><%= val %><%= field.suffix || '' %></span>
          <% if (field.isPhone) { %>
            <a href="https://wa.me/994<%= val.toString().replace(/^0/, '') %>" target="_blank" class="wa-badge">WA</a>
          <% } %>
        </div>
      </div>
    <% } }); %>
  </div>

  <div class="photo-section-compact">
    <div class="photo-flex-row">
      <button class="btn-photo-mini">🖼️ Şəkil 1</button>
      <button class="btn-photo-mini">🖼️ Şəkil 2</button>
      <button class="btn-photo-mini">🖼️ Şəkil 3</button>
    </div>
  </div>

  <div class="action-buttons-grid">
    <button class="btn-action hist" onclick="openHistory()"><i class="fa fa-history"></i> Tarixçə</button>
    <a href="/edit/<%= result.id %>" class="btn-action edit"><i class="fa fa-edit"></i> Redaktə</a>
    <button class="btn-action del" onclick="deleteCust()"><i class="fa fa-trash"></i> Sil</button>
    <button class="btn-action arch" onclick="archiveCust()"><i class="fa fa-archive"></i> Arxiv</button>
  </div>
</div>

<style>
  .customer-details-card {
    padding: 12px;
    background: #1e2530; /* Şəkildəki tünd rəng */
    border-radius: 12px;
    margin-bottom: 10px;
    border: 1px solid #2d3748;
  }

  .customer-name-text {
    font-size: 16px !important;
    font-weight: 700;
    color: #fff;
    margin: 0 0 10px 0 !important;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    border-bottom: 1px solid #2d3748;
    padding-bottom: 8px;
  }

  .info-grid-compact {
    display: grid !important;
    grid-template-columns: 1fr 1fr !important; /* Məcburi 2 sütun */
    gap: 8px 15px;
  }

  .info-item-compact {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .full-width { grid-column: span 2; }

  .info-item-compact label {
    font-size: 9px;
    color: #a0aec0;
    text-transform: uppercase;
    margin-bottom: 2px;
  }

  .val-text {
    font-size: 13px;
    color: #edf2f7;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .wa-badge {
    background: #25d366;
    font-size: 9px;
    padding: 1px 4px;
    border-radius: 4px;
    color: white;
    margin-left: 5px;
  }

  .photo-flex-row {
    display: flex !important;
    flex-direction: row !important; /* Şəkillər yan-yana */
    gap: 5px;
    margin: 12px 0;
  }

  .btn-photo-mini {
    flex: 1;
    background: #3182ce;
    border: none;
    padding: 6px;
    font-size: 10px;
    color: white;
    border-radius: 6px;
  }

  .action-buttons-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
    margin-top: 10px;
  }

  .btn-action {
    padding: 8px;
    font-size: 11px;
    border-radius: 8px;
    border: none;
    color: white;
    font-weight: bold;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 5px;
  }

  .btn-action.hist { background: #4a5568; }
  .btn-action.edit { background: #3182ce; }
  .btn-action.del { background: #e53e3e; }
  .btn-action.arch { background: #718096; }
</style>