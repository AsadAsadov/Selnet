<%
const fields = [
  { key: 'Telefon nömrəsi', label: 'Telefon', type: 'tel' },
  { key: 'Aylıq ödəniş', label: 'Aylıq Ödəniş', suffix: ' AZN' },
  { key: 'Ş/V FİN', label: 'Ş/V FİN' },
  { key: 'Ş/V Seriya', label: 'Ş/V Seriya' },
  { key: 'Modem S/N', label: 'Modem S/N' },
  { key: 'Tv Box', label: 'TV Box' },
  { key: 'Komendant', label: 'Komendant' },
  { key: 'Timestamp', label: 'Qeydiyyat tarixi', type: 'date' },
  { key: 'Ünvan', label: 'Ünvan', full: true },
  { key: 'Netice', label: 'İşin Nəticəsi', type: 'status', full: true },
  { key: 'Qeyd', label: 'Qeyd', full: true },
  { key: 'Müqavilə və Modemin şəkli', label: 'Müqavilə Şəkli', type: 'link', full: true }
];
%>

<% fields.forEach(field => { %>
  <% const rawValue = result[field.key]; %>
  <% const value = field.type === 'date' ? formatDate(rawValue) : rawValue; %>
  <% if (value && value.toString().trim()!== '' && value.toString().toLowerCase()!== 'yox') { %>
    <div class="info-item <%= field.full? 'full-width' : '' %>">
      <label><%= field.label %></label>
      <p class="info-value <%= field.type === 'tel' ? 'info-value--contact' : (field.type === 'link' ? 'info-value--links' : '') %>">
        <% if (field.type === 'tel') { %>
          <% const cleanTel = value.toString().replace(/\s/g, ''); %>
          <% const waTel = '994' + cleanTel.replace(/^0/, ''); %>
          <a href="tel:<%= cleanTel %>"><%= value %></a>
          <a href="https://wa.me/<%= waTel %>" target="_blank" class="btn-wa">
            <i class="fa-brands fa-whatsapp"></i> WhatsApp
          </a>
        <% } else if (field.type === 'link') { %>
          <% const links = value.split(',').map(l => l.trim()); %>
          <% links.forEach((link, i) => { %>
            <a href="<%= link %>" target="_blank">Şəkil <%= i+1 %></a>
          <% }) %>
        <% } else if (field.type === 'status') { %>
          <% if (value === 'Həll olundu') { %>
            <span class="result-badge result-solved" style="background: rgba(16, 185, 129, 0.15); color: #10b981; padding: 6px 14px; border-radius: 10px; border: 1px solid #10b981; font-weight: 700; display: inline-flex; align-items: center; gap: 8px;">
              <i class="fa-solid fa-circle-check"></i> Həll olundu
            </span>
          <% } else { %>
            <span class="result-badge result-not-solved" style="background: rgba(239, 68, 68, 0.15); color: #ef4444; padding: 6px 14px; border-radius: 10px; border: 1px solid #ef4444; font-weight: 700; display: inline-flex; align-items: center; gap: 8px;">
              <i class="fa-solid fa-circle-xmark"></i> Həll olunmadı
            </span>
          <% } %>
        <% } else { %>
          <span class="info-text"><%= value %><%= field.suffix || '' %></span>
        <% } %>
      </p>
    </div>
  <% } %>
<% }) %>
