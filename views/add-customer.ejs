<!DOCTYPE html>
<html lang="az">
<head>
    <title>Müştəri Əlavə Et | Selnet</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
    <%- include('partials/customer-form-styles') %>

    <style>
        body {
            background-image: url("https://raw.githubusercontent.com/AsadAsadov/Selnet/main/home.jpg");
            background-size: cover;
            background-position: center;
            background-repeat: no-repeat;
            background-attachment: fixed;
            min-height: 100vh;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        .header {
            background: rgba(15, 23, 42, 0.85);
            backdrop-filter: blur(14px);
            -webkit-backdrop-filter: blur(14px);
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
            padding: 15px 25px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .header .logo h1 {
            color: #fff;
            margin: 0;
            font-size: 1.5rem;
        }

        .header a {
            color: #fff;
            text-decoration: none;
            font-weight: 600;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .hidden-field {
            display: none !important;
        }

        /* Grid sistemi */
        .form-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 20px;
        }

        .full-width {
            grid-column: 1 / -1;
        }

        @media (max-width: 768px) {
            .form-grid {
                grid-template-columns: 1fr;
            }
        }

        /* Alert dizaynı */
        .alert {
            padding: 15px;
            border-radius: 10px;
            margin-bottom: 20px;
            display: flex;
            align-items: center;
            gap: 10px;
        }
        .success { background: rgba(34, 197, 94, 0.2); color: #4ade80; border: 1px solid #22c55e; }
        .error { background: rgba(239, 68, 68, 0.2); color: #f87171; border: 1px solid #ef4444; }
    </style>
</head>

<body>

<div class="header">
    <div class="logo">
        <h1><i class="fa-solid fa-user-plus"></i> Yeni Müştəri</h1>
    </div>
    <a href="/"><i class="fa-solid fa-house"></i> Ana Səhifə</a>
</div>

<div class="container" style="max-width: 800px; margin: 40px auto; padding: 0 20px;">

    <div class="form-card" style="background: rgba(15, 23, 42, 0.9); padding: 30px; border-radius: 20px; border: 1px solid rgba(255,255,255,0.1); color: #fff;">

        <h2 style="margin-top: 0; margin-bottom: 25px;"><i class="fa-solid fa-plus-circle"></i> Müştəri Məlumatları</h2>

        <% if (success) { %>
            <div class="alert success"><i class="fa-solid fa-circle-check"></i> <%= success %></div>
        <% } %>

        <% if (error) { %>
            <div class="alert error"><i class="fa-solid fa-triangle-exclamation"></i> <%= error %></div>
        <% } %>

        <form method="POST" id="customerForm">
            <div class="form-grid">

                <div class="form-group full-width">
                    <label>Əməliyyat Növü <span style="color:red">*</span></label>
                    <select id="operationType" name="operationType" required style="width:100%; padding:12px; border-radius:10px; background:#1e293b; color:#fff; border:1px solid #334155;">
                        <option value="Qoşulma" selected>Qoşulma</option>
                        <option value="Köçürmə">Köçürmə</option>
                        <option value="Problem">Problem</option>
                    </select>
                </div>

                <div class="form-group">
                    <label>Ödəniş kodu <span style="color:red">*</span></label>
                    <input type="text" name="odemeKodu" required style="width:100%; padding:12px; border-radius:8px; background:#1e293b; color:#fff; border:1px solid #334155;">
                </div>

                <div class="form-group">
                    <label>Ünvan <span style="color:red">*</span></label>
                    <input type="text" name="unvan" required style="width:100%; padding:12px; border-radius:8px; background:#1e293b; color:#fff; border:1px solid #334155;">
                </div>

                <div class="form-group">
                    <label>Ad Soyad Ata adı <span style="color:red">*</span></label>
                    <input type="text" name="adSoyad" required style="width:100%; padding:12px; border-radius:8px; background:#1e293b; color:#fff; border:1px solid #334155;">
                </div>

                <div class="form-group">
                    <label>Telefon <span style="color:red">*</span></label>
                    <input type="tel" name="telefon" placeholder="0501234567" required style="width:100%; padding:12px; border-radius:8px; background:#1e293b; color:#fff; border:1px solid #334155;">
                </div>

                <div class="form-group problem-dependent">
                    <label>Aylıq ödəniş</label>
                    <input type="number" name="ayliqOdenis" step="0.01" style="width:100%; padding:12px; border-radius:8px; background:#1e293b; color:#fff; border:1px solid #334155;">
                </div>

                <div class="form-group problem-dependent">
                    <label>Komendant</label>
                    <input type="text" name="komendant" style="width:100%; padding:12px; border-radius:8px; background:#1e293b; color:#fff; border:1px solid #334155;">
                </div>

                <div class="form-group problem-dependent">
                    <label>Ş/V FİN</label>
                    <input type="text" name="fin" style="width:100%; padding:12px; border-radius:8px; background:#1e293b; color:#fff; border:1px solid #334155;">
                </div>

                <div class="form-group problem-dependent">
                    <label>Ş/V Seriya</label>
                    <input type="text" name="seriya" style="width:100%; padding:12px; border-radius:8px; background:#1e293b; color:#fff; border:1px solid #334155;">
                </div>

                <div class="form-group">
                    <label>Modem S/N</label>
                    <input type="text" name="modem" style="width:100%; padding:12px; border-radius:8px; background:#1e293b; color:#fff; border:1px solid #334155;">
                </div>

                <div class="form-group">
                    <label>TV Box</label>
                    <input type="text" name="tvbox" style="width:100%; padding:12px; border-radius:8px; background:#1e293b; color:#fff; border:1px solid #334155;">
                </div>

                <div id="qeydGroup" class="form-group full-width">
                    <label>Qeyd</label>
                    <textarea name="qeyd" placeholder="Əlavə məlumat..." style="width:100%; padding:12px; border-radius:8px; background:#1e293b; color:#fff; border:1px solid #334155; min-height:80px;"></textarea>
                </div>

                <div class="form-group full-width problem-dependent">
                    <label>Drive Linkləri</label>
                    <textarea name="driveLinks" placeholder="https://drive.google.com/..." style="width:100%; padding:12px; border-radius:8px; background:#1e293b; color:#fff; border:1px solid #334155;"></textarea>
                </div>

                <div id="resultGroup" class="form-group full-width hidden-field">
                    <label>Nəticə (Sheet P sütunu)</label>
                    <select name="netice" style="width:100%; padding:12px; border-radius:10px; background:#1e293b; color:#fff; border:1px solid #334155;">
                        <option value="">Seçin...</option>
                        <option value="Həll olundu">Həll olundu</option>
                        <option value="Həll olunmadı">Həll olunmadı</option>
                    </select>
                </div>

            </div>

            <button type="submit" class="btn-submit" style="width:100%; margin-top:25px; padding:15px; background:#22c55e; color:#fff; border:none; border-radius:12px; font-weight:bold; cursor:pointer; font-size:1rem;">
                <i class="fa-solid fa-floppy-disk"></i> Yadda Saxla
            </button>
        </form>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const operationType = document.getElementById('operationType');
        const problemFields = document.querySelectorAll('.problem-dependent');
        const resultGroup = document.getElementById('resultGroup');
        const qeydGroup = document.getElementById('qeydGroup');

        function updateForm() {
            const isProblem = operationType.value === 'Problem';

            // 1. Problem olanda Qoşulma/Köçürmə sahələrini GİZLƏ və TƏMİZLƏ
            problemFields.forEach(section => {
                section.classList.toggle('hidden-field', isProblem);
                const inputs = section.querySelectorAll('input, textarea, select');
                inputs.forEach(input => {
                    input.disabled = isProblem;
                    if(isProblem) input.value = ""; // Dəyəri sıfırla ki sheet-ə getməsin
                });
            });

            // 2. Nəticə hissəsini göstər/gizlə
            resultGroup.classList.toggle('hidden-field', !isProblem);
            const neticeInput = resultGroup.querySelector('select');
            neticeInput.disabled = !isProblem;
            if(!isProblem) neticeInput.value = "";

            // 3. Qeyd hissəsini Problem zamanı gizlə
            qeydGroup.classList.toggle('hidden-field', isProblem);
            const qeydTextarea = qeydGroup.querySelector('textarea');
            qeydTextarea.disabled = isProblem;
            if(isProblem) qeydTextarea.value = "";
        }

        operationType.addEventListener('change', updateForm);
        updateForm(); // Səhifə yüklənəndə çağır
    });
</script>

</body>
</html>
