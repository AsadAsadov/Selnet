<!DOCTYPE html>
<html>
<head>
    <title>Müştəri Əlavə Et</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
    <%- include('partials/customer-form-styles') %>
    <style>
        body {
            background-image: url("https://raw.githubusercontent.com/AsadAsadov/Selnet/main/home.jpg");
            background-size: cover;
            background-position: center;
            background-repeat: no-repeat;
            background-attachment: fixed;
            min-height: 100vh;
        }
        .header {
            background: rgba(15, 23, 42, 0.78);
            backdrop-filter: blur(14px);
            -webkit-backdrop-filter: blur(14px);
            border-bottom: 1px solid rgba(255, 255, 255, 0.08);
            box-shadow: 0 18px 50px rgba(0, 0, 0, 0.18);
            padding: 18px 22px;
        }
        .header .logo h1,
        .header > a {
            color: #f8fafc;
        }
        .header > a {
            text-decoration: none;
            font-weight: 700;
            display: inline-flex;
            align-items: center;
            gap: 8px;
        }
        .form-group {
            transition: all 0.25s ease;
        }
        .hidden-field {
            max-height: 0;
            opacity: 0;
            visibility: hidden;
            overflow: hidden;
            margin: 0;
            padding: 0;
        }
        .hidden-field .field-hint,
        .hidden-field label,
        .hidden-field input,
        .hidden-field select,
        .hidden-field textarea {
            display: none;
        }
    </style>
</head>
<body>
<div class="header">
    <div class="logo"><h1><i class="fa-solid fa-user-plus"></i> Yeni Müştəri</h1></div>
    <a href="/"><i class="fa-solid fa-home"></i> Ana Səhifə</a>
</div>
<div class="container">
    <a href="/" class="btn-back"><i class="fa-solid fa-arrow-left"></i> Geri</a>

    <div class="form-card">
        <h2><i class="fa-solid fa-plus-circle"></i> Müştəri Əlavə Et</h2>

        <% if (success) { %>
            <div class="alert success"><i class="fa-solid fa-check-circle"></i> <%= success %></div>
        <% } %>
        <% if (error) { %>
            <div class="alert error"><i class="fa-solid fa-exclamation-circle"></i> <%= error %></div>
        <% } %>

        <form method="POST" class="customer-form">
            <div class="form-grid">
                <div class="form-group full-width">
                    <label>Əməliyyat Növü <span class="required">*</span></label>
                    <select id="operationType" name="operationType" required>
                        <option value="Qoşulma" selected>Qoşulma</option>
                        <option value="Köçürmə">Köçürmə</option>
                        <option value="Problem">Problem</option>
                    </select>
                </div>
                <div class="form-group">
                    <label>Ödəniş kodu <span class="required">*</span></label>
                    <input type="text" name="odemeKodu" autocomplete="off" required>
                </div>
                <div class="form-group problem-dependent">
                    <label>Aylıq ödəniş <span class="required">*</span></label>
                    <input type="number" name="ayliqOdenis" step="0.01" inputmode="decimal" required>
                </div>

                <div class="form-group">
                    <label>Ad Soyad Ata adı <span class="required">*</span></label>
                    <input type="text" name="adSoyad" autocomplete="name" required>
                </div>
                <div class="form-group">
                    <label>Telefon nömrəsi <span class="required">*</span></label>
                    <input type="tel" name="telefon" placeholder="0501234567" autocomplete="tel" inputmode="tel" required>
                </div>

                <div class="form-group problem-dependent">
                    <label>Ş/V FİN</label>
                    <input type="text" name="fin" autocomplete="off">
                </div>
                <div class="form-group problem-dependent">
                    <label>Ş/V Seriya</label>
                    <input type="text" name="seriya" autocomplete="off">
                </div>

                <div class="form-group">
                    <label>Modem S/N</label>
                    <input type="text" name="modem" autocomplete="off">
                </div>
                <div class="form-group">
                    <label>TV Box</label>
                    <input type="text" name="tvbox" autocomplete="off">
                </div>

                <div class="form-group">
                    <label>Ünvan <span class="required">*</span></label>
                    <input type="text" name="unvan" autocomplete="street-address" required>
                </div>
                <div class="form-group problem-dependent">
                    <label>Komendant</label>
                    <input type="text" name="komendant" autocomplete="off">
                </div>

                <div class="form-group full-width">
                    <label>Qeyd</label>
                    <textarea name="qeyd" placeholder="qoşulma / köçürmə yaz"></textarea>
                </div>

                <div class="form-group full-width problem-dependent">
                    <label>Müqavilə və Modemin şəkli (Drive linkləri)</label>
                    <textarea class="drive-links" name="driveLinks" placeholder="https://drive.google.com/..."></textarea>
                    <span class="field-hint">Birdən çox link üçün vergül istifadə et və ya hər sətirdə 1 link yaz.</span>
                </div>

                <div id="resultGroup" class="form-group full-width hidden-field">
                    <label>Nəticə</label>
                    <select name="netice" required>
                        <option value="Həll olundu">Həll olundu</option>
                        <option value="Həll olunmadı">Həll olunmadı</option>
                    </select>
                </div>
            </div>

            <button type="submit" class="btn-submit">
                <i class="fa-solid fa-floppy-disk"></i> Yadda Saxla
            </button>
        </form>
    </div>
</div>
<script>
    document.addEventListener('DOMContentLoaded', function () {
        var operationType = document.getElementById('operationType');
        var problemFields = document.querySelectorAll('.problem-dependent');
        var resultGroup = document.getElementById('resultGroup');

        function setSectionVisibility(section, hidden) {
            section.classList.toggle('hidden-field', hidden);
            Array.prototype.forEach.call(section.querySelectorAll('input, select, textarea'), function (element) {
                element.disabled = hidden;
            });
        }

        function updateFormFields() {
            var value = operationType.value;
            var hideProblemFields = value === 'Problem';

            problemFields.forEach(function (section) {
                setSectionVisibility(section, hideProblemFields);
            });
            setSectionVisibility(resultGroup, !hideProblemFields);
        }

        operationType.addEventListener('change', updateFormFields);
        updateFormFields();
    });
</script>
</body>
</html>
